// OpenRO Rune skill: generate a WeatherCycle Luau script.
// Parameters: cycle_seconds (int) — seconds spent in each weather state;
// start_weather (string: "Clear" | "Rain" | "Fog" | "Dusk") — initial state;
// enable_particles (bool) — attach overhead rain ParticleEmitter in Workspace.
// Uses TweenService on Lighting and Atmosphere for smooth dynamic weather transitions.

pub fn generate_weather_cycle(cycle_seconds, start_weather, enable_particles) {
    let particles_lit = if enable_particles { "true" } else { "false" };
    let header = "-- WeatherCycle -- generated by OpenRO (Rune skill: weather_cycle)\n";
    let body = `local Lighting = game:GetService("Lighting")\nlocal ReplicatedStorage = game:GetService("ReplicatedStorage")\nlocal TweenService = game:GetService("TweenService")\n\nlocal CYCLE_SECONDS = ${cycle_seconds}\nlocal START_WEATHER = "${start_weather}"\nlocal ENABLE_PARTICLES = ${particles_lit}\n\nlocal atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")\nif not atmosphere then\n    atmosphere = Instance.new("Atmosphere")\n    atmosphere.Name = "OpenROAtmosphere"\n    atmosphere.Parent = Lighting\nend\n\nlocal weatherValue = ReplicatedStorage:FindFirstChild("CurrentWeather")\nif not weatherValue then\n    weatherValue = Instance.new("StringValue")\n    weatherValue.Name = "CurrentWeather"\n    weatherValue.Value = START_WEATHER\n    weatherValue.Parent = ReplicatedStorage\nend\n\nlocal rainEmitter = nil\nif ENABLE_PARTICLES then\n    local emitterPart = workspace:FindFirstChild("WeatherEmitterPart")\n    if not emitterPart then\n        emitterPart = Instance.new("Part")\n        emitterPart.Name = "WeatherEmitterPart"\n        emitterPart.Size = Vector3.new(120, 1, 120)\n        emitterPart.Position = Vector3.new(0, 60, 0)\n        emitterPart.Anchored = true\n        emitterPart.CanCollide = false\n        emitterPart.Transparency = 1\n        emitterPart.Parent = workspace\n    end\n    rainEmitter = emitterPart:FindFirstChildOfClass("ParticleEmitter")\n    if not rainEmitter then\n        rainEmitter = Instance.new("ParticleEmitter")\n        rainEmitter.Name = "RainFX"\n        rainEmitter.Rate = 180\n        rainEmitter.Lifetime = NumberRange.new(1.5, 2.2)\n        rainEmitter.Speed = NumberRange.new(45, 65)\n        rainEmitter.EmissionDirection = Enum.NormalId.Bottom\n        rainEmitter.Color = ColorSequence.new(Color3.fromRGB(185, 215, 245))\n        rainEmitter.Enabled = false\n        rainEmitter.Parent = emitterPart\n    end\nend\n\nlocal ORDER = { "Clear", "Dusk", "Fog", "Rain" }\nlocal PRESETS = {\n    Clear = { ClockTime = 13.5, Brightness = 2.4, Density = 0.22, Haze = 0.5, Glare = 0.2 },\n    Dusk = { ClockTime = 18.2, Brightness = 1.4, Density = 0.36, Haze = 1.6, Glare = 0.45 },\n    Fog = { ClockTime = 9.0, Brightness = 1.2, Density = 0.62, Haze = 3.2, Glare = 0.0 },\n    Rain = { ClockTime = 15.0, Brightness = 1.0, Density = 0.52, Haze = 2.4, Glare = 0.0 },\n}\n\nlocal function applyWeather(name)\n    local preset = PRESETS[name] or PRESETS.Clear\n    weatherValue.Value = name\n    local info = TweenInfo.new(6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)\n    TweenService:Create(Lighting, info, { ClockTime = preset.ClockTime, Brightness = preset.Brightness }):Play()\n    TweenService:Create(atmosphere, info, { Density = preset.Density, Haze = preset.Haze, Glare = preset.Glare }):Play()\n    if rainEmitter then\n        rainEmitter.Enabled = (name == "Rain")\n    end\nend\n\nlocal startIndex = 1\nfor i, name in ipairs(ORDER) do\n    if name == START_WEATHER then\n        startIndex = i\n        break\n    end\nend\n\ntask.spawn(function()\n    local idx = startIndex\n    while true do\n        applyWeather(ORDER[idx])\n        task.wait(CYCLE_SECONDS)\n        idx = (idx % #ORDER) + 1\n    end\nend)\n`;
    header + body
}
