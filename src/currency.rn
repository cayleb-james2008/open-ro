// OpenRO Rune skill: generate a Currency Luau script.
// Parameters: currency (string) — the stat's name; start_amount (int) —
// what a new player starts with; earn_amount (int) — passive income per
// period; earn_seconds (int) — the period; bind_close (bool) — when
// true the script binds a shutdown save (BindToClose); when false it
// loads and earns but never binds the shutdown save, so balances would
// be lost when the server closes. The generated Script goes in
// ServerScriptService: it creates leaderstats, loads the saved balance
// from a DataStore, pays passive income, and saves on leave (and on
// shutdown when bind_close is set).
//
// The currency is interpolated into Luau string literals, so it is
// escaped first — the same discipline as the leaderboard skill.

fn esc(s) {
    let out = "";
    for c in s.chars() {
        if c == '\\' {
            out = `${out}\\\\`;
        } else if c == '"' {
            out = `${out}\\\"`;
        } else if c == '\n' {
            out = `${out}\\n`;
        } else if c == '\r' {
            out = `${out}\\r`;
        } else {
            out = `${out}${c}`;
        }
    }
    out
}

pub fn generate_currency(currency, start_amount, earn_amount, earn_seconds, bind_close) {
    let cur = esc(currency);
    let header = "-- Currency -- generated by OpenRO (Rune skill: currency)\n";
    let setup = `local Players = game:GetService("Players")\nlocal DataStoreService = game:GetService("DataStoreService")\n\nlocal CURRENCY = "${cur}"\nlocal START_AMOUNT = ${start_amount}\nlocal EARN_AMOUNT = ${earn_amount}\nlocal EARN_SECONDS = ${earn_seconds}\nlocal store = DataStoreService:GetDataStore("OpenRO_" .. CURRENCY)\n\n`;
    let join = "local function onPlayerAdded(player)\n    local stats = Instance.new(\"Folder\")\n    stats.Name = \"leaderstats\"\n    local stat = Instance.new(\"IntValue\")\n    stat.Name = CURRENCY\n    stat.Value = START_AMOUNT\n    local ok, saved = pcall(function()\n        return store:GetAsync(\"player_\" .. player.UserId)\n    end)\n    if ok and typeof(saved) == \"number\" then\n        stat.Value = saved\n    end\n    stat.Parent = stats\n    stats.Parent = player\n    task.spawn(function()\n        while player.Parent do\n            task.wait(EARN_SECONDS)\n            stat.Value = stat.Value + EARN_AMOUNT\n        end\n    end)\nend\n\n";
    let save = "local function savePlayer(player)\n    local stats = player:FindFirstChild(\"leaderstats\")\n    local stat = stats and stats:FindFirstChild(CURRENCY)\n    if stat then\n        pcall(function()\n            store:SetAsync(\"player_\" .. player.UserId, stat.Value)\n        end)\n    end\nend\n\nPlayers.PlayerAdded:Connect(onPlayerAdded)\nPlayers.PlayerRemoving:Connect(savePlayer)\n";
    let bind = if bind_close {
        "game:BindToClose(function()\n    for _, player in Players:GetPlayers() do\n        savePlayer(player)\n    end\nend)\n"
    } else {
        ""
    };
    header + setup + join + save + bind
}
