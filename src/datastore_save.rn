// OpenRO Rune skill: generate a DataStoreSave Luau script.
// Parameters: store_name (string) — DataStore name; stat_name (string) —
// leaderstats IntValue name; default_value (int) — new-player starting value;
// autosave_seconds (int) — periodic autosave cadence; bind_close (bool) —
// bind parallel game:BindToClose shutdown save.
// Strictly pcall-guarded with retry backoff, DataLoaded guard against wiping
// progress on transient load failures, and UpdateAsync read-modify-write.

fn esc(s) {
    let out = "";
    for c in s.chars() {
        if c == '\\' {
            out = `${out}\\\\`;
        } else if c == '"' {
            out = `${out}\\\"`;
        } else if c == '\n' {
            out = `${out}\\n`;
        } else if c == '\r' {
            out = `${out}\\r`;
        } else {
            out = `${out}${c}`;
        }
    }
    out
}

pub fn generate_datastore_save(store_name, stat_name, default_value, autosave_seconds, bind_close) {
    let store = esc(store_name);
    let stat = esc(stat_name);
    let header = "-- DataStoreSave -- generated by OpenRO (Rune skill: datastore_save)\n";
    let setup = `local Players = game:GetService("Players")\nlocal DataStoreService = game:GetService("DataStoreService")\n\nlocal STORE_NAME = "${store}"\nlocal STAT_NAME = "${stat}"\nlocal DEFAULT_VALUE = ${default_value}\nlocal AUTOSAVE_SECONDS = ${autosave_seconds}\nlocal store = DataStoreService:GetDataStore(STORE_NAME)\n\n`;
    let helpers = "local function withRetry(fn, attempts)\n    local maxTries = attempts or 3\n    for attempt = 1, maxTries do\n        local ok, result = pcall(fn)\n        if ok then\n            return true, result\n        end\n        if attempt < maxTries then\n            task.wait(2 ^ attempt)\n        end\n    end\n    return false, nil\nend\n\nlocal function savePlayer(player)\n    if player:GetAttribute(\"DataLoaded\") ~= true then\n        return\n    end\n    local stats = player:FindFirstChild(\"leaderstats\")\n    local stat = stats and stats:FindFirstChild(STAT_NAME)\n    if not stat then\n        return\n    end\n    local key = \"Player_\" .. player.UserId\n    local payload = { value = stat.Value, updatedAt = os.time() }\n    local ok, err = withRetry(function()\n        return store:UpdateAsync(key, function(_old)\n            return payload\n        end)\n    end, 3)\n    if not ok then\n        warn(\"DataStore save failed for \" .. player.Name .. \": \" .. tostring(err))\n    end\nend\n\nlocal function onPlayerAdded(player)\n    local stats = player:FindFirstChild(\"leaderstats\")\n    if not stats then\n        stats = Instance.new(\"Folder\")\n        stats.Name = \"leaderstats\"\n        stats.Parent = player\n    end\n    local stat = stats:FindFirstChild(STAT_NAME)\n    if not stat then\n        stat = Instance.new(\"IntValue\")\n        stat.Name = STAT_NAME\n        stat.Value = DEFAULT_VALUE\n        stat.Parent = stats\n    end\n    local key = \"Player_\" .. player.UserId\n    local ok, data = withRetry(function()\n        return store:GetAsync(key)\n    end, 3)\n    if not ok then\n        warn(\"DataStore load failed for \" .. player.Name)\n        player:SetAttribute(\"DataLoaded\", false)\n        return\n    end\n    player:SetAttribute(\"DataLoaded\", true)\n    if typeof(data) == \"table\" and typeof(data.value) == \"number\" then\n        stat.Value = math.floor(data.value)\n    elseif typeof(data) == \"number\" then\n        stat.Value = math.floor(data)\n    else\n        stat.Value = DEFAULT_VALUE\n    end\n    task.spawn(function()\n        while player.Parent do\n            task.wait(AUTOSAVE_SECONDS)\n            if player.Parent then\n                savePlayer(player)\n            end\n        end\n    end)\nend\n\nPlayers.PlayerAdded:Connect(onPlayerAdded)\nPlayers.PlayerRemoving:Connect(savePlayer)\nfor _, existing in ipairs(Players:GetPlayers()) do\n    task.spawn(onPlayerAdded, existing)\nend\n";
    let bind = if bind_close {
        "\ngame:BindToClose(function()\n    local active = Players:GetPlayers()\n    local remaining = #active\n    if remaining == 0 then\n        return\n    end\n    for _, player in ipairs(active) do\n        task.spawn(function()\n            savePlayer(player)\n            remaining = remaining - 1\n        end)\n    end\n    local deadline = os.clock() + 25\n    while remaining > 0 and os.clock() < deadline do\n        task.wait(0.1)\n    end\nend)\n"
    } else {
        ""
    };
    header + setup + helpers + bind
}
