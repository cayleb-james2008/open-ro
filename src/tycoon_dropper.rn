// OpenRO Rune skill: generate a TycoonDropper Luau script.
// Parameters: tycoon_name (string, plain identifier) — Tycoon Model name;
// drop_value (int) — base currency earned per collected ore;
// drop_interval (int) — seconds between ore drops;
// upgrade_cost (int) — initial price of the x2 dropper upgrade button;
// currency (string) — leaderstats IntValue name to credit/charge.
// Builds a complete dropper -> conveyor -> collector -> purchase button upgrader loop.

fn esc(s) {
    let out = "";
    for c in s.chars() {
        if c == '\\' {
            out = `${out}\\\\`;
        } else if c == '"' {
            out = `${out}\\\"`;
        } else if c == '\n' {
            out = `${out}\\n`;
        } else if c == '\r' {
            out = `${out}\\r`;
        } else {
            out = `${out}${c}`;
        }
    }
    out
}

pub fn generate_tycoon_dropper(tycoon_name, drop_value, drop_interval, upgrade_cost, currency) {
    let cur = esc(currency);
    let header = "-- TycoonDropper -- generated by OpenRO (Rune skill: tycoon_dropper)\n";
    let body = `local Players = game:GetService("Players")\nlocal Debris = game:GetService("Debris")\n\nlocal TYCOON_NAME = "${tycoon_name}"\nlocal CURRENCY = "${cur}"\nlocal DROP_INTERVAL = ${drop_interval}\nlocal currentDropValue = ${drop_value}\nlocal nextUpgradeCost = ${upgrade_cost}\nlocal upgradeLevel = 1\n\nlocal model = Instance.new("Model")\nmodel.Name = TYCOON_NAME\n\nlocal dropper = Instance.new("Part")\ndropper.Name = "Dropper"\ndropper.Size = Vector3.new(4, 4, 4)\ndropper.Position = Vector3.new(0, 7, -14)\ndropper.Anchored = true\ndropper.Material = Enum.Material.Metal\ndropper.Color = Color3.fromRGB(90, 100, 120)\ndropper.Parent = model\n\nlocal conveyor = Instance.new("Part")\nconveyor.Name = "Conveyor"\nconveyor.Size = Vector3.new(6, 1, 24)\nconveyor.Position = Vector3.new(0, 1, -2)\nconveyor.Anchored = true\nconveyor.Material = Enum.Material.DiamondPlate\nconveyor.Color = Color3.fromRGB(52, 56, 66)\nconveyor.AssemblyLinearVelocity = Vector3.new(0, 0, 12)\nconveyor.Parent = model\n\nlocal collector = Instance.new("Part")\ncollector.Name = "Collector"\ncollector.Size = Vector3.new(6, 3, 4)\ncollector.Position = Vector3.new(0, 2, 12)\ncollector.Anchored = true\ncollector.Material = Enum.Material.Neon\ncollector.Color = Color3.fromRGB(230, 184, 48)\ncollector.Parent = model\n\nlocal upgradeButton = Instance.new("Part")\nupgradeButton.Name = "UpgradeButton"\nupgradeButton.Size = Vector3.new(5, 1, 5)\nupgradeButton.Position = Vector3.new(8, 1, 4)\nupgradeButton.Anchored = true\nupgradeButton.Material = Enum.Material.Neon\nupgradeButton.Color = Color3.fromRGB(60, 179, 113)\nupgradeButton.Parent = model\n\nlocal billboard = Instance.new("BillboardGui")\nbillboard.Size = UDim2.new(0, 220, 0, 48)\nbillboard.StudsOffset = Vector3.new(0, 3.5, 0)\nbillboard.AlwaysOnTop = true\nlocal label = Instance.new("TextLabel")\nlabel.Size = UDim2.new(1, 0, 1, 0)\nlabel.BackgroundTransparency = 0.3\nlabel.TextColor3 = Color3.fromRGB(255, 255, 255)\nlabel.TextScaled = true\nlabel.Parent = billboard\nbillboard.Parent = upgradeButton\n\nmodel.PrimaryPart = conveyor\nmodel.Parent = workspace\n\nlocal function refreshLabel()\n    label.Text = "Upgrade Lv" .. (upgradeLevel + 1) .. " (" .. nextUpgradeCost .. " " .. CURRENCY .. ")"\nend\nrefreshLabel()\n\nlocal function getOrCreateStat(player)\n    local stats = player:FindFirstChild("leaderstats")\n    if not stats then\n        stats = Instance.new("Folder")\n        stats.Name = "leaderstats"\n        stats.Parent = player\n    end\n    local stat = stats:FindFirstChild(CURRENCY)\n    if not stat then\n        stat = Instance.new("IntValue")\n        stat.Name = CURRENCY\n        stat.Value = 0\n        stat.Parent = stats\n    end\n    return stat\nend\n\ncollector.Touched:Connect(function(hit)\n    local value = hit:GetAttribute("OreValue")\n    if typeof(value) ~= "number" or value <= 0 then\n        return\n    end\n    hit:SetAttribute("OreValue", 0)\n    hit:Destroy()\n    for _, player in ipairs(Players:GetPlayers()) do\n        local stat = getOrCreateStat(player)\n        stat.Value = stat.Value + value\n    end\nend)\n\nlocal upgradeCooldown = {}\nupgradeButton.Touched:Connect(function(hit)\n    local character = hit.Parent\n    local player = character and Players:GetPlayerFromCharacter(character)\n    if not player then\n        return\n    end\n    local now = os.clock()\n    if upgradeCooldown[player] and (now - upgradeCooldown[player]) < 1.0 then\n        return\n    end\n    upgradeCooldown[player] = now\n    local stat = getOrCreateStat(player)\n    if stat.Value < nextUpgradeCost then\n        return\n    end\n    stat.Value = stat.Value - nextUpgradeCost\n    upgradeLevel = upgradeLevel + 1\n    currentDropValue = currentDropValue * 2\n    nextUpgradeCost = math.floor(nextUpgradeCost * 2)\n    refreshLabel()\nend)\n\nPlayers.PlayerRemoving:Connect(function(player)\n    upgradeCooldown[player] = nil\nend)\n\ntask.spawn(function()\n    while model.Parent do\n        local ore = Instance.new("Part")\n        ore.Name = "TycoonOre"\n        ore.Size = Vector3.new(1.5, 1.5, 1.5)\n        ore.Position = dropper.Position - Vector3.new(0, 2.5, 0)\n        ore.Material = Enum.Material.Neon\n        ore.Color = Color3.fromRGB(245, 200, 66)\n        ore:SetAttribute("OreValue", currentDropValue)\n        ore.Parent = model\n        Debris:AddItem(ore, 15)\n        task.wait(DROP_INTERVAL)\n    end\nend)\n`;
    header + body
}
