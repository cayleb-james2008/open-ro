// OpenRO Rune skill: generate an NpcPatrol Luau script.
// Parameters: npc_name (string, plain identifier) — NPC Model name;
// waypoint_count (int) — number of perimeter patrol points;
// walk_speed (int) — Humanoid.WalkSpeed; damage (int) — contact damage;
// dialogue (string) — overhead guard callout line.

fn esc(s) {
    let out = "";
    for c in s.chars() {
        if c == '\\' {
            out = `${out}\\\\`;
        } else if c == '"' {
            out = `${out}\\\"`;
        } else if c == '\n' {
            out = `${out}\\n`;
        } else if c == '\r' {
            out = `${out}\\r`;
        } else {
            out = `${out}${c}`;
        }
    }
    out
}

pub fn generate_npc_patrol(npc_name, waypoint_count, walk_speed, damage, dialogue) {
    let line = esc(dialogue);
    let header = "-- NpcPatrol -- generated by OpenRO (Rune skill: npc_patrol)\n";
    let body = `local Players = game:GetService("Players")\nlocal PathfindingService = game:GetService("PathfindingService")\n\nlocal NPC_NAME = "${npc_name}"\nlocal WAYPOINT_COUNT = ${waypoint_count}\nlocal WALK_SPEED = ${walk_speed}\nlocal DAMAGE = ${damage}\nlocal DIALOGUE = "${line}"\n\nlocal patrolFolder = Instance.new("Folder")\npatrolFolder.Name = NPC_NAME .. "Waypoints"\nlocal waypoints = {}\nlocal radius = 24\nfor i = 1, WAYPOINT_COUNT do\n    local angle = (i - 1) * (math.pi * 2 / WAYPOINT_COUNT)\n    local marker = Instance.new("Part")\n    marker.Name = "Waypoint" .. i\n    marker.Size = Vector3.new(2, 0.5, 2)\n    marker.Position = Vector3.new(math.cos(angle) * radius, 1, math.sin(angle) * radius)\n    marker.Anchored = true\n    marker.CanCollide = false\n    marker.Transparency = 0.85\n    marker.Parent = patrolFolder\n    table.insert(waypoints, marker.Position)\nend\npatrolFolder.Parent = workspace\n\nlocal npc = Instance.new("Model")\nnpc.Name = NPC_NAME\n\nlocal root = Instance.new("Part")\nroot.Name = "HumanoidRootPart"\nroot.Size = Vector3.new(2, 4, 2)\nroot.Position = waypoints[1] + Vector3.new(0, 3, 0)\nroot.Color = Color3.fromRGB(190, 65, 55)\nroot.Material = Enum.Material.SmoothPlastic\nroot.Parent = npc\n\nlocal head = Instance.new("Part")\nhead.Name = "Head"\nhead.Size = Vector3.new(2, 1.5, 2)\nhead.Position = root.Position + Vector3.new(0, 2.75, 0)\nhead.Color = Color3.fromRGB(235, 200, 170)\nhead.Parent = npc\n\nlocal weld = Instance.new("WeldConstraint")\nweld.Part0 = root\nweld.Part1 = head\nweld.Parent = root\n\nlocal humanoid = Instance.new("Humanoid")\nhumanoid.WalkSpeed = WALK_SPEED\nhumanoid.MaxHealth = 100\nhumanoid.Health = 100\nhumanoid.Parent = npc\n\nlocal billboard = Instance.new("BillboardGui")\nbillboard.Name = "GuardDialogue"\nbillboard.Size = UDim2.new(0, 200, 0, 44)\nbillboard.StudsOffset = Vector3.new(0, 3, 0)\nbillboard.AlwaysOnTop = true\nlocal label = Instance.new("TextLabel")\nlabel.Size = UDim2.new(1, 0, 1, 0)\nlabel.BackgroundTransparency = 0.35\nlabel.TextColor3 = Color3.fromRGB(255, 255, 255)\nlabel.TextScaled = true\nlabel.Text = NPC_NAME .. ": " .. DIALOGUE\nlabel.Parent = billboard\nbillboard.Parent = head\n\nnpc.PrimaryPart = root\nnpc.Parent = workspace\n\nlocal lastHit = {}\nroot.Touched:Connect(function(hit)\n    if DAMAGE <= 0 then\n        return\n    end\n    local character = hit.Parent\n    local player = character and Players:GetPlayerFromCharacter(character)\n    if not player then\n        return\n    end\n    local targetHum = character:FindFirstChildOfClass("Humanoid")\n    if not targetHum or targetHum.Health <= 0 then\n        return\n    end\n    local now = os.clock()\n    if lastHit[player] and (now - lastHit[player]) < 1.0 then\n        return\n    end\n    lastHit[player] = now\n    targetHum:TakeDamage(DAMAGE)\nend)\n\nPlayers.PlayerRemoving:Connect(function(player)\n    lastHit[player] = nil\nend)\n\ntask.spawn(function()\n    local index = 1\n    while npc.Parent and humanoid.Health > 0 do\n        local targetPos = waypoints[index]\n        local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })\n        local ok = pcall(function()\n            path:ComputeAsync(root.Position, targetPos)\n        end)\n        if ok and path.Status == Enum.PathStatus.Success then\n            for _, wp in ipairs(path:GetWaypoints()) do\n                if not npc.Parent or humanoid.Health <= 0 then\n                    break\n                end\n                humanoid:MoveTo(wp.Position)\n                humanoid.MoveToFinished:Wait()\n            end\n        else\n            humanoid:MoveTo(targetPos)\n            task.wait(1.5)\n        end\n        index = (index % #waypoints) + 1\n        task.wait(0.4)\n    end\nend)\n`;
    header + body
}
