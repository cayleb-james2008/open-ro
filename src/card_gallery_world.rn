// OpenRO game system: 3D Card Gallery Studio Lobby.
// Parameters:
// - lobby_name (string, plain identifier): Workspace Folder/Model container name
// - showcase_count (int): number of 3D Card Showcase Billboards (4..=12)
// - enable_holograms (bool): animate Holographic Roll Pedestal ring via RunService.Heartbeat
// - create_structures (bool): build all lobby landmarks (Courtyard, Roll Pedestal,
//   Card Showcase Billboards with Decal/ImageLabel, Tower Portal, Boss Shrine, Potion Stand, Leaderboard Wall)

pub fn generate_card_gallery_world(lobby_name, showcase_count, enable_holograms, create_structures) {
    let holo_lit = if enable_holograms { "true" } else { "false" };
    let header = "-- CardGalleryWorld -- generated by OpenRO (system: card_gallery_world)\n";
    let setup = `local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LOBBY_NAME = "${lobby_name}"
local SHOWCASE_COUNT = ${showcase_count}
local ENABLE_HOLOGRAMS = ${holo_lit}

local SHOWCASE_CARDS = {
    { id = "supernova-ascended-striker", title = "Supernova Ascended Striker", rarity = "Secret", odds = "1/8,192", color = Color3.fromRGB(255, 196, 60) },
    { id = "infinity-void-sorcerer", title = "Infinity Void Sorcerer", rarity = "Celestial", odds = "1/2,048", color = Color3.fromRGB(168, 85, 247) },
    { id = "shadow-sovereign", title = "Shadow Sovereign", rarity = "Celestial", odds = "1/2,048", color = Color3.fromRGB(99, 102, 241) },
    { id = "crimson-sea-captain", title = "Crimson Sea Captain", rarity = "Mythic", odds = "1/512", color = Color3.fromRGB(235, 83, 42) },
    { id = "nine-tail-ember-shinobi", title = "Nine-Tail Ember Shinobi", rarity = "Mythic", odds = "1/512", color = Color3.fromRGB(249, 115, 22) },
    { id = "thunder-flash-ronin", title = "Thunder Flash Ronin", rarity = "Legendary", odds = "1/128", color = Color3.fromRGB(56, 189, 248) },
    { id = "blood-moon-gravity-ronin", title = "Blood-Moon Gravity Ronin", rarity = "Epic", odds = "1/32", color = Color3.fromRGB(192, 38, 211) },
    { id = "eclipse-arcane-alchemist", title = "Eclipse Arcane Alchemist", rarity = "Rare", odds = "1/8", color = Color3.fromRGB(52, 211, 153) },
}
`;
    let build = if create_structures {
        `
local lobby = workspace:FindFirstChild("${lobby_name}")
if not lobby then
    lobby = Instance.new("Folder")
    lobby.Name = "${lobby_name}"
    lobby.Parent = workspace
end

local function makeLandmark(name, size, pos, color, material)
    local existing = lobby:FindFirstChild(name)
    if existing then
        return existing
    end
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.Position = pos
    part.Anchored = true
    part.CanCollide = true
    part.Color = color
    part.Material = material
    part.Parent = lobby
    return part
end

-- Spawn Courtyard
makeLandmark("SpawnCourtyard", Vector3.new(96, 1, 96), Vector3.new(0, 0, 0), Color3.fromRGB(38, 42, 54), Enum.Material.Marble)

-- Holographic Roll Pedestal
local rollPedestal = makeLandmark("RollPedestal", Vector3.new(10, 2, 10), Vector3.new(0, 1.5, -14), Color3.fromRGB(79, 124, 240), Enum.Material.Neon)
local holoRing = makeLandmark("HoloRing", Vector3.new(6, 0.6, 6), Vector3.new(0, 6, -14), Color3.fromRGB(168, 85, 247), Enum.Material.Neon)
holoRing.CanCollide = false

-- Tower Portal Gate, Boss Raid Shrine, Potion Alchemist Stand, Leaderboard Wall
makeLandmark("TowerPortalGate", Vector3.new(12, 14, 2), Vector3.new(-28, 7.5, -24), Color3.fromRGB(56, 189, 248), Enum.Material.Neon)
makeLandmark("BossRaidShrine", Vector3.new(12, 10, 8), Vector3.new(28, 5.5, -24), Color3.fromRGB(224, 83, 42), Enum.Material.Slate)
makeLandmark("PotionAlchemistStand", Vector3.new(10, 5, 6), Vector3.new(-28, 3, 12), Color3.fromRGB(60, 179, 113), Enum.Material.WoodPlanks)
local boardWall = makeLandmark("LeaderboardWall", Vector3.new(18, 10, 1.5), Vector3.new(28, 5.5, 12), Color3.fromRGB(30, 34, 46), Enum.Material.SmoothPlastic)

-- 3D Card Showcase Billboards bound to Decal & ImageLabel artwork slots
local galleryFolder = lobby:FindFirstChild("CardShowcases")
if not galleryFolder then
    galleryFolder = Instance.new("Folder")
    galleryFolder.Name = "CardShowcases"
    galleryFolder.Parent = lobby
end

for i = 1, SHOWCASE_COUNT do
    local card = SHOWCASE_CARDS[((i - 1) % #SHOWCASE_CARDS) + 1]
    local standName = "Showcase_" .. card.id
    if not galleryFolder:FindFirstChild(standName) then
        local stand = Instance.new("Part")
        stand.Name = standName
        stand.Size = Vector3.new(6, 8.5, 0.8)
        stand.Position = Vector3.new((i - (SHOWCASE_COUNT + 1) / 2) * 8.5, 5, 28)
        stand.Anchored = true
        stand.Material = Enum.Material.SmoothPlastic
        stand.Color = card.color
        stand:SetAttribute("CardId", card.id)

        local decal = Instance.new("Decal")
        decal.Name = "CardArtDecal"
        decal.Face = Enum.NormalId.Front
        decal.Texture = "rbxasset://openro-assets/" .. card.id .. ".png"
        decal.Parent = stand

        local gui = Instance.new("SurfaceGui")
        gui.Name = "CardInfoGui"
        gui.Face = Enum.NormalId.Front
        local img = Instance.new("ImageLabel")
        img.Name = "CardArtImage"
        img.Size = UDim2.new(1, 0, 0.78, 0)
        img.BackgroundTransparency = 1
        img.Image = "rbxasset://openro-assets/" .. card.id .. ".png"
        img.Parent = gui

        local title = Instance.new("TextLabel")
        title.Name = "CardCaption"
        title.Size = UDim2.new(1, 0, 0.22, 0)
        title.Position = UDim2.new(0, 0, 0.78, 0)
        title.BackgroundTransparency = 0.2
        title.TextColor3 = Color3.fromRGB(255, 255, 255)
        title.TextScaled = true
        title.Text = card.title .. " [" .. card.rarity .. " " .. card.odds .. "]"
        title.Parent = gui
        gui.Parent = stand

        local glow = Instance.new("PointLight")
        glow.Color = card.color
        glow.Range = 14
        glow.Brightness = 1.4
        glow.Parent = stand
        stand.Parent = galleryFolder
    end
end

-- Live Leaderboard SurfaceGui on LeaderboardWall
if not boardWall:FindFirstChild("TowerLeaderboardGui") then
    local lbGui = Instance.new("SurfaceGui")
    lbGui.Name = "TowerLeaderboardGui"
    local lbText = Instance.new("TextLabel")
    lbText.Name = "Rankings"
    lbText.Size = UDim2.new(1, 0, 1, 0)
    lbText.BackgroundTransparency = 0.15
    lbText.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbText.TextScaled = true
    lbText.Text = "APEX TOWER LEADERBOARD"
    lbText.Parent = lbGui
    lbGui.Parent = boardWall

    task.spawn(function()
        while boardWall.Parent do
            local lines = { "APEX TOWER LEADERBOARD" }
            for _, p in ipairs(Players:GetPlayers()) do
                local floor = p:GetAttribute("TowerFloor") or 1
                table.insert(lines, p.Name .. " - Floor " .. tostring(floor))
            end
            lbText.Text = table.concat(lines, "\\n")
            task.wait(5)
        end
    end)
end

if ENABLE_HOLOGRAMS and rollPedestal and holoRing then
    local t = 0
    local basePos = holoRing.Position
    RunService.Heartbeat:Connect(function(dt)
        if not holoRing.Parent then
            return
        end
        t = t + dt
        local bob = math.sin(t * 2.2) * 0.75
        holoRing.CFrame = CFrame.new(basePos + Vector3.new(0, bob, 0)) * CFrame.Angles(0, t * 1.4, 0)
    end)
end
`
    } else {
        `
local lobby = workspace.${lobby_name}
print("CardGalleryWorld linked to " .. lobby.Name .. " (" .. SHOWCASE_COUNT .. " showcases, holograms=" .. tostring(ENABLE_HOLOGRAMS) .. ")")
`
    };
    header + setup + build
}
