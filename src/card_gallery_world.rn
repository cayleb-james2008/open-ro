// OpenRO game system: 120+ Part 3D Anime Hub World & Card Gallery Lobby.
// Parameters:
// - lobby_name (string, plain identifier): Workspace Folder container name
// - showcase_count (int): number of 3D Card Showcase Pedestals (4..=12)
// - enable_holograms (bool): animate Torii Rarity Halo Rings via RunService.Heartbeat
// - create_structures (bool): construct the full multi-zone Celestial Arena Island Hub & Lighting rig

pub fn generate_card_gallery_world(lobby_name, showcase_count, enable_holograms, create_structures) {
    let holo_lit = if enable_holograms { "true" } else { "false" };
    let header = "-- CardGalleryWorld -- generated by OpenRO (system: card_gallery_world)\n";
    let setup = `local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local LOBBY_NAME = "${lobby_name}"
local SHOWCASE_COUNT = ${showcase_count}
local ENABLE_HOLOGRAMS = ${holo_lit}

local SHOWCASE_CARDS = {
    { id = "supernova-ascended-striker", title = "Golden Ascended Warrior", rarity = "Secret",    odds = "1/50,000", color = Color3.fromRGB(255, 196, 60) },
    { id = "infinity-void-sorcerer",     title = "Six-Eyes Sorcerer",       rarity = "Mythic",    odds = "1/3,500",  color = Color3.fromRGB(235, 83, 42) },
    { id = "shadow-sovereign",           title = "Shadow Monarch",          rarity = "Mythic",    odds = "1/3,500",  color = Color3.fromRGB(235, 83, 42) },
    { id = "crimson-sea-captain",        title = "Joyful Pirate",           rarity = "Mythic",    odds = "1/3,500",  color = Color3.fromRGB(235, 83, 42) },
    { id = "nine-tail-ember-shinobi",    title = "Nine-Tail Shinobi",       rarity = "Mythic",    odds = "1/3,500",  color = Color3.fromRGB(249, 115, 22) },
    { id = "thunder-flash-ronin",        title = "Thunder Flash Blade",     rarity = "Legendary", odds = "1/400",    color = Color3.fromRGB(56, 189, 248) },
    { id = "blood-moon-gravity-ronin",   title = "Gravity Ronin",           rarity = "Epic",      odds = "1/60",     color = Color3.fromRGB(192, 38, 211) },
    { id = "eclipse-arcane-alchemist",   title = "Steel Alchemist",         rarity = "Rare",      odds = "1/12",     color = Color3.fromRGB(52, 211, 153) },
}
`;
    let build = if create_structures {
        `
local lobby = workspace:FindFirstChild("${lobby_name}")
if not lobby then
    lobby = Instance.new("Folder")
    lobby.Name = "${lobby_name}"
    lobby.Parent = workspace
end

local function makePart(parent, name, size, cf, color, material, shape, collide, trans)
    local existing = parent:FindFirstChild(name)
    if existing then
        return existing
    end
    local p = Instance.new("Part")
    p.Name = name
    local finalShape = shape or Enum.PartType.Block
    if finalShape == Enum.PartType.Cylinder then
        p.Size = Vector3.new(size.Y, size.X, size.Z)
        p.CFrame = cf * CFrame.Angles(0, 0, math.rad(90))
    else
        p.Size = size
        p.CFrame = cf
    end
    p.Anchored = true
    p.CanCollide = if collide == nil then true else collide
    p.Color = color
    p.Material = material or Enum.Material.SmoothPlastic
    p.Shape = finalShape
    p.Transparency = trans or 0
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

local function addLight(parent, color, brightness, range)
    local l = Instance.new("PointLight")
    l.Color = color
    l.Brightness = brightness
    l.Range = range
    l.Parent = parent
end

local function addBillboard(parent, text, color, offsetY)
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 260, 0, 56)
    bb.StudsOffset = Vector3.new(0, offsetY, 0)
    bb.AlwaysOnTop = false
    bb.MaxDistance = 68
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 0.2
    lbl.BackgroundColor3 = Color3.fromRGB(14, 18, 32)
    lbl.TextColor3 = color
    lbl.TextScaled = true
    lbl.TextWrapped = true
    lbl.Text = text
    lbl.Parent = bb
    bb.Parent = parent
end

-- 1. Full Sunlit Anime Lighting Rig (ClockTime 13.5, Cerulean Sky, Atmosphere, Bloom, SunRays, ColorCorrection)
Lighting.ClockTime = 13.5
Lighting.Brightness = 2.8
Lighting.Ambient = Color3.fromRGB(165, 195, 230)
Lighting.OutdoorAmbient = Color3.fromRGB(190, 215, 240)
if not Lighting:FindFirstChildOfClass("Sky") then
    local sky = Instance.new("Sky")
    sky.Name = "ApexSky"
    sky.StarCount = 3500
    sky.Parent = Lighting
end
if not Lighting:FindFirstChildOfClass("Atmosphere") then
    local atmo = Instance.new("Atmosphere")
    atmo.Name = "ApexAtmosphere"
    atmo.Density = 0.16
    atmo.Offset = 0.25
    atmo.Color = Color3.fromRGB(185, 230, 255)
    atmo.Decay = Color3.fromRGB(125, 185, 245)
    atmo.Haze = 0.45
    atmo.Parent = Lighting
end
if not Lighting:FindFirstChildOfClass("BloomEffect") then
    local bloom = Instance.new("BloomEffect")
    bloom.Name = "ApexBloom"
    bloom.Intensity = 0.45
    bloom.Size = 18
    bloom.Threshold = 1.4
    bloom.Parent = Lighting
end
if not Lighting:FindFirstChildOfClass("SunRaysEffect") then
    local rays = Instance.new("SunRaysEffect")
    rays.Name = "ApexSunRays"
    rays.Intensity = 0.14
    rays.Spread = 0.65
    rays.Parent = Lighting
end
if not Lighting:FindFirstChildOfClass("ColorCorrectionEffect") then
    local cc = Instance.new("ColorCorrectionEffect")
    cc.Name = "ApexColorCorrection"
    cc.Brightness = 0.05
    cc.Contrast = 0.08
    cc.Saturation = 0.22
    cc.Parent = Lighting
end

-- 2. Sunlit Floating Archipelago Courtyard, Cliff Undersides, Koi Moat & Stone Bridges
makePart(lobby, "IslandBaseTier1", Vector3.new(176, 4.2, 176), CFrame.new(0, -2, 0), Color3.fromRGB(74, 222, 128), Enum.Material.Grass)
makePart(lobby, "CliffTierUpper", Vector3.new(144, 6.4, 144), CFrame.new(0, -7.2, 0), Color3.fromRGB(166, 138, 100), Enum.Material.Rock)
makePart(lobby, "SpawnCourtyard", Vector3.new(96, 1.6, 96), CFrame.new(0, 0.8, 0), Color3.fromRGB(245, 239, 230), Enum.Material.Marble)
makePart(lobby, "CenterEmblemFloor", Vector3.new(34, 0.4, 34), CFrame.new(0, 1.8, 0), Color3.fromRGB(231, 222, 200), Enum.Material.Marble)
for idx, pos in ipairs({ Vector3.new(-40, 8, -40), Vector3.new(40, 8, -40), Vector3.new(-40, 8, 40), Vector3.new(40, 8, 40) }) do
    local pil = makePart(lobby, "CornerPillar" .. idx, Vector3.new(3.5, 12, 3.5), CFrame.new(pos), Color3.fromRGB(245, 239, 230), Enum.Material.Marble, Enum.PartType.Cylinder)
    local orb = makePart(lobby, "CornerOrb" .. idx, Vector3.new(3.2, 3.2, 3.2), CFrame.new(pos + Vector3.new(0, 7, 0)), Color3.fromRGB(56, 189, 248), Enum.Material.Neon, Enum.PartType.Ball)
    addLight(orb, Color3.fromRGB(56, 189, 248), 1.3, 24)
end
makePart(lobby, "KoiMoatNorth", Vector3.new(124, 0.6, 14), CFrame.new(0, 0.4, -55), Color3.fromRGB(34, 211, 238), Enum.Material.Glass, Enum.PartType.Block, false, 0.22)
makePart(lobby, "KoiMoatSouth", Vector3.new(124, 0.6, 10), CFrame.new(0, 0.4, 52), Color3.fromRGB(34, 211, 238), Enum.Material.Glass, Enum.PartType.Block, false, 0.22)
makePart(lobby, "NorthBridgeDeck", Vector3.new(12, 1, 36), CFrame.new(0, 2, -44), Color3.fromRGB(237, 228, 211), Enum.Material.Marble)
makePart(lobby, "SouthBridgeDeck", Vector3.new(16, 1, 30), CFrame.new(0, 2, 44), Color3.fromRGB(237, 228, 211), Enum.Material.Marble)
makePart(lobby, "EastBridgeDeck", Vector3.new(36, 1, 12), CFrame.new(44, 2, -14), Color3.fromRGB(237, 228, 211), Enum.Material.Marble)
makePart(lobby, "WestBridgeDeck", Vector3.new(36, 1, 12), CFrame.new(-44, 2, -14), Color3.fromRGB(237, 228, 211), Enum.Material.Marble)

-- 3. Japanese Torii Summon Shrine (Translucent Light Beam = 0.76)
local rollPedestal = makePart(lobby, "RollPedestal", Vector3.new(12, 1, 12), CFrame.new(0, 3.8, -61), Color3.fromRGB(56, 189, 248), Enum.Material.Neon, Enum.PartType.Cylinder)
addLight(rollPedestal, Color3.fromRGB(56, 189, 248), 1.5, 28)
addBillboard(rollPedestal, "JAPANESE TORII SUMMON SHRINE", Color3.fromRGB(255, 196, 60), 23.5)
makePart(lobby, "ToriiPillarL", Vector3.new(2.4, 16.5, 2.4), CFrame.new(-9.5, 13.5, -71), Color3.fromRGB(220, 38, 38), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
makePart(lobby, "ToriiPillarR", Vector3.new(2.4, 16.5, 2.4), CFrame.new(9.5, 13.5, -71), Color3.fromRGB(220, 38, 38), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
makePart(lobby, "ToriiNukiBeam", Vector3.new(25, 1.4, 1.4), CFrame.new(0, 17.5, -71), Color3.fromRGB(220, 38, 38), Enum.Material.SmoothPlastic)
makePart(lobby, "ToriiKasagiTop", Vector3.new(28, 1.6, 2.8), CFrame.new(0, 22.8, -71), Color3.fromRGB(41, 32, 27), Enum.Material.Wood)
local holoRing = makePart(lobby, "HoloRing", Vector3.new(10, 0.7, 10), CFrame.new(0, 12.5, -71), Color3.fromRGB(56, 189, 248), Enum.Material.Neon, Enum.PartType.Block, false, 0.35)
makePart(lobby, "SummonLightBeam", Vector3.new(4.0, 30, 4.0), CFrame.new(0, 18, -71), Color3.fromRGB(125, 211, 252), Enum.Material.Neon, Enum.PartType.Cylinder, false, 0.76)

-- 4. Boss Raid Colosseum, Infinite Tower Spire, Alchemist Pavilion & 4v4 PvP Arena
makePart(lobby, "ColosseumFloor", Vector3.new(46, 2, 46), CFrame.new(80, 1.4, -18), Color3.fromRGB(230, 213, 184), Enum.Material.Sand)
local bossShrine = makePart(lobby, "BossRaidShrine", Vector3.new(18, 10, 6), CFrame.new(80, 7.5, -36), Color3.fromRGB(194, 65, 12), Enum.Material.Marble)
addBillboard(bossShrine, "BOSS RAID COLOSSEUM", Color3.fromRGB(239, 68, 68), 11.5)
makePart(lobby, "ChampionStatue", Vector3.new(5, 11, 3), CFrame.new(80, 9.5, -24), Color3.fromRGB(250, 204, 21), Enum.Material.Metal)

local towerPortal = makePart(lobby, "TowerPortalGate", Vector3.new(7.5, 38, 7.5), CFrame.new(-80, 21, -18), Color3.fromRGB(56, 189, 248), Enum.Material.Neon, Enum.PartType.Cylinder, true, 0.42)
addBillboard(towerPortal, "INFINITE TOWER SPIRE", Color3.fromRGB(56, 189, 248), 22)
for s = 1, 12 do
    local ang = math.rad(s * 30)
    makePart(lobby, "SpiralStep" .. s, Vector3.new(5, 0.9, 3.2), CFrame.new(-80 + math.cos(ang) * 9, 2 + s * 2.4, -18 + math.sin(ang) * 9) * CFrame.Angles(0, -ang, 0), Color3.fromRGB(129, 140, 248), Enum.Material.Neon)
end

local potionStand = makePart(lobby, "PotionAlchemistStand", Vector3.new(34, 2, 34), CFrame.new(-74, 1.4, 30), Color3.fromRGB(154, 91, 37), Enum.Material.WoodPlanks)
local cauldron = makePart(lobby, "AlchemistCauldron", Vector3.new(6.5, 4.5, 6.5), CFrame.new(-78, 5, 30), Color3.fromRGB(52, 211, 153), Enum.Material.Neon, Enum.PartType.Cylinder)
addBillboard(cauldron, "ALCHEMIST POTION & TRAIT FORGE", Color3.fromRGB(52, 211, 153), 5)

makePart(lobby, "DuelArenaStage", Vector3.new(46, 2, 36), CFrame.new(76, 1.4, 30), Color3.fromRGB(241, 245, 249), Enum.Material.Marble)
local clashCenter = makePart(lobby, "ClashCenterPlatform", Vector3.new(12, 0.8, 12), CFrame.new(76, 2.7, 30), Color3.fromRGB(250, 204, 21), Enum.Material.Neon, Enum.PartType.Cylinder)
addBillboard(clashCenter, "4v4 PVP & CLASH ARENA", Color3.fromRGB(250, 204, 21), 8.5)
for slot = 1, 4 do
    local zOff = 19.5 + (slot - 1) * 7
    makePart(lobby, "LeftStagePad" .. slot, Vector3.new(5, 0.7, 5), CFrame.new(60, 2.7, zOff), Color3.fromRGB(37, 99, 235), Enum.Material.Neon)
    makePart(lobby, "RightStagePad" .. slot, Vector3.new(5, 0.7, 5), CFrame.new(92, 2.7, zOff), Color3.fromRGB(220, 38, 38), Enum.Material.Neon)
end

-- Cherry-Blossom Lantern Trees
for tidx, tpos in ipairs({ Vector3.new(-31, 6, -31), Vector3.new(31, 6, -31), Vector3.new(-31, 6, 31), Vector3.new(31, 6, 31) }) do
    makePart(lobby, "SakuraTrunk" .. tidx, Vector3.new(2.2, 9, 2.2), CFrame.new(tpos), Color3.fromRGB(110, 68, 38), Enum.Material.Wood, Enum.PartType.Cylinder)
    makePart(lobby, "SakuraCanopy" .. tidx, Vector3.new(9, 6, 9), CFrame.new(tpos + Vector3.new(0, 5.8, 0)), Color3.fromRGB(244, 114, 182), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
    local lant = makePart(lobby, "SakuraLantern" .. tidx, Vector3.new(1.4, 1.8, 1.4), CFrame.new(tpos + Vector3.new(0, 2.2, -2.5)), Color3.fromRGB(251, 191, 36), Enum.Material.Neon)
    addLight(lant, Color3.fromRGB(251, 191, 36), 1.5, 24)
end

-- 5. Hall of Legends 3D Card Showcases (Decal + SurfaceGui ImageLabel + Particle + Light + Billboard + Highlight)
local boardWall = makePart(lobby, "LeaderboardWall", Vector3.new(34, 13.0, 2.2), CFrame.new(0, 15.5, 79), Color3.fromRGB(30, 41, 59), Enum.Material.SmoothPlastic)
local galleryFolder = lobby:FindFirstChild("CardShowcases")
if not galleryFolder then
    galleryFolder = Instance.new("Folder")
    galleryFolder.Name = "CardShowcases"
    galleryFolder.Parent = lobby
end

for i = 1, SHOWCASE_COUNT do
    local card = SHOWCASE_CARDS[((i - 1) % #SHOWCASE_CARDS) + 1]
    local standName = "Showcase_" .. card.id
    if not galleryFolder:FindFirstChild(standName) then
        local stand = Instance.new("Part")
        stand.Name = standName
        stand.Size = Vector3.new(6.2, 8.6, 0.9)
        stand.Position = Vector3.new((i - (SHOWCASE_COUNT + 1) / 2) * 10.5, 8.2, 64)
        stand.Anchored = true
        stand.Material = Enum.Material.SmoothPlastic
        stand.Color = card.color
        stand:SetAttribute("CardId", card.id)

        local decal = Instance.new("Decal")
        decal.Name = "CardArtDecal"
        decal.Face = Enum.NormalId.Front
        decal.Texture = "rbxasset://openro-assets/" .. card.id .. ".png"
        decal.Parent = stand

        local gui = Instance.new("SurfaceGui")
        gui.Name = "CardInfoGui"
        gui.Face = Enum.NormalId.Front
        local img = Instance.new("ImageLabel")
        img.Name = "CardArtImage"
        img.Size = UDim2.new(1, 0, 0.80, 0)
        img.BackgroundTransparency = 1
        img.Image = "rbxasset://openro-assets/" .. card.id .. ".png"
        img.Parent = gui

        local title = Instance.new("TextLabel")
        title.Name = "CardCaption"
        title.Size = UDim2.new(1, 0, 0.20, 0)
        title.Position = UDim2.new(0, 0, 0.80, 0)
        title.BackgroundTransparency = 0.2
        title.TextColor3 = Color3.fromRGB(255, 255, 255)
        title.TextScaled = true
        title.Text = card.title .. " [" .. card.rarity .. " " .. card.odds .. "]"
        title.Parent = gui
        gui.Parent = stand

        local particles = Instance.new("ParticleEmitter")
        particles.Rate = 12
        particles.Parent = stand

        local hl = Instance.new("Highlight")
        hl.FillTransparency = 0.84
        hl.OutlineColor = card.color
        hl.Parent = stand

        addBillboard(stand, card.title .. " [" .. card.rarity .. "]", card.color, 6.2)
        addLight(stand, card.color, 1.7, 18)
        stand.Parent = galleryFolder
    end
end

if not boardWall:FindFirstChild("TowerLeaderboardGui") then
    local lbGui = Instance.new("SurfaceGui")
    lbGui.Name = "TowerLeaderboardGui"
    local lbText = Instance.new("TextLabel")
    lbText.Name = "Rankings"
    lbText.Size = UDim2.new(1, 0, 1, 0)
    lbText.BackgroundTransparency = 0.15
    lbText.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbText.TextScaled = true
    lbText.Text = "APEX TOWER LEADERBOARD"
    lbText.Parent = lbGui
    lbGui.Parent = boardWall

    task.spawn(function()
        while boardWall.Parent do
            local lines = { "APEX TOWER LEADERBOARD" }
            for _, p in ipairs(Players:GetPlayers()) do
                local floor = p:GetAttribute("TowerFloor") or 1
                table.insert(lines, p.Name .. " - Floor " .. tostring(floor))
            end
            lbText.Text = table.concat(lines, "\\n")
            task.wait(5)
        end
    end)
end

if ENABLE_HOLOGRAMS and rollPedestal and holoRing then
    local t = 0
    local basePos = holoRing.Position
    RunService.Heartbeat:Connect(function(dt)
        if not holoRing.Parent then
            return
        end
        t = t + dt
        local bob = math.sin(t * 2.2) * 0.65
        holoRing.CFrame = CFrame.new(basePos + Vector3.new(0, bob, 0)) * CFrame.Angles(0, t * 1.4, math.rad(14))
    end)
end
`
    } else {
        `
local lobby = workspace.${lobby_name}
print("CardGalleryWorld linked to " .. lobby.Name .. " (" .. SHOWCASE_COUNT .. " showcases, holograms=" .. tostring(ENABLE_HOLOGRAMS) .. ")")
`
    };
    header + setup + build
}
