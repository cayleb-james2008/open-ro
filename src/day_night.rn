// OpenRO Rune skill: generate a DayNight Luau script.
// Parameter: cycle_minutes (int) — how many real minutes one full
// in-game day takes. The generated Script goes in ServerScriptService
// and advances Lighting.ClockTime continuously.
pub fn generate_day_night(cycle_minutes) {
    let header = "-- DayNight -- generated by OpenRO (Rune skill: day_night)\n";
    let body = `local Lighting = game:GetService("Lighting")\nlocal CYCLE_MINUTES = ${cycle_minutes}\n\nwhile true do\n    Lighting.ClockTime = (Lighting.ClockTime + 24 / (CYCLE_MINUTES * 60)) % 24\n    task.wait(1)\nend\n`;
    header + body
}
