// OpenRO Rune skill: generate a Checkpoints Luau script.
// Parameters: stage_count (int) — how many stages; folder_name
// (string, a plain identifier — the Rust side validates it) — the
// Workspace folder the stage pads live in; create_folder (bool) —
// when true the script creates the folder and its pads itself; when
// false it only references workspace.<folder>, which fails at runtime
// if nothing made it. The generated Script goes in
// ServerScriptService: touching a pad records the player's stage, and
// respawning places them back on their highest stage's pad.
pub fn generate_checkpoints(stage_count, folder_name, create_folder) {
    let header = "-- Checkpoints -- generated by OpenRO (Rune skill: checkpoints)\n";
    let setup = `local Players = game:GetService("Players")\nlocal STAGES = ${stage_count}\n\n`;
    let folder = if create_folder {
        `local folder = Instance.new("Folder")\nfolder.Name = "${folder_name}"\nfolder.Parent = workspace\n\nfor i = 1, STAGES do\n    local pad = Instance.new("Part")\n    pad.Name = "Stage" .. i\n    pad.Anchored = true\n    pad.CanCollide = false\n    pad.Transparency = 0.4\n    pad.Size = Vector3.new(8, 1, 8)\n    pad.Position = Vector3.new(0, 1, (i - 1) * 24)\n    pad.Parent = folder\n    pad.Touched:Connect(function(hit)\n        local character = hit.Parent\n        local p = character and Players:GetPlayerFromCharacter(character)\n        if p then\n            local current = p:GetAttribute("Stage") or 0\n            if i > current then\n                p:SetAttribute("Stage", i)\n            end\n        end\n    end)\nend\n\n`
    } else {
        `local folder = workspace.${folder_name}\n\n`
    };
    let respawn = "Players.PlayerAdded:Connect(function(player)\n    player:SetAttribute(\"Stage\", 1)\n    player.CharacterAdded:Connect(function(character)\n        local stage = player:GetAttribute(\"Stage\") or 1\n        local pad = folder:FindFirstChild(\"Stage\" .. stage)\n        local root = character:WaitForChild(\"HumanoidRootPart\")\n        if pad and root then\n            root.CFrame = pad.CFrame + Vector3.new(0, 3, 0)\n        end\n    end)\nend)\n";
    header + setup + folder + respawn
}
