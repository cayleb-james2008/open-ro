// OpenRO Rune skill: generate a VehicleSpawner Luau script.
// Parameters: vehicle_name (string, plain identifier) — spawned vehicle model prefix;
// max_speed (int) — VehicleSeat.MaxSpeed; cooldown_seconds (int) — per-player cooldown;
// create_pad (bool) — create the spawner pad + ProximityPrompt if true.
// Enforces a strict 1-vehicle-per-player limit, destroys old vehicles on respawn
// and on PlayerRemoving so abandoned chassis never accumulate.

pub fn generate_vehicle_spawner(vehicle_name, max_speed, cooldown_seconds, create_pad) {
    let header = "-- VehicleSpawner -- generated by OpenRO (Rune skill: vehicle_spawner)\n";
    let setup = `local Players = game:GetService("Players")\n\nlocal VEHICLE_NAME = "${vehicle_name}"\nlocal MAX_SPEED = ${max_speed}\nlocal COOLDOWN_SECONDS = ${cooldown_seconds}\n\n`;
    let pad_block = if create_pad {
        `local pad = workspace:FindFirstChild("${vehicle_name}Pad")\nif not pad then\n    pad = Instance.new("Part")\n    pad.Name = "${vehicle_name}Pad"\n    pad.Size = Vector3.new(10, 1, 10)\n    pad.Position = Vector3.new(20, 1, 0)\n    pad.Anchored = true\n    pad.CanCollide = true\n    pad.Material = Enum.Material.DiamondPlate\n    pad.Color = Color3.fromRGB(240, 165, 45)\n    pad.Parent = workspace\nend\n\n`
    } else {
        `local pad = workspace.${vehicle_name}Pad\n\n`
    };
    let logic = "local prompt = pad:FindFirstChildOfClass(\"ProximityPrompt\")\nif not prompt then\n    prompt = Instance.new(\"ProximityPrompt\")\n    prompt.Name = \"SpawnVehiclePrompt\"\n    prompt.ActionText = \"Spawn \" .. VEHICLE_NAME\n    prompt.ObjectText = VEHICLE_NAME .. \" Bay\"\n    prompt.HoldDuration = 0.2\n    prompt.MaxActivationDistance = 12\n    prompt.Parent = pad\nend\n\nlocal activeVehicles = {}\nlocal lastSpawn = {}\n\nlocal function cleanupVehicle(player)\n    local existing = activeVehicles[player]\n    if existing and existing.Parent then\n        existing:Destroy()\n    end\n    activeVehicles[player] = nil\nend\n\nlocal function buildVehicle(owner, spawnCFrame)\n    local model = Instance.new(\"Model\")\n    model.Name = owner.Name .. \"_\" .. VEHICLE_NAME\n\n    local chassis = Instance.new(\"Part\")\n    chassis.Name = \"Chassis\"\n    chassis.Size = Vector3.new(6, 1.2, 10)\n    chassis.CFrame = spawnCFrame\n    chassis.Material = Enum.Material.Metal\n    chassis.Color = Color3.fromRGB(45, 95, 195)\n    chassis.Parent = model\n\n    local seat = Instance.new(\"VehicleSeat\")\n    seat.Name = \"DriveSeat\"\n    seat.Size = Vector3.new(2, 1, 2)\n    seat.CFrame = spawnCFrame + Vector3.new(0, 1.2, 0)\n    seat.MaxSpeed = MAX_SPEED\n    seat.Torque = 18\n    seat.TurnSpeed = 2\n    seat.Parent = model\n\n    local weld = Instance.new(\"WeldConstraint\")\n    weld.Part0 = chassis\n    weld.Part1 = seat\n    weld.Parent = chassis\n\n    model.PrimaryPart = chassis\n    model:SetAttribute(\"OwnerUserId\", owner.UserId)\n    model.Parent = workspace\n    return model\nend\n\nprompt.Triggered:Connect(function(player)\n    local now = os.clock()\n    if lastSpawn[player] and (now - lastSpawn[player]) < COOLDOWN_SECONDS then\n        return\n    end\n    lastSpawn[player] = now\n    cleanupVehicle(player)\n    local vehicle = buildVehicle(player, pad.CFrame + Vector3.new(0, 4, 0))\n    activeVehicles[player] = vehicle\nend)\n\nPlayers.PlayerRemoving:Connect(function(player)\n    cleanupVehicle(player)\n    lastSpawn[player] = nil\nend)\n";
    header + setup + pad_block + logic
}
