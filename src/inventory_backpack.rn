// OpenRO Rune skill: generate an InventoryBackpack Luau script.
// Parameters: starter_item (string) — initial item granted on join;
// max_slots (int) — maximum inventory slots per player;
// remote_name (string, plain identifier) — RemoteEvent name in ReplicatedStorage.
// Server-authoritative: stores owned items server-side, validates action & item
// types, enforces rate limits and ownership before equipping, and cleans up on leave.

fn esc(s) {
    let out = "";
    for c in s.chars() {
        if c == '\\' {
            out = `${out}\\\\`;
        } else if c == '"' {
            out = `${out}\\\"`;
        } else if c == '\n' {
            out = `${out}\\n`;
        } else if c == '\r' {
            out = `${out}\\r`;
        } else {
            out = `${out}${c}`;
        }
    }
    out
}

pub fn generate_inventory_backpack(starter_item, max_slots, remote_name) {
    let starter = esc(starter_item);
    let header = "-- InventoryBackpack -- generated by OpenRO (Rune skill: inventory_backpack)\n";
    let body = `local Players = game:GetService("Players")\nlocal ReplicatedStorage = game:GetService("ReplicatedStorage")\n\nlocal STARTER_ITEM = "${starter}"\nlocal MAX_SLOTS = ${max_slots}\nlocal REMOTE_NAME = "${remote_name}"\n\nlocal equipEvent = ReplicatedStorage:FindFirstChild(REMOTE_NAME)\nif not equipEvent then\n    equipEvent = Instance.new("RemoteEvent")\n    equipEvent.Name = REMOTE_NAME\n    equipEvent.Parent = ReplicatedStorage\nend\n\nlocal inventories = {}\nlocal lastRequest = {}\n\nlocal function syncFolder(player)\n    local record = inventories[player]\n    if not record then\n        return\n    end\n    local folder = player:FindFirstChild("Inventory")\n    if not folder then\n        folder = Instance.new("Folder")\n        folder.Name = "Inventory"\n        folder.Parent = player\n    end\n    folder:ClearAllChildren()\n    for index, itemName in ipairs(record.items) do\n        local slot = Instance.new("StringValue")\n        slot.Name = "Slot" .. index\n        slot.Value = itemName\n        slot.Parent = folder\n    end\n    player:SetAttribute("EquippedItem", record.equipped or "")\nend\n\nlocal function ownsItem(record, itemName)\n    for _, owned in ipairs(record.items) do\n        if owned == itemName then\n            return true\n        end\n    end\n    return false\nend\n\nlocal function grantItem(player, itemName)\n    local record = inventories[player]\n    if not record or #record.items >= MAX_SLOTS then\n        return false\n    end\n    if ownsItem(record, itemName) then\n        return false\n    end\n    table.insert(record.items, itemName)\n    syncFolder(player)\n    return true\nend\n\nlocal function onPlayerAdded(player)\n    inventories[player] = { items = {}, equipped = nil }\n    grantItem(player, STARTER_ITEM)\n    equipEvent:FireClient(player, "sync", inventories[player].items, "")\nend\n\nPlayers.PlayerAdded:Connect(onPlayerAdded)\nfor _, existing in ipairs(Players:GetPlayers()) do\n    onPlayerAdded(existing)\nend\n\nequipEvent.OnServerEvent:Connect(function(player, action, itemName)\n    local now = os.clock()\n    if lastRequest[player] and (now - lastRequest[player]) < 0.2 then\n        return\n    end\n    lastRequest[player] = now\n    if typeof(action) ~= "string" then\n        return\n    end\n    local record = inventories[player]\n    if not record then\n        return\n    end\n    if action == "unequip" then\n        record.equipped = nil\n        syncFolder(player)\n        equipEvent:FireClient(player, "unequipped", "")\n        return\n    end\n    if action ~= "equip" then\n        return\n    end\n    if typeof(itemName) ~= "string" or #itemName == 0 or #itemName > 64 then\n        return\n    end\n    if not ownsItem(record, itemName) then\n        return\n    end\n    record.equipped = itemName\n    syncFolder(player)\n    equipEvent:FireClient(player, "equipped", itemName)\nend)\n\nPlayers.PlayerRemoving:Connect(function(player)\n    inventories[player] = nil\n    lastRequest[player] = nil\nend)\n`;
    header + body
}
