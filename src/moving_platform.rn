// OpenRO Rune skill: generate a MovingPlatform Luau script.
// Parameters: platform_name (string, plain identifier) — Workspace Part name;
// travel_distance (int) — studs travelled from origin along axis;
// travel_seconds (int) — duration of one half-cycle in seconds;
// axis (string: "X" | "Y" | "Z") — movement axis;
// create_platform (bool) — create the anchored Part if missing.
// Uses RunService.Heartbeat + delta CFrame player carry and AssemblyLinearVelocity
// so standing players ride smoothly without slipping off.

pub fn generate_moving_platform(platform_name, travel_distance, travel_seconds, axis, create_platform) {
    let header = "-- MovingPlatform -- generated by OpenRO (Rune skill: moving_platform)\n";
    let axis_vec = if axis == "Y" {
        "Vector3.new(0, 1, 0)"
    } else if axis == "Z" {
        "Vector3.new(0, 0, 1)"
    } else {
        "Vector3.new(1, 0, 0)"
    };
    let setup = `local Players = game:GetService("Players")\nlocal RunService = game:GetService("RunService")\nlocal TweenService = game:GetService("TweenService")\n\nlocal TRAVEL_DISTANCE = ${travel_distance}\nlocal TRAVEL_SECONDS = ${travel_seconds}\nlocal AXIS = ${axis_vec}\n\n`;
    let part_block = if create_platform {
        `local platform = workspace:FindFirstChild("${platform_name}")\nif not platform then\n    platform = Instance.new("Part")\n    platform.Name = "${platform_name}"\n    platform.Size = Vector3.new(10, 1, 10)\n    platform.Position = Vector3.new(0, 6, 32)\n    platform.Anchored = true\n    platform.CanCollide = true\n    platform.Material = Enum.Material.SmoothPlastic\n    platform.Color = Color3.fromRGB(79, 124, 240)\n    platform.Parent = workspace\nend\n\n`
    } else {
        `local platform = workspace.${platform_name}\n\n`
    };
    let body = "local originCFrame = platform.CFrame\nlocal elapsed = 0\nlocal riders = {}\n\nlocal light = Instance.new(\"PointLight\")\nlight.Color = Color3.fromRGB(130, 180, 255)\nlight.Range = 12\nlight.Brightness = 0.8\nlight.Parent = platform\n\nlocal glowTween = TweenService:Create(\n    light,\n    TweenInfo.new(TRAVEL_SECONDS, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),\n    { Brightness = 1.6 }\n)\nglowTween:Play()\n\nplatform.Touched:Connect(function(hit)\n    local character = hit.Parent\n    local player = character and Players:GetPlayerFromCharacter(character)\n    if player then\n        riders[player] = os.clock()\n    end\nend)\n\nPlayers.PlayerRemoving:Connect(function(player)\n    riders[player] = nil\nend)\n\nRunService.Heartbeat:Connect(function(dt)\n    if dt <= 0 or not platform.Parent then\n        return\n    end\n    elapsed = elapsed + dt\n    local alpha = 0.5 - 0.5 * math.cos((elapsed / TRAVEL_SECONDS) * math.pi)\n    local targetCFrame = originCFrame + (AXIS * (TRAVEL_DISTANCE * alpha))\n    local deltaPos = targetCFrame.Position - platform.Position\n    platform.CFrame = targetCFrame\n    platform.AssemblyLinearVelocity = deltaPos / dt\n\n    local now = os.clock()\n    for player, lastSeen in pairs(riders) do\n        if (now - lastSeen) > 0.35 then\n            riders[player] = nil\n        else\n            local character = player.Character\n            local root = character and character:FindFirstChild(\"HumanoidRootPart\")\n            if root and math.abs(root.Position.Y - platform.Position.Y) < 6 then\n                root.CFrame = root.CFrame + deltaPos\n            end\n        end\n    end\nend)\n";
    header + setup + part_block + body
}
