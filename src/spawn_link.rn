// OpenRO Rune skill: generate a SpawnLink Luau script.
// Parameter: instance_name (string) — a Workspace child the script
// links to at startup (for example a SpawnLocation named "SpawnPad").
// The name is interpolated in member position (workspace.<name>), and
// the Rust side validates it as a plain identifier before this script
// runs, so it can never break out into arbitrary Luau.
pub fn generate_spawn_link(instance_name) {
    let header = "-- SpawnLink -- generated by OpenRO (Rune skill: spawn_link)\n";
    let body = `local pad = workspace.${instance_name}\nprint("Spawn link OK: " .. pad.Name)\n`;
    header + body
}
