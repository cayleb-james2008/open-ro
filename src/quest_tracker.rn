// OpenRO Rune skill: generate a QuestTracker Luau script.
// Parameters: quest_name (string) — display name of the milestone objective;
// target_count (int) — count required to complete the quest;
// reward_amount (int) — currency paid upon server-verified completion;
// currency (string) — leaderstats IntValue name to credit.
// Server-authoritative: clients can only request "sync" or "claim"; actual
// progress increments happen strictly via server-side ServerStorage BindableEvent.

fn esc(s) {
    let out = "";
    for c in s.chars() {
        if c == '\\' {
            out = `${out}\\\\`;
        } else if c == '"' {
            out = `${out}\\\"`;
        } else if c == '\n' {
            out = `${out}\\n`;
        } else if c == '\r' {
            out = `${out}\\r`;
        } else {
            out = `${out}${c}`;
        }
    }
    out
}

pub fn generate_quest_tracker(quest_name, target_count, reward_amount, currency) {
    let qname = esc(quest_name);
    let cur = esc(currency);
    let header = "-- QuestTracker -- generated by OpenRO (Rune skill: quest_tracker)\n";
    let body = `local Players = game:GetService("Players")\nlocal ReplicatedStorage = game:GetService("ReplicatedStorage")\nlocal ServerStorage = game:GetService("ServerStorage")\n\nlocal QUEST_NAME = "${qname}"\nlocal TARGET_COUNT = ${target_count}\nlocal REWARD_AMOUNT = ${reward_amount}\nlocal CURRENCY = "${cur}"\n\nlocal progressEvent = ReplicatedStorage:FindFirstChild("OpenROQuestProgress")\nif not progressEvent then\n    progressEvent = Instance.new("RemoteEvent")\n    progressEvent.Name = "OpenROQuestProgress"\n    progressEvent.Parent = ReplicatedStorage\nend\n\nlocal advanceSignal = ServerStorage:FindFirstChild("OpenROQuestAdvance")\nif not advanceSignal then\n    advanceSignal = Instance.new("BindableEvent")\n    advanceSignal.Name = "OpenROQuestAdvance"\n    advanceSignal.Parent = ServerStorage\nend\n\nlocal questState = {}\nlocal lastRequest = {}\n\nlocal function payout(player)\n    local stats = player:FindFirstChild("leaderstats")\n    if not stats then\n        stats = Instance.new("Folder")\n        stats.Name = "leaderstats"\n        stats.Parent = player\n    end\n    local stat = stats:FindFirstChild(CURRENCY)\n    if not stat then\n        stat = Instance.new("IntValue")\n        stat.Name = CURRENCY\n        stat.Value = 0\n        stat.Parent = stats\n    end\n    stat.Value = stat.Value + REWARD_AMOUNT\nend\n\nlocal function pushState(player)\n    local state = questState[player]\n    if not state then\n        return\n    end\n    player:SetAttribute("QuestName", QUEST_NAME)\n    player:SetAttribute("QuestProgress", state.progress)\n    player:SetAttribute("QuestCompleted", state.completed)\n    progressEvent:FireClient(player, QUEST_NAME, state.progress, TARGET_COUNT, state.completed)\nend\n\nlocal function advanceQuest(player, delta)\n    if typeof(player) ~= "Instance" or not player:IsA("Player") then\n        return\n    end\n    if typeof(delta) ~= "number" or delta <= 0 or delta ~= delta then\n        return\n    end\n    local state = questState[player]\n    if not state or state.completed then\n        return\n    end\n    local step = math.clamp(math.floor(delta), 1, TARGET_COUNT)\n    state.progress = math.min(TARGET_COUNT, state.progress + step)\n    if state.progress >= TARGET_COUNT and not state.claimed then\n        state.completed = true\n        state.claimed = true\n        payout(player)\n    end\n    pushState(player)\nend\n\nadvanceSignal.Event:Connect(advanceQuest)\n\nlocal function onPlayerAdded(player)\n    questState[player] = { progress = 0, completed = false, claimed = false }\n    pushState(player)\nend\n\nPlayers.PlayerAdded:Connect(onPlayerAdded)\nfor _, existing in ipairs(Players:GetPlayers()) do\n    onPlayerAdded(existing)\nend\n\nprogressEvent.OnServerEvent:Connect(function(player, requestType)\n    local now = os.clock()\n    if lastRequest[player] and (now - lastRequest[player]) < 0.5 then\n        return\n    end\n    lastRequest[player] = now\n    if typeof(requestType) ~= "string" then\n        return\n    end\n    local state = questState[player]\n    if not state then\n        return\n    end\n    if requestType == "sync" then\n        pushState(player)\n    elseif requestType == "claim" then\n        if state.progress >= TARGET_COUNT and not state.claimed then\n            state.completed = true\n            state.claimed = true\n            payout(player)\n            pushState(player)\n        end\n    end\nend)\n\nPlayers.PlayerRemoving:Connect(function(player)\n    questState[player] = nil\n    lastRequest[player] = nil\nend)\n`;
    header + body
}
