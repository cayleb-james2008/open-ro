// OpenRO Rune skill: generate a PortalTeleporter Luau script.
// Parameters: pair_name (string, plain identifier) — Folder name for paired portals;
// cooldown_seconds (int) — per-player warp cooldown;
// offset_distance (int) — distance in studs between PortalA and PortalB;
// create_portals (bool) — create PortalA and PortalB if true, else link workspace.<pair_name>.

pub fn generate_portal_teleporter(pair_name, cooldown_seconds, offset_distance, create_portals) {
    let header = "-- PortalTeleporter -- generated by OpenRO (Rune skill: portal_teleporter)\n";
    let setup = `local Players = game:GetService("Players")\n\nlocal COOLDOWN_SECONDS = ${cooldown_seconds}\nlocal OFFSET_DISTANCE = ${offset_distance}\n\n`;
    let build_block = if create_portals {
        `local folder = workspace:FindFirstChild("${pair_name}")\nif not folder then\n    folder = Instance.new("Folder")\n    folder.Name = "${pair_name}"\n    folder.Parent = workspace\nend\n\nlocal function makePortal(name, pos, color)\n    local existing = folder:FindFirstChild(name)\n    if existing then\n        return existing\n    end\n    local pad = Instance.new("Part")\n    pad.Name = name\n    pad.Size = Vector3.new(6, 1, 6)\n    pad.Position = pos\n    pad.Anchored = true\n    pad.CanCollide = true\n    pad.Material = Enum.Material.Neon\n    pad.Color = color\n    local light = Instance.new("PointLight")\n    light.Color = color\n    light.Range = 14\n    light.Brightness = 1.5\n    light.Parent = pad\n    local fx = Instance.new("ParticleEmitter")\n    fx.Name = "WarpFX"\n    fx.Enabled = false\n    fx.Color = ColorSequence.new(color)\n    fx.Speed = NumberRange.new(8, 16)\n    fx.Lifetime = NumberRange.new(0.4, 0.8)\n    fx.Parent = pad\n    pad.Parent = folder\n    return pad\nend\n\nlocal portalA = makePortal("PortalA", Vector3.new(-12, 1, 0), Color3.fromRGB(70, 150, 255))\nlocal portalB = makePortal("PortalB", Vector3.new(-12, 1, OFFSET_DISTANCE), Color3.fromRGB(168, 85, 247))\n\n`
    } else {
        `local folder = workspace.${pair_name}\nlocal portalA = folder:WaitForChild("PortalA")\nlocal portalB = folder:WaitForChild("PortalB")\n\n`
    };
    let logic = "local lastWarp = {}\n\nlocal function bindWarp(sourcePad, destPad)\n    sourcePad.Touched:Connect(function(hit)\n        local character = hit.Parent\n        local player = character and Players:GetPlayerFromCharacter(character)\n        if not player then\n            return\n        end\n        local humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n        local root = character:FindFirstChild(\"HumanoidRootPart\")\n        if not humanoid or not root or humanoid.Health <= 0 then\n            return\n        end\n        local now = os.clock()\n        if lastWarp[player] and (now - lastWarp[player]) < COOLDOWN_SECONDS then\n            return\n        end\n        lastWarp[player] = now\n        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)\n        root.CFrame = destPad.CFrame + Vector3.new(0, 4, 0)\n        local srcFx = sourcePad:FindFirstChildOfClass(\"ParticleEmitter\")\n        local dstFx = destPad:FindFirstChildOfClass(\"ParticleEmitter\")\n        if srcFx then\n            srcFx:Emit(14)\n        end\n        if dstFx then\n            dstFx:Emit(14)\n        end\n    end)\nend\n\nbindWarp(portalA, portalB)\nbindWarp(portalB, portalA)\n\nPlayers.PlayerRemoving:Connect(function(player)\n    lastWarp[player] = nil\nend)\n";
    header + setup + build_block + logic
}
