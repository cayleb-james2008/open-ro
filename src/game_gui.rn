// OpenRO Rune skill: generate a GameGui Luau script.
// Parameters: title (string) — the game's name shown at the top;
// button_label (string) — the shop button's text; currency (string) —
// the leaderstats stat the balance label follows. The generated
// LocalScript belongs in StarterGui: it builds a ScreenGui with the
// title, a live currency label bound to the player's leaderstats, and
// a button that fires the shop's OpenROShopBuy RemoteEvent — which
// only exists once the shop skill has been written, so a game with
// this GUI and no shop fails its playtest until the shop is added.
//
// Title, label and currency are interpolated into Luau string
// literals, so they are escaped first — the same discipline as the
// leaderboard skill.

fn esc(s) {
    let out = "";
    for c in s.chars() {
        if c == '\\' {
            out = `${out}\\\\`;
        } else if c == '"' {
            out = `${out}\\\"`;
        } else if c == '\n' {
            out = `${out}\\n`;
        } else if c == '\r' {
            out = `${out}\\r`;
        } else {
            out = `${out}${c}`;
        }
    }
    out
}

pub fn generate_game_gui(title, button_label, currency) {
    let t = esc(title);
    let label = esc(button_label);
    let cur = esc(currency);
    let header = "-- GameGui -- generated by OpenRO (Rune skill: game_gui)\n";
    let body = `local Players = game:GetService("Players")\nlocal ReplicatedStorage = game:GetService("ReplicatedStorage")\nlocal player = Players.LocalPlayer\n\nlocal gui = Instance.new("ScreenGui")\ngui.Name = "GameGui"\ngui.Parent = player:WaitForChild("PlayerGui")\n\nlocal title = Instance.new("TextLabel")\ntitle.Name = "Title"\ntitle.Text = "${t}"\ntitle.Size = UDim2.new(0, 320, 0, 48)\ntitle.Position = UDim2.new(0.5, -160, 0, 16)\ntitle.BackgroundTransparency = 0.3\ntitle.Parent = gui\n\nlocal balance = Instance.new("TextLabel")\nbalance.Name = "Balance"\nbalance.Size = UDim2.new(0, 200, 0, 36)\nbalance.Position = UDim2.new(0, 16, 0, 16)\nbalance.BackgroundTransparency = 0.3\nbalance.Parent = gui\n\nlocal stats = player:WaitForChild("leaderstats")\nlocal stat = stats:WaitForChild("${cur}")\nlocal function refresh()\n    balance.Text = "${cur}: " .. stat.Value\nend\nstat.Changed:Connect(refresh)\nrefresh()\n\nlocal button = Instance.new("TextButton")\nbutton.Name = "ShopButton"\nbutton.Text = "${label}"\nbutton.Size = UDim2.new(0, 160, 0, 44)\nbutton.Position = UDim2.new(1, -176, 0, 16)\nbutton.Parent = gui\nbutton.MouseButton1Click:Connect(function()\n    ReplicatedStorage:WaitForChild("OpenROShopBuy"):FireServer()\nend)\n`;
    header + body
}
