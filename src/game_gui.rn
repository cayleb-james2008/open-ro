// OpenRO skill: generate a GameGui Luau script.
// Parameters: title (string) — the game's name shown at the top;
// button_label (string) — the shop button's text; currency (string) —
// the leaderstats stat the balance label follows. The generated
// LocalScript belongs in StarterGui: it builds a ScreenGui with the
// title, a live currency label bound to the player's leaderstats, and
// a button that fires the shop's OpenROShopBuy RemoteEvent — which
// only exists once the shop skill has been written, so a game with
// this GUI and no shop fails its playtest until the shop is added.
//
// Gap #91 (Image-Gen-First UI Craft): when the project ships an
// AssetIds module (ReplicatedStorage.Shared.Content.AssetIds or
// ReplicatedStorage.Shared.AssetIds) with sliced panels_sheet PNGs
// (`slices["obsidian-prism/modal_glass"]`, `btn_emerald`,
// `title_ribbon`), the HUD binds them as ImageLabel 9-slice chrome
// (ScaleType.Slice + SliceCenter) under transparent parents
// (BackgroundTransparency = 1), and every label carries a UIStroke so
// text stays legible. Without slices it falls back to plain fills.
//
// Title, label and currency are interpolated into Luau string
// literals, so they are escaped first — the same discipline as the
// leaderboard skill.

fn esc(s) {
    let out = "";
    for c in s.chars() {
        if c == '\\' {
            out = `${out}\\\\`;
        } else if c == '"' {
            out = `${out}\\\"`;
        } else if c == '\n' {
            out = `${out}\\n`;
        } else if c == '\r' {
            out = `${out}\\r`;
        } else {
            out = `${out}${c}`;
        }
    }
    out
}

pub fn generate_game_gui(title, button_label, currency) {
    let t = esc(title);
    let label = esc(button_label);
    let cur = esc(currency);
    let header = "-- GameGui -- generated by OpenRO (system: game_gui)\n";
    let body = `local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

-- Image-Gen-First UI Craft: resolve sliced panels_sheet chrome from AssetIds.
local SKIN = "obsidian-prism"
local ASSET_ID_PATHS = {
    { "Shared", "Content", "AssetIds" },
    { "Shared", "AssetIds" },
}
local function findPath(root, names)
    local node = root
    for _, name in ipairs(names) do
        node = node and node:FindFirstChild(name)
    end
    return node
end
local function loadAssetIds()
    for _, names in ipairs(ASSET_ID_PATHS) do
        local mod = findPath(ReplicatedStorage, names)
        if mod and mod:IsA("ModuleScript") then
            local ok, result = pcall(require, mod)
            if ok and type(result) == "table" then
                return result
            end
        end
    end
    return nil
end

local AssetIds = loadAssetIds()
local slices = {}
if AssetIds and type(AssetIds.slices) == "table" then
    slices = AssetIds.slices
end

local function findSlice(key)
    local entry = slices[SKIN .. "/" .. key]
    if type(entry) ~= "table" then
        for k, v in pairs(slices) do
            if type(k) == "string" and type(v) == "table" and string.sub(k, -(#key + 1)) == "/" .. key then
                entry = v
                break
            end
        end
    end
    if type(entry) ~= "table" or type(entry.assetId) ~= "string" or entry.assetId == "" then
        return nil
    end
    return entry
end

local function bindSlice(host, key, chromeName)
    local entry = findSlice(key)
    if not entry then
        return nil
    end
    local chrome = Instance.new("ImageLabel")
    chrome.Name = chromeName
    chrome.Image = entry.assetId
    chrome.ScaleType = Enum.ScaleType.Slice
    if entry.slice then
        chrome.SliceCenter = entry.slice
    end
    chrome.BackgroundTransparency = 1
    chrome.Size = UDim2.fromScale(1, 1)
    chrome.ZIndex = 1
    chrome.Parent = host
    host.BackgroundTransparency = 1
    host.ZIndex = 2
    return chrome
end

local function addTextStroke(label)
    local stroke = Instance.new("UIStroke")
    stroke.Name = "TextStroke"
    stroke.Thickness = 1.8
    stroke.Color = Color3.fromRGB(5, 7, 11)
    stroke.Parent = label
    label.TextColor3 = Color3.fromRGB(244, 247, 252)
    return stroke
end

local gui = Instance.new("ScreenGui")
gui.Name = "GameGui"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
gui.Parent = player:WaitForChild("PlayerGui")

local title = Instance.new("TextLabel")
title.Name = "Title"
title.Text = "${t}"
title.Size = UDim2.new(0, 320, 0, 48)
title.Position = UDim2.new(0.5, -160, 0, 16)
title.BackgroundTransparency = 0.3
title.BackgroundColor3 = Color3.fromRGB(10, 13, 20)
title.Parent = gui
addTextStroke(title)
bindSlice(title, "title_ribbon", "TitleRibbon")

local balance = Instance.new("TextLabel")
balance.Name = "Balance"
balance.Size = UDim2.new(0, 200, 0, 36)
balance.Position = UDim2.new(0, 16, 0, 16)
balance.BackgroundTransparency = 0.3
balance.BackgroundColor3 = Color3.fromRGB(10, 13, 20)
balance.Parent = gui
addTextStroke(balance)
bindSlice(balance, "modal_glass", "PanelChrome")

local stats = player:WaitForChild("leaderstats")
local stat = stats:WaitForChild("${cur}")
local function refresh()
    balance.Text = "${cur}: " .. stat.Value
end
stat.Changed:Connect(refresh)
refresh()

local button = Instance.new("TextButton")
button.Name = "ShopButton"
button.Text = "${label}"
button.Size = UDim2.new(0, 160, 0, 44)
button.Position = UDim2.new(1, -176, 0, 16)
button.BackgroundColor3 = Color3.fromRGB(16, 185, 129)
button.Parent = gui
addTextStroke(button)
bindSlice(button, "btn_emerald", "SliceChrome")
button.MouseButton1Click:Connect(function()
    ReplicatedStorage:WaitForChild("OpenROShopBuy"):FireServer()
end)
`;
    header + body
}
