// OpenRO Rune skill: generate an AdminSpectate Luau script.
// Parameters: remote_name (string, plain identifier) — RemoteEvent in ReplicatedStorage;
// cycle_interval (int) — seconds between round status feed broadcasts;
// allow_all_players (bool) — when true any player may cycle spectator targets,
// when false only the game Creator or players with IsAdmin attribute may spectate.

pub fn generate_admin_spectate(remote_name, cycle_interval, allow_all_players) {
    let allow_lit = if allow_all_players { "true" } else { "false" };
    let header = "-- AdminSpectate -- generated by OpenRO (Rune skill: admin_spectate)\n";
    let body = `local Players = game:GetService("Players")\nlocal ReplicatedStorage = game:GetService("ReplicatedStorage")\n\nlocal REMOTE_NAME = "${remote_name}"\nlocal CYCLE_INTERVAL = ${cycle_interval}\nlocal ALLOW_ALL_PLAYERS = ${allow_lit}\n\nlocal spectateEvent = ReplicatedStorage:FindFirstChild(REMOTE_NAME)\nif not spectateEvent then\n    spectateEvent = Instance.new("RemoteEvent")\n    spectateEvent.Name = REMOTE_NAME\n    spectateEvent.Parent = ReplicatedStorage\nend\n\nlocal statusValue = ReplicatedStorage:FindFirstChild("OpenRORoundStatus")\nif not statusValue then\n    statusValue = Instance.new("StringValue")\n    statusValue.Name = "OpenRORoundStatus"\n    statusValue.Value = "Round live"\n    statusValue.Parent = ReplicatedStorage\nend\n\nlocal spectating = {}\nlocal targetIndex = {}\nlocal lastRequest = {}\n\nlocal function isAuthorized(player)\n    if ALLOW_ALL_PLAYERS then\n        return true\n    end\n    return player.UserId == game.CreatorId or player:GetAttribute("IsAdmin") == true\nend\n\nlocal function aliveCandidates(excludePlayer)\n    local list = {}\n    for _, candidate in ipairs(Players:GetPlayers()) do\n        if candidate ~= excludePlayer then\n            local char = candidate.Character\n            local hum = char and char:FindFirstChildOfClass("Humanoid")\n            if hum and hum.Health > 0 then\n                table.insert(list, candidate)\n            end\n        end\n    end\n    return list\nend\n\nlocal function sendTarget(player)\n    local active = spectating[player] == true\n    if not active then\n        player:SetAttribute("SpectatingTarget", "")\n        spectateEvent:FireClient(player, { active = false, targetName = "", roundStatus = statusValue.Value })\n        return\n    end\n    local candidates = aliveCandidates(player)\n    if #candidates == 0 then\n        player:SetAttribute("SpectatingTarget", "")\n        spectateEvent:FireClient(player, { active = true, targetName = "", roundStatus = statusValue.Value })\n        return\n    end\n    local idx = ((targetIndex[player] or 1) - 1) % #candidates + 1\n    targetIndex[player] = idx\n    local target = candidates[idx]\n    player:SetAttribute("SpectatingTarget", target.Name)\n    spectateEvent:FireClient(player, {\n        active = true,\n        targetName = target.Name,\n        targetUserId = target.UserId,\n        roundStatus = statusValue.Value,\n    })\nend\n\nspectateEvent.OnServerEvent:Connect(function(player, action)\n    local now = os.clock()\n    if lastRequest[player] and (now - lastRequest[player]) < 0.3 then\n        return\n    end\n    lastRequest[player] = now\n    if typeof(action) ~= "string" then\n        return\n    end\n    if not isAuthorized(player) then\n        return\n    end\n    if action == "toggle" then\n        spectating[player] = not (spectating[player] == true)\n        targetIndex[player] = 1\n        sendTarget(player)\n    elseif action == "next" then\n        spectating[player] = true\n        targetIndex[player] = (targetIndex[player] or 0) + 1\n        sendTarget(player)\n    elseif action == "prev" then\n        spectating[player] = true\n        targetIndex[player] = (targetIndex[player] or 2) - 1\n        sendTarget(player)\n    elseif action == "status" then\n        sendTarget(player)\n    end\nend)\n\nPlayers.PlayerRemoving:Connect(function(player)\n    spectating[player] = nil\n    targetIndex[player] = nil\n    lastRequest[player] = nil\nend)\n\ntask.spawn(function()\n    while true do\n        local total = #Players:GetPlayers()\n        local alive = 0\n        for _, p in ipairs(Players:GetPlayers()) do\n            local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")\n            if hum and hum.Health > 0 then\n                alive = alive + 1\n            end\n        end\n        statusValue.Value = string.format("Alive: %d / %d", alive, total)\n        task.wait(CYCLE_INTERVAL)\n    end\nend)\n`;
    header + body
}
