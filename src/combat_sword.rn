// OpenRO Rune skill: generate a CombatSword Luau script.
// Parameters: sword_name (string) — Tool name in StarterPack;
// damage (int) — server-authoritative damage per validated hit;
// cooldown_ms (int) — minimum milliseconds between swings per player;
// range_studs (int) — maximum server-verified Euclidean strike distance.
// Server-authoritative: validates target type, ancestry, equipped tool,
// alive state, cooldown, and distance before applying damage & KO leaderboard hooks.

fn esc(s) {
    let out = "";
    for c in s.chars() {
        if c == '\\' {
            out = `${out}\\\\`;
        } else if c == '"' {
            out = `${out}\\\"`;
        } else if c == '\n' {
            out = `${out}\\n`;
        } else if c == '\r' {
            out = `${out}\\r`;
        } else {
            out = `${out}${c}`;
        }
    }
    out
}

pub fn generate_combat_sword(sword_name, damage, cooldown_ms, range_studs) {
    let sword = esc(sword_name);
    let header = "-- CombatSword -- generated by OpenRO (Rune skill: combat_sword)\n";
    let body = `local Players = game:GetService("Players")\nlocal ReplicatedStorage = game:GetService("ReplicatedStorage")\nlocal StarterPack = game:GetService("StarterPack")\n\nlocal SWORD_NAME = "${sword}"\nlocal DAMAGE = ${damage}\nlocal COOLDOWN_SEC = ${cooldown_ms} / 1000\nlocal RANGE_STUDS = ${range_studs}\n\nlocal swingEvent = ReplicatedStorage:FindFirstChild("OpenROCombatSwing")\nif not swingEvent then\n    swingEvent = Instance.new("RemoteEvent")\n    swingEvent.Name = "OpenROCombatSwing"\n    swingEvent.Parent = ReplicatedStorage\nend\n\nif not StarterPack:FindFirstChild(SWORD_NAME) then\n    local tool = Instance.new("Tool")\n    tool.Name = SWORD_NAME\n    tool.RequiresHandle = true\n    local handle = Instance.new("Part")\n    handle.Name = "Handle"\n    handle.Size = Vector3.new(0.6, 0.6, 4.2)\n    handle.Color = Color3.fromRGB(205, 215, 228)\n    handle.Material = Enum.Material.Metal\n    handle.Parent = tool\n    tool.Parent = StarterPack\nend\n\nlocal function ensureKoStat(player)\n    local stats = player:FindFirstChild("leaderstats")\n    if not stats then\n        stats = Instance.new("Folder")\n        stats.Name = "leaderstats"\n        stats.Parent = player\n    end\n    if not stats:FindFirstChild("KOs") then\n        local kos = Instance.new("IntValue")\n        kos.Name = "KOs"\n        kos.Value = 0\n        kos.Parent = stats\n    end\nend\n\nPlayers.PlayerAdded:Connect(ensureKoStat)\nfor _, existing in ipairs(Players:GetPlayers()) do\n    ensureKoStat(existing)\nend\n\nlocal lastSwing = {}\n\nswingEvent.OnServerEvent:Connect(function(player, targetModel)\n    local now = os.clock()\n    if lastSwing[player] and (now - lastSwing[player]) < COOLDOWN_SEC then\n        return\n    end\n    if typeof(targetModel) ~= "Instance" or not targetModel:IsA("Model") then\n        return\n    end\n    if not targetModel:IsDescendantOf(workspace) then\n        return\n    end\n    local character = player.Character\n    if not character or targetModel == character then\n        return\n    end\n    if not character:FindFirstChild(SWORD_NAME) then\n        return\n    end\n    local attackerHum = character:FindFirstChildOfClass("Humanoid")\n    local attackerRoot = character:FindFirstChild("HumanoidRootPart")\n    local targetHum = targetModel:FindFirstChildOfClass("Humanoid")\n    local targetRoot = targetModel:FindFirstChild("HumanoidRootPart")\n    if not attackerHum or not attackerRoot or not targetHum or not targetRoot then\n        return\n    end\n    if attackerHum.Health <= 0 or targetHum.Health <= 0 then\n        return\n    end\n    if (attackerRoot.Position - targetRoot.Position).Magnitude > RANGE_STUDS then\n        return\n    end\n    lastSwing[player] = now\n    local wasAlive = targetHum.Health > 0\n    targetHum:TakeDamage(DAMAGE)\n    if wasAlive and targetHum.Health <= 0 then\n        ensureKoStat(player)\n        local stats = player:FindFirstChild("leaderstats")\n        local kos = stats and stats:FindFirstChild("KOs")\n        if kos then\n            kos.Value = kos.Value + 1\n        end\n    end\nend)\n\nPlayers.PlayerRemoving:Connect(function(player)\n    lastSwing[player] = nil\nend)\n`;
    header + body
}
