// OpenRO Rune skill: generate a Leaderboard Luau script.
// Parameters: currency (string) — the stat's name; start_amount (int) —
// the value every joining player starts with. The generated Script goes
// in ServerScriptService and creates a leaderstats folder per player.
pub fn generate_leaderboard(currency, start_amount) {
    let header = "-- Leaderboard -- generated by OpenRO (Rune skill: leaderboard)\n";
    let body = `local Players = game:GetService("Players")\n\nlocal function onPlayerAdded(player)\n    local stats = Instance.new("Folder")\n    stats.Name = "leaderstats"\n    local stat = Instance.new("IntValue")\n    stat.Name = "${currency}"\n    stat.Value = ${start_amount}\n    stat.Parent = stats\n    stats.Parent = player\nend\n\nPlayers.PlayerAdded:Connect(onPlayerAdded)\n`;
    header + body
}
