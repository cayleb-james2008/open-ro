// OpenRO Rune skill: generate a Leaderboard Luau script.
// Parameters: currency (string) — the stat's name; start_amount (int) —
// the value every joining player starts with. The generated Script goes
// in ServerScriptService and creates a leaderstats folder per player.
//
// The currency is interpolated into a Luau string literal, so it is
// escaped first: an unescaped quote in the currency would break out of
// the literal and inject arbitrary Luau into the generated script.

fn esc(s) {
    let out = "";
    for c in s.chars() {
        if c == '\\' {
            out = `${out}\\\\`;
        } else if c == '"' {
            out = `${out}\\\"`;
        } else if c == '\n' {
            out = `${out}\\n`;
        } else if c == '\r' {
            out = `${out}\\r`;
        } else {
            out = `${out}${c}`;
        }
    }
    out
}

pub fn generate_leaderboard(currency, start_amount) {
    let header = "-- Leaderboard -- generated by OpenRO (Rune skill: leaderboard)\n";
    let body = `local Players = game:GetService("Players")\n\nlocal function onPlayerAdded(player)\n    local stats = Instance.new("Folder")\n    stats.Name = "leaderstats"\n    local stat = Instance.new("IntValue")\n    stat.Name = "${esc(currency)}"\n    stat.Value = ${start_amount}\n    stat.Parent = stats\n    stats.Parent = player\nend\n\nPlayers.PlayerAdded:Connect(onPlayerAdded)\n`;
    header + body
}
