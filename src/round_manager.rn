// OpenRO Rune skill: generate a RoundManager Luau script.
// Parameter: create_round (bool) — when true, the generated Luau first
// creates the workspace.Round folder it then starts; when false it only
// references workspace.Round (which fails at runtime if nothing made it).
pub fn generate_round_manager(create_round) {
    let header = "-- RoundManager -- generated by OpenRO (Rune skill: round_manager)\nlocal RoundManager = {}\n";
    let creation = if create_round {
        "local round = Instance.new(\"Folder\")\nround.Name = \"Round\"\nround.Parent = workspace\n"
    } else {
        ""
    };
    let body = "function RoundManager.Start()\n    workspace.Round.Started = true\nend\nreturn RoundManager\n";
    header + creation + body
}
