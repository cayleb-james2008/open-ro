// OpenRO Rune skill: generate a JumpPad Luau script.
// Parameters: boost_power (int) — upward launch velocity in studs/sec;
// cooldown_ms (int) — per-player re-trigger delay in milliseconds;
// pad_name (string, plain identifier) — Workspace Part name;
// create_pad (bool) — when true the script creates the neon pad + FX itself;
// when false it links to workspace.<pad_name>.

pub fn generate_jump_pad(boost_power, cooldown_ms, pad_name, create_pad) {
    let header = "-- JumpPad -- generated by OpenRO (Rune skill: jump_pad)\n";
    let setup = `local Players = game:GetService("Players")\n\nlocal BOOST_POWER = ${boost_power}\nlocal COOLDOWN_SEC = ${cooldown_ms} / 1000\n\n`;
    let pad_block = if create_pad {
        `local pad = workspace:FindFirstChild("${pad_name}")\nif not pad then\n    pad = Instance.new("Part")\n    pad.Name = "${pad_name}"\n    pad.Size = Vector3.new(8, 1, 8)\n    pad.Position = Vector3.new(0, 1, 16)\n    pad.Anchored = true\n    pad.CanCollide = true\n    pad.Material = Enum.Material.Neon\n    pad.Color = Color3.fromRGB(60, 179, 113)\n    pad.Parent = workspace\nend\n\n`
    } else {
        `local pad = workspace.${pad_name}\n\n`
    };
    let fx_and_logic = "local emitter = pad:FindFirstChildOfClass(\"ParticleEmitter\")\nif not emitter then\n    emitter = Instance.new(\"ParticleEmitter\")\n    emitter.Name = \"BounceFX\"\n    emitter.Enabled = false\n    emitter.Speed = NumberRange.new(12, 24)\n    emitter.Lifetime = NumberRange.new(0.3, 0.6)\n    emitter.Color = ColorSequence.new(Color3.fromRGB(110, 255, 170))\n    emitter.Parent = pad\nend\n\nlocal bounceSound = pad:FindFirstChildOfClass(\"Sound\")\nif not bounceSound then\n    bounceSound = Instance.new(\"Sound\")\n    bounceSound.Name = \"BounceSound\"\n    bounceSound.SoundId = \"rbxassetid://12222200\"\n    bounceSound.Volume = 0.5\n    bounceSound.Parent = pad\nend\n\nlocal lastBounce = {}\n\npad.Touched:Connect(function(hit)\n    local character = hit.Parent\n    local player = character and Players:GetPlayerFromCharacter(character)\n    if not player then\n        return\n    end\n    local humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n    local root = character:FindFirstChild(\"HumanoidRootPart\")\n    if not humanoid or not root or humanoid.Health <= 0 then\n        return\n    end\n    local now = os.clock()\n    if lastBounce[player] and (now - lastBounce[player]) < COOLDOWN_SEC then\n        return\n    end\n    lastBounce[player] = now\n    local currentVel = root.AssemblyLinearVelocity\n    root.AssemblyLinearVelocity = Vector3.new(currentVel.X, BOOST_POWER, currentVel.Z)\n    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\n    emitter:Emit(16)\n    bounceSound:Play()\nend)\n\nPlayers.PlayerRemoving:Connect(function(player)\n    lastBounce[player] = nil\nend)\n";
    header + setup + pad_block + fx_and_logic
}
