// OpenRO game system: Deck Builder, Collection Index, Star Fusion & Rebirth Ascension.
// Parameters:
// - deck_slots (int): active deck capacity (3..=6)
// - fusion_cost (int): duplicate copies consumed per Star Fusion rank-up
// - rebirth_floor (int): minimum TowerFloor required to trigger Rebirth Ascension
// - store_name (string): DataStore name for persistent decks & collections
// - bind_close (bool): bind parallel game:BindToClose shutdown save

fn esc(s) {
    let out = "";
    for c in s.chars() {
        if c == '\\' {
            out = `${out}\\\\`;
        } else if c == '"' {
            out = `${out}\\\"`;
        } else if c == '\n' {
            out = `${out}\\n`;
        } else if c == '\r' {
            out = `${out}\\r`;
        } else {
            out = `${out}${c}`;
        }
    }
    out
}

pub fn generate_deck_builder(deck_slots, fusion_cost, rebirth_floor, store_name, bind_close) {
    let store_lit = esc(store_name);
    let header = "-- DeckBuilder -- generated by OpenRO (system: deck_builder)\n";
    let setup = `local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local DataStoreService = game:GetService("DataStoreService")

local DECK_SLOTS = ${deck_slots}
local FUSION_COST = ${fusion_cost}
local REBIRTH_FLOOR = ${rebirth_floor}
local STORE_NAME = "${store_lit}"
local store = DataStoreService:GetDataStore(STORE_NAME)

local deckEvent = ReplicatedStorage:FindFirstChild("OpenRODeckAction")
if not deckEvent then
    deckEvent = Instance.new("RemoteEvent")
    deckEvent.Name = "OpenRODeckAction"
    deckEvent.Parent = ReplicatedStorage
end

local cardGranted = ServerStorage:FindFirstChild("OpenROCardGranted")
if not cardGranted then
    cardGranted = Instance.new("BindableEvent")
    cardGranted.Name = "OpenROCardGranted"
    cardGranted.Parent = ServerStorage
end

local deckQuery = ServerStorage:FindFirstChild("OpenRODeckSnapshot")
if not deckQuery then
    deckQuery = Instance.new("BindableFunction")
    deckQuery.Name = "OpenRODeckSnapshot"
    deckQuery.Parent = ServerStorage
end

local profiles = {}
local lastAction = {}

local function withRetry(fn, attempts)
    local maxTries = attempts or 3
    for attempt = 1, maxTries do
        local ok, result = pcall(fn)
        if ok then
            return true, result
        end
        if attempt < maxTries then
            task.wait(2 ^ attempt)
        end
    end
    return false, nil
end

local function cardPower(card)
    local starMult = 1 + ((card.stars or 1) - 1) * 0.25
    local borderMult = card.border_mult or 1.0
    return math.floor(((card.atk or 100) * 1.4 + (card.hp or 500) * 0.35) * starMult * borderMult)
end

local function recomputeBonuses(player, profile)
    local uniqueCount = 0
    for _ in pairs(profile.index) do
        uniqueCount = uniqueCount + 1
    end
    local indexBonusPct = uniqueCount * 3
    local rebirthBonusPct = profile.rebirths * 20
    player:SetAttribute("CollectionUniqueCount", uniqueCount)
    player:SetAttribute("CollectionBonusPct", indexBonusPct)
    player:SetAttribute("Rebirths", profile.rebirths)
    player:SetAttribute("RebirthPowerPct", rebirthBonusPct)
    player:SetAttribute("EquippedDeckSize", #profile.deck)
end

local function syncClient(player)
    local profile = profiles[player]
    if not profile then
        return
    end
    recomputeBonuses(player, profile)
    deckEvent:FireClient(player, "sync", {
        deck = profile.deck,
        owned = profile.owned,
        rebirths = profile.rebirths,
        max_slots = DECK_SLOTS,
        fusion_cost = FUSION_COST,
        rebirth_floor = REBIRTH_FLOOR,
    })
end

local function autoEquipBest(profile)
    local sorted = {}
    for _, card in ipairs(profile.owned) do
        table.insert(sorted, card)
    end
    table.sort(sorted, function(a, b)
        return cardPower(a) > cardPower(b)
    end)
    profile.deck = {}
    local seen = {}
    for _, card in ipairs(sorted) do
        if #profile.deck >= DECK_SLOTS then
            break
        end
        if not seen[card.card_id] then
            seen[card.card_id] = true
            table.insert(profile.deck, card.card_id)
        end
    end
end

local function grantCard(player, cardData)
    local profile = profiles[player]
    if not profile or typeof(cardData) ~= "table" or typeof(cardData.card_id) ~= "string" then
        return
    end
    profile.index[cardData.card_id] = true
    local existing = nil
    for _, entry in ipairs(profile.owned) do
        if entry.card_id == cardData.card_id then
            existing = entry
            break
        end
    end
    if existing then
        existing.copies = (existing.copies or 1) + 1
        if (cardData.border_mult or 1.0) > (existing.border_mult or 1.0) then
            existing.border = cardData.border or existing.border
            existing.border_mult = cardData.border_mult
            existing.atk = cardData.atk or existing.atk
            existing.hp = cardData.hp or existing.hp
        end
    else
        table.insert(profile.owned, {
            card_id = cardData.card_id,
            title = cardData.title or cardData.card_id,
            rarity = cardData.rarity or "Common",
            element = cardData.element or "Flame",
            border = cardData.border or "Normal",
            border_mult = cardData.border_mult or 1.0,
            atk = cardData.atk or 120,
            hp = cardData.hp or 500,
            speed = cardData.speed or 75,
            stars = 1,
            copies = 1,
        })
        if #profile.deck < DECK_SLOTS then
            table.insert(profile.deck, cardData.card_id)
        end
    end
    syncClient(player)
end

cardGranted.Event:Connect(grantCard)

deckQuery.OnInvoke = function(player)
    local profile = profiles[player]
    if not profile then
        return { deck = {}, owned = {}, rebirths = 0 }
    end
    return profile
end

local function saveProfile(player)
    if player:GetAttribute("DeckDataLoaded") ~= true then
        return
    end
    local profile = profiles[player]
    if not profile then
        return
    end
    local key = "Deck_" .. player.UserId
    local snapshot = {
        deck = profile.deck,
        owned = profile.owned,
        index = profile.index,
        rebirths = profile.rebirths,
    }
    local ok, err = withRetry(function()
        return store:UpdateAsync(key, function(_old)
            return snapshot
        end)
    end, 3)
    if not ok then
        warn("DeckBuilder save failed for " .. player.Name .. ": " .. tostring(err))
    end
end

local function defaultProfile()
    return {
        deck = { "eclipse-arcane-alchemist" },
        owned = {
            {
                card_id = "eclipse-arcane-alchemist",
                title = "Eclipse Arcane Alchemist",
                rarity = "Rare",
                element = "Arcane",
                border = "Normal",
                border_mult = 1.0,
                atk = 230,
                hp = 960,
                speed = 80,
                stars = 1,
                copies = 1,
            },
        },
        index = { ["eclipse-arcane-alchemist"] = true },
        rebirths = 0,
    }
end

local function onPlayerAdded(player)
    local key = "Deck_" .. player.UserId
    local ok, saved = withRetry(function()
        return store:GetAsync(key)
    end, 3)
    if not ok then
        warn("DeckBuilder load failed for " .. player.Name)
        player:SetAttribute("DeckDataLoaded", false)
        profiles[player] = defaultProfile()
        syncClient(player)
        return
    end
    player:SetAttribute("DeckDataLoaded", true)
    if typeof(saved) == "table" and typeof(saved.owned) == "table" then
        profiles[player] = {
            deck = typeof(saved.deck) == "table" and saved.deck or {},
            owned = saved.owned,
            index = typeof(saved.index) == "table" and saved.index or {},
            rebirths = typeof(saved.rebirths) == "number" and math.max(0, math.floor(saved.rebirths)) or 0,
        }
    else
        profiles[player] = defaultProfile()
    end
    syncClient(player)
end

deckEvent.OnServerEvent:Connect(function(player, action, cardId)
    local now = os.clock()
    if lastAction[player] and (now - lastAction[player]) < 0.25 then
        return
    end
    lastAction[player] = now
    if typeof(action) ~= "string" then
        return
    end
    local profile = profiles[player]
    if not profile then
        return
    end
    if action == "sync" then
        syncClient(player)
        return
    elseif action == "auto_equip" then
        autoEquipBest(profile)
        syncClient(player)
        return
    elseif action == "rebirth" then
        local floor = player:GetAttribute("TowerFloor") or 1
        if typeof(floor) == "number" and floor >= REBIRTH_FLOOR then
            profile.rebirths = profile.rebirths + 1
            player:SetAttribute("TowerFloor", 1)
            syncClient(player)
        end
        return
    end
    if typeof(cardId) ~= "string" or #cardId == 0 or #cardId > 64 then
        return
    end
    local target = nil
    for _, entry in ipairs(profile.owned) do
        if entry.card_id == cardId then
            target = entry
            break
        end
    end
    if not target then
        return
    end
    if action == "equip" then
        for _, id in ipairs(profile.deck) do
            if id == cardId then
                return
            end
        end
        if #profile.deck < DECK_SLOTS then
            table.insert(profile.deck, cardId)
            syncClient(player)
        end
    elseif action == "unequip" then
        for idx, id in ipairs(profile.deck) do
            if id == cardId then
                table.remove(profile.deck, idx)
                syncClient(player)
                return
            end
        end
    elseif action == "fuse" then
        if (target.stars or 1) < 5 and (target.copies or 1) >= (FUSION_COST + 1) then
            target.copies = target.copies - FUSION_COST
            target.stars = (target.stars or 1) + 1
            target.atk = math.floor(target.atk * 1.25)
            target.hp = math.floor(target.hp * 1.25)
            syncClient(player)
        end
    end
end)

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(player)
    saveProfile(player)
    profiles[player] = nil
    lastAction[player] = nil
end)
for _, existing in ipairs(Players:GetPlayers()) do
    task.spawn(onPlayerAdded, existing)
end
`;
    let bind = if bind_close {
        "\ngame:BindToClose(function()\n    local active = Players:GetPlayers()\n    local remaining = #active\n    if remaining == 0 then\n        return\n    end\n    for _, player in ipairs(active) do\n        task.spawn(function()\n            saveProfile(player)\n            remaining = remaining - 1\n        end)\n    end\n    local deadline = os.clock() + 25\n    while remaining > 0 and os.clock() < deadline do\n        task.wait(0.1)\n    end\nend)\n"
    } else {
        ""
    };
    header + setup + bind
}
