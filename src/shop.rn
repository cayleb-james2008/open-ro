// OpenRO Rune skill: generate a Shop Luau script.
// Parameters: item_name (string) — what is sold; price (int) — its cost
// in the currency; currency (string) — the leaderstats stat it charges.
// The generated Script goes in ServerScriptService: it creates the
// OpenROShopBuy RemoteEvent in ReplicatedStorage and handles purchases
// server-side — checks the buyer's balance, deducts, and records the
// purchase as a BoolValue on the player. The game_gui skill's button
// fires this same RemoteEvent, so the two skills compose.
//
// Item and currency names are interpolated into Luau string literals,
// so they are escaped first — the same discipline as the leaderboard
// skill.

fn esc(s) {
    let out = "";
    for c in s.chars() {
        if c == '\\' {
            out = `${out}\\\\`;
        } else if c == '"' {
            out = `${out}\\\"`;
        } else if c == '\n' {
            out = `${out}\\n`;
        } else if c == '\r' {
            out = `${out}\\r`;
        } else {
            out = `${out}${c}`;
        }
    }
    out
}

pub fn generate_shop(item_name, price, currency) {
    let item = esc(item_name);
    let cur = esc(currency);
    let header = "-- Shop -- generated by OpenRO (Rune skill: shop)\n";
    let body = `local ReplicatedStorage = game:GetService("ReplicatedStorage")\nlocal Players = game:GetService("Players")\n\nlocal ITEM_NAME = "${item}"\nlocal PRICE = ${price}\nlocal CURRENCY = "${cur}"\n\nlocal event = Instance.new("RemoteEvent")\nevent.Name = "OpenROShopBuy"\nevent.Parent = ReplicatedStorage\n\nevent.OnServerEvent:Connect(function(player)\n    local stats = player:FindFirstChild("leaderstats")\n    local stat = stats and stats:FindFirstChild(CURRENCY)\n    if not stat then\n        return\n    end\n    if stat.Value < PRICE then\n        print(player.Name .. " cannot afford " .. ITEM_NAME)\n        return\n    end\n    stat.Value = stat.Value - PRICE\n    local owned = Instance.new("BoolValue")\n    owned.Name = ITEM_NAME .. "Owned"\n    owned.Value = true\n    owned.Parent = player\n    print(player.Name .. " bought " .. ITEM_NAME .. " for " .. PRICE .. " " .. CURRENCY)\nend)\n\nprint("Shop open: " .. ITEM_NAME .. " costs " .. PRICE .. " " .. CURRENCY)\n`;
    header + body
}
