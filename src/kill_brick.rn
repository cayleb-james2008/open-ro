// OpenRO Rune skill: generate a KillBrick Luau script.
// Parameter: damage (int) — health removed per touch. The generated
// Script is placed inside the part it guards (its parent) and damages
// any humanoid that touches that part, with a short debounce.
pub fn generate_kill_brick(damage) {
    let header = "-- KillBrick -- generated by OpenRO (Rune skill: kill_brick)\n";
    let body = `local part = script.Parent\nlocal DAMAGE = ${damage}\nlocal debounce = false\n\npart.Touched:Connect(function(hit)\n    local humanoid = hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")\n    if humanoid and not debounce then\n        debounce = true\n        humanoid:TakeDamage(DAMAGE)\n        task.wait(0.5)\n        debounce = false\n    end\nend)\n`;
    header + body
}
