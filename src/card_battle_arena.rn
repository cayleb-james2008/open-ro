// OpenRO game system: 4v4 Auto-Battle Clash Arena, 5 Story Bosses, Infinite Tower, World Raid Boss & PvP Duel.
// Parameters:
// - team_size (int): active battle cards per side (3..=6)
// - ultimate_charge_max (int): burst gauge threshold for Ultimate skills
// - counter_window_ms (int): active Counter/Interrupt guard duration
// - boss_hp_scale (int): raid boss durability multiplier

pub fn generate_card_battle_arena(team_size, ultimate_charge_max, counter_window_ms, boss_hp_scale) {
    let header = "-- CardBattleArena -- generated by OpenRO (system: card_battle_arena)\n";
    let body = `local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local TEAM_SIZE = ${team_size}
local ULTIMATE_MAX = ${ultimate_charge_max}
local COUNTER_WINDOW_SEC = ${counter_window_ms} / 1000
local BOSS_HP_SCALE = ${boss_hp_scale}

local battleEvent = ReplicatedStorage:FindFirstChild("OpenROBattleEvent")
if not battleEvent then
    battleEvent = Instance.new("RemoteEvent")
    battleEvent.Name = "OpenROBattleEvent"
    battleEvent.Parent = ReplicatedStorage
end

local towerClearSignal = ServerStorage:FindFirstChild("OpenROTowerClear")
if not towerClearSignal then
    towerClearSignal = Instance.new("BindableEvent")
    towerClearSignal.Name = "OpenROTowerClear"
    towerClearSignal.Parent = ServerStorage
end

local deckSnapshot = ServerStorage:FindFirstChild("OpenRODeckSnapshot")
if not deckSnapshot then
    deckSnapshot = Instance.new("BindableFunction")
    deckSnapshot.Name = "OpenRODeckSnapshot"
    deckSnapshot.Parent = ServerStorage
end

-- Elemental Advantage Wheel: Solar > Shadow > Storm > Arcane > Crimson > Solar
local ELEMENT_ADVANTAGE = {
    Solar   = "Shadow",
    Shadow  = "Storm",
    Storm   = "Arcane",
    Arcane  = "Crimson",
    Crimson = "Solar",
    Flame   = "Shadow",
    Void    = "Flame",
}

local SYNERGY_BONUSES = {
    Solar   = { atkMult = 1.22, critBonus = 0.08, shieldPct = 0.00, lifesteal = 0.00 },
    Crimson = { atkMult = 1.20, critBonus = 0.05, shieldPct = 0.00, lifesteal = 0.00 },
    Flame   = { atkMult = 1.20, critBonus = 0.05, shieldPct = 0.00, lifesteal = 0.00 },
    Void    = { atkMult = 1.15, critBonus = 0.08, shieldPct = 0.05, lifesteal = 0.00 },
    Storm   = { atkMult = 1.12, critBonus = 0.22, shieldPct = 0.00, lifesteal = 0.00 },
    Shadow  = { atkMult = 1.15, critBonus = 0.10, shieldPct = 0.00, lifesteal = 0.20 },
    Arcane  = { atkMult = 1.10, critBonus = 0.05, shieldPct = 0.22, lifesteal = 0.00 },
}

local STORY_BOSSES = {
    { id = 1, name = "Ember Dock Tyrant",           element = "Crimson", hp = 1200, atk = 140, reward = 220 },
    { id = 2, name = "Shibuya Curse Weaver",        element = "Shadow",  hp = 2200, atk = 210, reward = 420 },
    { id = 3, name = "Thunder Spire Shogun",        element = "Storm",   hp = 3600, atk = 290, reward = 680 },
    { id = 4, name = "Arcane Citadel Grandmaster",  element = "Arcane",  hp = 5400, atk = 380, reward = 1050 },
    { id = 5, name = "Impossible Overlord",         element = "Solar",   hp = 8200, atk = 490, reward = 1800 },
}

local BOSS_PHASES = {
    { threshold = 1.00, title = "Phase 1: Awakening",         atkMult = 1.00 },
    { threshold = 0.55, title = "Phase 2: Enraged Domain",    atkMult = 1.35 },
    { threshold = 0.25, title = "Phase 3: Apex Singularity",  atkMult = 1.75 },
}

local rng = Random.new()
local battles = {}
local lastAction = {}

local function awardCoins(player, amount)
    local stats = player:FindFirstChild("leaderstats")
    if not stats then
        return
    end
    local coins = stats:FindFirstChild("Coins") or stats:FindFirstChild("Gems")
    if coins and coins:IsA("IntValue") then
        coins.Value = coins.Value + amount
    end
end

local function buildPlayerTeam(player)
    local team = {}
    local profile = nil
    if deckSnapshot and deckSnapshot:IsA("BindableFunction") then
        local ok, res = pcall(function()
            return deckSnapshot:Invoke(player)
        end)
        if ok and typeof(res) == "table" then
            profile = res
        end
    end
    if profile and typeof(profile.owned) == "table" then
        local byId = {}
        for _, card in ipairs(profile.owned) do
            byId[card.card_id] = card
        end
        for _, id in ipairs(profile.deck or {}) do
            local c = byId[id]
            if c and #team < TEAM_SIZE then
                table.insert(team, {
                    card_id = c.card_id,
                    title = c.title or c.card_id,
                    element = c.element or "Solar",
                    skill = c.skill or "Burn AoE",
                    atk = c.atk or 220,
                    hp = c.hp or 950,
                    max_hp = c.hp or 950,
                    speed = c.speed or 82,
                    cd = 1,
                    shield = 0,
                    stunned = false,
                })
            end
        end
    end
    if #team == 0 then
        table.insert(team, {
            card_id = "crimson-sea-captain",
            title = "Crimson Sea Captain",
            element = "Crimson",
            skill = "Burn AoE",
            atk = 420,
            hp = 1480,
            max_hp = 1480,
            speed = 88,
            cd = 1,
            shield = 0,
            stunned = false,
        })
    end
    return team
end

local function computeSynergies(team)
    local counts = {}
    for _, unit in ipairs(team) do
        counts[unit.element] = (counts[unit.element] or 0) + 1
    end
    local active = {}
    local atkMult = 1.0
    local critBonus = 0.12
    local shieldPct = 0.0
    local lifesteal = 0.0
    for elem, count in pairs(counts) do
        if count >= 2 then
            local bonus = SYNERGY_BONUSES[elem]
            if bonus then
                table.insert(active, elem .. " x" .. count)
                atkMult = atkMult * bonus.atkMult
                critBonus = critBonus + bonus.critBonus
                shieldPct = shieldPct + bonus.shieldPct
                lifesteal = lifesteal + bonus.lifesteal
            end
        end
    end
    return {
        labels = active,
        atkMult = atkMult,
        critBonus = math.min(0.65, critBonus),
        shieldPct = shieldPct,
        lifesteal = lifesteal,
    }
end

local function bossPhaseFor(boss)
    local ratio = boss.hp / math.max(1, boss.max_hp)
    local chosen = BOSS_PHASES[1]
    for _, phase in ipairs(BOSS_PHASES) do
        if ratio <= phase.threshold then
            chosen = phase
        end
    end
    return chosen
end

local function startBattle(player, floorNum, modeArg)
    local modeName = if typeof(modeArg) == "string" then modeArg else "tower"
    local floor = math.clamp(math.floor(floorNum), 1, 200)
    local team = buildPlayerTeam(player)
    local syn = computeSynergies(team)
    for _, unit in ipairs(team) do
        unit.shield = math.floor(unit.max_hp * syn.shieldPct)
    end
    local elements = { "Solar", "Shadow", "Storm", "Arcane", "Crimson" }
    local bossElement = elements[((floor - 1) % #elements) + 1]
    local isRaidBoss = (modeName == "raid" or floor % 5 == 0)
    local bossTitle = if isRaidBoss then ("Impossible Overlord F" .. floor) else ("Tower Guardian F" .. floor)
    local bossHp = math.floor((900 + floor * 260) * (if isRaidBoss then BOSS_HP_SCALE else 1))
    local bossAtk = math.floor(140 + floor * 28)

    if modeName == "story" then
        local sb = STORY_BOSSES[math.clamp(floor, 1, #STORY_BOSSES)]
        bossTitle = sb.name
        bossElement = sb.element
        bossHp = sb.hp * math.max(1, math.floor(BOSS_HP_SCALE / 2))
        bossAtk = sb.atk
    elseif modeName == "pvp" then
        bossTitle = "PvP Duel Challenger"
        bossHp = math.floor(1600 + floor * 220)
        bossAtk = 260
    end

    local state = {
        mode = modeName,
        floor = floor,
        turn = 1,
        auto = (modeName ~= "tower"),
        ultGauge = 35,
        counterUntil = 0,
        synergy = syn,
        team = team,
        boss = {
            title = bossTitle,
            element = bossElement,
            hp = bossHp,
            max_hp = bossHp,
            atk = bossAtk,
            speed = 86 + (floor % 15),
            burnTurns = 0,
            stunned = false,
            phase = BOSS_PHASES[1].title,
        },
        finished = false,
    }
    battles[player] = state
    battleEvent:FireClient(player, "started", state)
end

local function stepTurn(player, mode)
    local state = battles[player]
    if not state or state.finished then
        return
    end
    local log = {}
    local syn = state.synergy
    local boss = state.boss
    local phase = bossPhaseFor(boss)
    boss.phase = phase.title

    local order = {}
    for _, unit in ipairs(state.team) do
        if unit.hp > 0 then
            table.insert(order, unit)
        end
    end
    table.sort(order, function(a, b)
        return a.speed > b.speed
    end)

    local useUltimate = (mode == "ultimate" and state.ultGauge >= ULTIMATE_MAX)
    if useUltimate then
        state.ultGauge = 0
        table.insert(log, "ULTIMATE BURST unleashed!")
    end

    for _, unit in ipairs(order) do
        if boss.hp <= 0 then
            break
        end
        unit.cd = unit.cd - 1
        local skillFire = (unit.cd <= 0)
        if skillFire then
            unit.cd = 3
        end
        local elemMult = if ELEMENT_ADVANTAGE[unit.element] == boss.element then 1.30 else 1.0
        local isCrit = rng:NextNumber() <= syn.critBonus
        local critMult = if isCrit then 1.65 else 1.0
        local ultMult = if useUltimate then 2.8 else (if skillFire then 1.55 else 1.0)
        local dmg = math.max(1, math.floor(unit.atk * syn.atkMult * elemMult * critMult * ultMult))
        boss.hp = math.max(0, boss.hp - dmg)
        state.ultGauge = math.min(ULTIMATE_MAX, state.ultGauge + 18)

        if syn.lifesteal > 0 or (skillFire and unit.skill == "Lifesteal") then
            local heal = math.floor(dmg * math.max(0.25, syn.lifesteal))
            unit.hp = math.min(unit.max_hp, unit.hp + heal)
        end
        if (useUltimate or skillFire) and (unit.skill == "Stun" or unit.skill == "Time Stop" or unit.element == "Void") then
            boss.stunned = true
        elseif (useUltimate or skillFire) and (unit.skill == "Burn AoE" or unit.element == "Crimson" or unit.element == "Solar") then
            boss.burnTurns = 2
        elseif skillFire and unit.skill == "Mirror Shield" then
            unit.shield = unit.shield + math.floor(unit.max_hp * 0.18)
        elseif skillFire and unit.skill == "Counter" then
            state.counterUntil = os.clock() + COUNTER_WINDOW_SEC
        end
        table.insert(log, unit.title .. " [" .. (if skillFire then unit.skill else "Strike") .. "] dealt " .. dmg .. (if isCrit then " CRIT" else ""))
    end

    if boss.hp > 0 and boss.burnTurns > 0 then
        local burnDmg = math.max(25, math.floor(boss.max_hp * 0.04))
        boss.hp = math.max(0, boss.hp - burnDmg)
        boss.burnTurns = boss.burnTurns - 1
        table.insert(log, "Burn seared boss for " .. burnDmg)
    end

    if boss.hp > 0 then
        if boss.stunned then
            boss.stunned = false
            table.insert(log, boss.title .. " was STUNNED and skipped turn!")
        else
            local living = {}
            for _, unit in ipairs(state.team) do
                if unit.hp > 0 then
                    table.insert(living, unit)
                end
            end
            if #living > 0 then
                local target = living[rng:NextInteger(1, #living)]
                local rawDmg = math.floor(boss.atk * phase.atkMult)
                local counterActive = os.clock() <= state.counterUntil
                if counterActive then
                    rawDmg = math.floor(rawDmg * 0.35)
                    local reflect = math.floor(boss.atk * 0.8)
                    boss.hp = math.max(0, boss.hp - reflect)
                    target.shield = target.shield + math.floor(target.max_hp * 0.12)
                    table.insert(log, "ACTIVE COUNTER deflected strike & reflected " .. reflect .. " DMG!")
                end
                local absorbed = math.min(target.shield, rawDmg)
                target.shield = target.shield - absorbed
                local rem = rawDmg - absorbed
                target.hp = math.max(0, target.hp - rem)
                state.ultGauge = math.min(ULTIMATE_MAX, state.ultGauge + 12)
                table.insert(log, boss.title .. " hit " .. target.title .. " for " .. rem .. " (" .. phase.title .. ")")
            end
        end
    end

    state.turn = state.turn + 1
    local anyAlive = false
    for _, unit in ipairs(state.team) do
        if unit.hp > 0 then
            anyAlive = true
            break
        end
    end

    if boss.hp <= 0 then
        state.finished = true
        local reward = 100 + state.floor * 35
        awardCoins(player, reward)
        if state.mode == "tower" then
            towerClearSignal:Fire(player, state.floor)
        end
        battleEvent:FireClient(player, "victory", { state = state, reward = reward, log = log })
    elseif not anyAlive then
        state.finished = true
        battleEvent:FireClient(player, "defeat", { state = state, log = log })
    else
        battleEvent:FireClient(player, "turn", { state = state, log = log })
    end
end

battleEvent.OnServerEvent:Connect(function(player, action, floorArg, modeArg)
    local now = os.clock()
    if lastAction[player] and (now - lastAction[player]) < 0.2 then
        return
    end
    lastAction[player] = now
    if typeof(action) ~= "string" then
        return
    end
    local safeMode = if typeof(modeArg) == "string" then modeArg else "tower"
    if action == "start_raid" then
        local floorNum = 1
        if typeof(floorArg) == "number" and floorArg == floorArg then
            floorNum = floorArg
        end
        startBattle(player, floorNum, safeMode)
    elseif action == "attack" or action == "ultimate" then
        stepTurn(player, action)
    elseif action == "chain_overdrive" then
        local state = battles[player]
        if state and not state.finished then
            local lead = state.playerTeam[1]
            local ally = state.playerTeam[2] or lead
            local target = state.enemies[1]
            if lead and target and target.hp > 0 then
                local dmg = math.max(40, math.floor((lead.atk + ally.atk * 0.65) * 1.35))
                target.hp = math.max(0, target.hp - dmg)
                battleEvent:FireClient(player, "chain_overdrive", {
                    pair = lead.title .. " x " .. ally.title,
                    bonusPct = 35,
                    damage = dmg,
                    targetHp = target.hp,
                })
            end
        end
    elseif action == "counter" then
        local state = battles[player]
        if state and not state.finished then
            state.counterUntil = os.clock() + COUNTER_WINDOW_SEC
            battleEvent:FireClient(player, "counter_ready", { window_sec = COUNTER_WINDOW_SEC })
        end
    elseif action == "toggle_auto" then
        local state = battles[player]
        if state and not state.finished then
            state.auto = not state.auto
            battleEvent:FireClient(player, "auto_state", { auto = state.auto })
        end
    elseif action == "retreat" then
        battles[player] = nil
        battleEvent:FireClient(player, "retreated", {})
    end
end)

Players.PlayerAdded:Connect(function(player)
    task.spawn(function()
        while player.Parent do
            task.wait(0.85)
            local st = battles[player]
            if st and st.auto and not st.finished then
                local mode = if st.ultGauge >= ULTIMATE_MAX then "ultimate" else "attack"
                stepTurn(player, mode)
            end
        end
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    battles[player] = nil
    lastAction[player] = nil
end)
`;
    header + body
}
