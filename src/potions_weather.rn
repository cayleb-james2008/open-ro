// OpenRO game system: Dynamic Server Weather, Craftable Luck/Speed Potions & Redeemable Codes.
// Parameters:
// - weather_cycle_seconds (int): duration of each server weather event
// - luck_potion_cost (int): coin cost to brew a 2.0x Luck Potion
// - speed_potion_cost (int): coin cost to brew a 1.75x Fast-Roll Speed Potion
// - enable_codes (bool): allow players to redeem REBIRTH / APEX2026 / LUCKBOOST

pub fn generate_potions_weather(weather_cycle_seconds, luck_potion_cost, speed_potion_cost, enable_codes) {
    let codes_lit = if enable_codes { "true" } else { "false" };
    let header = "-- PotionsWeather -- generated by OpenRO (system: potions_weather)\n";
    let body = `local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local CYCLE_SECONDS = ${weather_cycle_seconds}
local LUCK_POTION_COST = ${luck_potion_cost}
local SPEED_POTION_COST = ${speed_potion_cost}
local ENABLE_CODES = ${codes_lit}

local potionEvent = ReplicatedStorage:FindFirstChild("OpenROPotionEvent")
if not potionEvent then
    potionEvent = Instance.new("RemoteEvent")
    potionEvent.Name = "OpenROPotionEvent"
    potionEvent.Parent = ReplicatedStorage
end

local weatherNameVal = ReplicatedStorage:FindFirstChild("ActiveWeather")
if not weatherNameVal then
    weatherNameVal = Instance.new("StringValue")
    weatherNameVal.Name = "ActiveWeather"
    weatherNameVal.Value = "Solar Flare"
    weatherNameVal.Parent = ReplicatedStorage
end

local weatherLuckVal = ReplicatedStorage:FindFirstChild("ActiveWeatherLuck")
if not weatherLuckVal then
    weatherLuckVal = Instance.new("NumberValue")
    weatherLuckVal.Name = "ActiveWeatherLuck"
    weatherLuckVal.Value = 1.5
    weatherLuckVal.Parent = ReplicatedStorage
end

local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
if not atmosphere then
    atmosphere = Instance.new("Atmosphere")
    atmosphere.Name = "ApexWeatherAtmosphere"
    atmosphere.Parent = Lighting
end

local WEATHERS = {
    { name = "Solar Flare", luck = 1.5, clock = 14.5, brightness = 2.6, density = 0.24, haze = 0.9, element = "Flame" },
    { name = "Void Eclipse", luck = 2.0, clock = 20.5, brightness = 1.1, density = 0.44, haze = 2.1, element = "Void" },
    { name = "Thunderstorm", luck = 1.6, clock = 16.0, brightness = 1.2, density = 0.50, haze = 2.5, element = "Storm" },
    { name = "Blood Moon", luck = 2.25, clock = 22.0, brightness = 1.0, density = 0.48, haze = 2.8, element = "Shadow" },
}

local CODES = {
    REBIRTH = { coins = 500, luckSec = 180, speedSec = 0 },
    APEX2026 = { coins = 1000, luckSec = 240, speedSec = 180 },
    LUCKBOOST = { coins = 250, luckSec = 300, speedSec = 0 },
}

local redeemedCodes = {}
local lastRequest = {}

local function grantCurrency(player, amount)
    local stats = player:FindFirstChild("leaderstats")
    local coins = stats and stats:FindFirstChild("Coins")
    if coins and coins:IsA("IntValue") then
        coins.Value = coins.Value + amount
    end
end

local function activateBuff(player, attrName, mult, durationSec)
    player:SetAttribute(attrName, mult)
    task.delay(durationSec, function()
        if player.Parent then
            player:SetAttribute(attrName, 1.0)
        end
    end)
end

potionEvent.OnServerEvent:Connect(function(player, action, payload)
    local now = os.clock()
    if lastRequest[player] and (now - lastRequest[player]) < 0.35 then
        return
    end
    lastRequest[player] = now
    if typeof(action) ~= "string" then
        return
    end
    if action == "craft_luck" then
        local stats = player:FindFirstChild("leaderstats")
        local coins = stats and stats:FindFirstChild("Coins")
        if not coins or coins.Value < LUCK_POTION_COST then
            potionEvent:FireClient(player, "insufficient_coins", { needed = LUCK_POTION_COST })
            return
        end
        coins.Value = coins.Value - LUCK_POTION_COST
        activateBuff(player, "PotionLuckMult", 2.0, 180)
        potionEvent:FireClient(player, "potion_active", { kind = "Luck", mult = 2.0, seconds = 180 })
    elseif action == "craft_speed" then
        local stats = player:FindFirstChild("leaderstats")
        local coins = stats and stats:FindFirstChild("Coins")
        if not coins or coins.Value < SPEED_POTION_COST then
            potionEvent:FireClient(player, "insufficient_coins", { needed = SPEED_POTION_COST })
            return
        end
        coins.Value = coins.Value - SPEED_POTION_COST
        activateBuff(player, "PotionSpeedMult", 1.75, 180)
        potionEvent:FireClient(player, "potion_active", { kind = "Speed", mult = 1.75, seconds = 180 })
    elseif action == "redeem_code" and ENABLE_CODES then
        if typeof(payload) ~= "string" or #payload == 0 or #payload > 32 then
            return
        end
        local key = string.upper(payload)
        local reward = CODES[key]
        if not reward then
            potionEvent:FireClient(player, "code_invalid", { code = key })
            return
        end
        local seen = redeemedCodes[player]
        if not seen then
            seen = {}
            redeemedCodes[player] = seen
        end
        if seen[key] then
            potionEvent:FireClient(player, "code_used", { code = key })
            return
        end
        seen[key] = true
        if reward.coins > 0 then
            grantCurrency(player, reward.coins)
        end
        if reward.luckSec > 0 then
            activateBuff(player, "PotionLuckMult", 2.0, reward.luckSec)
        end
        if reward.speedSec > 0 then
            activateBuff(player, "PotionSpeedMult", 1.75, reward.speedSec)
        end
        potionEvent:FireClient(player, "code_redeemed", { code = key, coins = reward.coins })
    end
end)

Players.PlayerAdded:Connect(function(player)
    player:SetAttribute("PotionLuckMult", 1.0)
    player:SetAttribute("PotionSpeedMult", 1.0)
end)

Players.PlayerRemoving:Connect(function(player)
    redeemedCodes[player] = nil
    lastRequest[player] = nil
end)

task.spawn(function()
    local idx = 1
    while true do
        local preset = WEATHERS[idx]
        weatherNameVal.Value = preset.name
        weatherLuckVal.Value = preset.luck
        local info = TweenInfo.new(5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
        TweenService:Create(Lighting, info, { ClockTime = preset.clock, Brightness = preset.brightness }):Play()
        TweenService:Create(atmosphere, info, { Density = preset.density, Haze = preset.haze }):Play()
        potionEvent:FireAllClients("weather_changed", {
            name = preset.name,
            luck = preset.luck,
            element = preset.element,
        })
        task.wait(CYCLE_SECONDS)
        idx = (idx % #WEATHERS) + 1
    end
end)
`;
    header + body
}
