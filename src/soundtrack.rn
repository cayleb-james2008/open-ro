// OpenRO Rune skill: generate a Soundtrack Luau script.
// Parameters: sound_id (int) — the audio asset id (0 = no track chosen
// yet, the Sound is created but silent); volume (int, tenths 0–10) —
// playback volume; looped (bool) — loop the track. The generated
// Script goes in ServerScriptService and plays the track from
// SoundService so every player hears it.
pub fn generate_soundtrack(sound_id, volume, looped) {
    let header = "-- Soundtrack -- generated by OpenRO (Rune skill: soundtrack)\n";
    let looped_lit = if looped { "true" } else { "false" };
    let body = `local SoundService = game:GetService("SoundService")\n\nlocal sound = Instance.new("Sound")\nsound.Name = "Soundtrack"\nsound.SoundId = "rbxassetid://${sound_id}"\nsound.Volume = ${volume} / 10\nsound.Looped = ${looped_lit}\nsound.Parent = SoundService\nsound:Play()\n`;
    header + body
}
