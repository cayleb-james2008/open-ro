	id: string,
	worldId: number,
	act: number,
	isBoss: boolean,
	name: string,
	recommendedPower: number,
	yenReward: number,
	gemReward: number,
	xpReward: number,
	bossTokenReward: number,
	firstClearGems: number,
	firstClearTickets: number,
	dropCardId: string?,
