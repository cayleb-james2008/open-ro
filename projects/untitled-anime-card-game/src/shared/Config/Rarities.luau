function Rarities.get(id: string): RarityDef
	return Rarities.ById[id :: RarityId] or Rarities.ById.Common
end

function Rarities.isAtLeast(rarityId: string, thresholdId: string): boolean
	local a = Rarities.get(rarityId)
	local b = Rarities.get(thresholdId)
	return a.order >= b.order
end

return Rarities
