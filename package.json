{
  "name": "open-ro",
  "productName": "Open-Ro Studio",
  "version": "0.1.0",
  "description": "Local-first AI development studio for Roblox — bring your own model.",
  "license": "MIT",
  "author": {
    "name": "Open-Ro contributors",
    "email": "cayleb-james2008@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cayleb-james2008/open-ro.git"
  },
  "main": "dist-electron/main.js",
  "private": false,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -ks i \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "dev:renderer": "vite",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.renderer.json",
    "lint": "node scripts/check-source.mjs && node scripts/check-drift.mjs && node scripts/build-tokens.mjs --check",
    "check:drift": "node scripts/check-drift.mjs",
    "verify:ui": "node scripts/verify-ui-craft.mjs",
    "test": "vitest run",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "dev:electron": "electron .",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage deb pacman --publish never",
    "package:linux-omarchy": "npm run build && electron-builder --linux pacman AppImage --publish never",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "clsx": "^2.1.1",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "studio.openro.app",
    "productName": "Open-Ro Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "category": "Development",
      "artifactName": "open-ro-${version}-${arch}.${ext}"
    }
  }
}
