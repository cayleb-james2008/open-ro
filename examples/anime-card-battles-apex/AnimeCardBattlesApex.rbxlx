    local btn = makeButton(row, "BuyBtn", "Upgrade", UDim2.new(0.28, 0, 0.7, 0), UDim2.new(0.70, 0, 0.15, 0), PAL.accent)
    btn.MouseButton1Click:Connect(function()
        playSfx("ui_click")
        coreAction:FireServer("buy_upgrade", upg.id)
    end)
