  <Item class="ServerScriptService" referent="RBX00000175">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX00000176">
      <Properties>
        <string name="Name">DataPersistence</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[-- DataPersistence.server.luau (ServerScriptService.DataPersistence)
-- Retry-hardened DataStore persistence + OrderedDataStore leaderboards + Studio offline fallback.

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")

local PROFILE_STORE_NAME = "ApexAnimeCards_Profiles_v2"
local TOWER_BOARD_NAME = "ApexAnimeCards_Tower_v2"
local POWER_BOARD_NAME = "ApexAnimeCards_Power_v2"

local profileStore = nil
local towerBoard = nil
local powerBoard = nil
local datastoreAvailable = true

local okStore, errStore = pcall(function()
    profileStore = DataStoreService:GetDataStore(PROFILE_STORE_NAME)
    towerBoard = DataStoreService:GetOrderedDataStore(TOWER_BOARD_NAME)
    powerBoard = DataStoreService:GetOrderedDataStore(POWER_BOARD_NAME)
end)

if not okStore or not profileStore then
    datastoreAvailable = false
    if RunService:IsStudio() then
        warn("[DataPersistence] Studio API Services disabled; running session memory fallback: " .. tostring(errStore))
    end
end

local storageBridge = ServerStorage:FindFirstChild("ApexStorageBridge")
if not storageBridge then
    storageBridge = Instance.new("BindableFunction")
    storageBridge.Name = "ApexStorageBridge"
    storageBridge.Parent = ServerStorage
end

local sessionFallback = {}
local liveSnapshots = {}

local function withRetry(fn, attempts)
    local maxTries = attempts or 3
    for attempt = 1, maxTries do
        local ok, result = pcall(fn)
        if ok then
            return true, result
        end
        local msg = tostring(result)
        if string.find(msg, "502") or string.find(msg, "API Services") or string.find(msg, "Studio") then
            datastoreAvailable = false
            return false, msg
        end
        if attempt < maxTries then
            task.wait(2 ^ attempt)
        end
    end
    return false, "max retries exceeded"
end

local function loadProfile(userId: number)
    local key = "Player_" .. tostring(userId)
    if not datastoreAvailable or not profileStore then
        return true, sessionFallback[key]
    end
    local ok, data = withRetry(function()
        return profileStore:GetAsync(key)
    end, 3)
    if not ok then
        if not datastoreAvailable then
            return true, sessionFallback[key]
        end
        return false, nil
    end
    return true, data
end

local function saveProfile(userId: number, payload)
    if typeof(payload) ~= "table" then
        return false
    end
    local key = "Player_" .. tostring(userId)
    sessionFallback[key] = payload
    liveSnapshots[userId] = payload

    if not datastoreAvailable or not profileStore then
        return true
    end
    local ok, err = withRetry(function()
        return profileStore:UpdateAsync(key, function(_old)
            return payload
        end)
    end, 3)
    if not ok and datastoreAvailable then
        warn("[DataPersistence] UpdateAsync failed for " .. key .. ": " .. tostring(err))
        return false
    end
    return true
end

local function submitBoards(userId: number, towerFloor: number, teamPower: number)
    local key = "Player_" .. tostring(userId)
    if not datastoreAvailable then
        return
    end
    if towerBoard and towerFloor >= 1 then
        pcall(function()
            towerBoard:SetAsync(key, math.floor(towerFloor))
        end)
    end
    if powerBoard and teamPower >= 1 then
        pcall(function()
            powerBoard:SetAsync(key, math.floor(teamPower))
        end)
    end
end

local function fetchTopLeaderboard()
    local rows = {}
    if datastoreAvailable and towerBoard then
        local ok, pages = pcall(function()
            return towerBoard:GetSortedAsync(false, 8)
        end)
        if ok and pages then
            for rank, entry in ipairs(pages:GetCurrentPage()) do
                table.insert(rows, {
                    rank = rank,
                    key = entry.key,
                    floor = entry.value,
                })
            end
        end
    end
    if #rows == 0 then
        for _, p in ipairs(Players:GetPlayers()) do
            table.insert(rows, {
                rank = #rows + 1,
                key = p.Name,
                floor = p:GetAttribute("TowerFloor") or 1,
            })
        end
        table.sort(rows, function(a, b)
            return a.floor > b.floor
        end)
    end
    return rows
end

storageBridge.OnInvoke = function(op, arg1, arg2, arg3)
    if op == "load" and typeof(arg1) == "number" then
        local ok, data = loadProfile(arg1)
        return { ok = ok, data = data }
    elseif op == "save" and typeof(arg1) == "number" then
        return saveProfile(arg1, arg2)
    elseif op == "stage" and typeof(arg1) == "number" and typeof(arg2) == "table" then
        liveSnapshots[arg1] = arg2
        return true
    elseif op == "boards" and typeof(arg1) == "number" then
        submitBoards(arg1, tonumber(arg2) or 1, tonumber(arg3) or 0)
        return true
    elseif op == "top_tower" then
        return fetchTopLeaderboard()
    end
    return nil
end

Players.PlayerRemoving:Connect(function(player)
    local snap = liveSnapshots[player.UserId]
    if snap and player:GetAttribute("DataLoaded") == true then
        saveProfile(player.UserId, snap)
        local floor = player:GetAttribute("TowerFloor") or 1
        local power = player:GetAttribute("TeamPower") or 0
        submitBoards(player.UserId, floor, power)
    end
    liveSnapshots[player.UserId] = nil
end)

game:BindToClose(function()
    local active = Players:GetPlayers()
    local remaining = #active
    if remaining == 0 then
        return
    end
    for _, player in ipairs(active) do
        task.spawn(function()
            local snap = liveSnapshots[player.UserId]
            if snap and player:GetAttribute("DataLoaded") == true then
                saveProfile(player.UserId, snap)
                local floor = player:GetAttribute("TowerFloor") or 1
                local power = player:GetAttribute("TeamPower") or 0
                submitBoards(player.UserId, floor, power)
            end
            remaining = remaining - 1
        end)
    end
    local deadline = os.clock() + 20
    while remaining > 0 and os.clock() < deadline do
        task.wait(0.1)
    end
end)
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX00000177">
      <Properties>
        <string name="Name">WeatherRaidService</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[-- WeatherRaidService.server.luau (ServerScriptService.WeatherRaidService)
-- Cycles 7 Weather Biomes (Clear, Rain, Snow, Sandstorm, Blood Moon, Eclipse 2x Luck, Starfall)
-- with Lighting/Atmosphere/ColorCorrection tweens and manages the Timed World Raid Boss countdown.

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local CardDatabase = require(Modules:WaitForChild("CardDatabase"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local weatherRaidEvent = Remotes:FindFirstChild("WeatherRaidEvent")
if not weatherRaidEvent then
    weatherRaidEvent = Instance.new("RemoteEvent")
    weatherRaidEvent.Name = "WeatherRaidEvent"
    weatherRaidEvent.Parent = Remotes
end

local StateFolder = ReplicatedStorage:WaitForChild("State")

local function ensureValue(className: string, name: string, defaultVal)
    local v = StateFolder:FindFirstChild(name)
    if not v then
        v = Instance.new(className)
        v.Name = name
        v.Value = defaultVal
        v.Parent = StateFolder
    end
    return v
end

local activeWeatherVal = ensureValue("StringValue", "ActiveWeather", "Clear")
local activeLuckVal = ensureValue("NumberValue", "ActiveWeatherLuck", 1.0)
local weatherTimeLeftVal = ensureValue("IntValue", "WeatherTimeLeft", 90)
local exclusiveCardVal = ensureValue("StringValue", "WeatherExclusiveCard", "")

local raidActiveVal = ensureValue("BoolValue", "RaidBossActive", false)
local raidNameVal = ensureValue("StringValue", "RaidBossName", CardDatabase.WORLD_RAID_BOSS.name)
local raidHpVal = ensureValue("IntValue", "RaidBossHP", CardDatabase.WORLD_RAID_BOSS.baseHp)
local raidMaxHpVal = ensureValue("IntValue", "RaidBossMaxHP", CardDatabase.WORLD_RAID_BOSS.baseHp)
local raidCountdownVal = ensureValue("IntValue", "RaidCountdown", 45)

local atmosphere = Lighting:FindFirstChild("ApexAtmosphere") or Lighting:FindFirstChildOfClass("Atmosphere")
if not atmosphere then
    atmosphere = Instance.new("Atmosphere")
    atmosphere.Name = "ApexAtmosphere"
    atmosphere.Parent = Lighting
end

local colorCorrection = Lighting:FindFirstChild("ApexColorCorrection") or Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
if not colorCorrection then
    colorCorrection = Instance.new("ColorCorrectionEffect")
    colorCorrection.Name = "ApexColorCorrection"
    colorCorrection.Parent = Lighting
end

-- Overhead weather sky emitter anchor high above courtyard
local skyAnchor = workspace:FindFirstChild("WeatherSkyAnchor")
if not skyAnchor then
    skyAnchor = Instance.new("Part")
    skyAnchor.Name = "WeatherSkyAnchor"
    skyAnchor.Anchored = true
    skyAnchor.CanCollide = false
    skyAnchor.Transparency = 1
    skyAnchor.Size = Vector3.new(120, 1, 120)
    skyAnchor.Position = Vector3.new(0, 52, 0)
    skyAnchor.Parent = workspace
end

local skyEmitter = skyAnchor:FindFirstChild("WeatherParticleEmitter")
if not skyEmitter then
    skyEmitter = Instance.new("ParticleEmitter")
    skyEmitter.Name = "WeatherParticleEmitter"
    skyEmitter.Enabled = false
    skyEmitter.Rate = 45
    skyEmitter.Speed = NumberRange.new(18, 28)
    skyEmitter.Lifetime = NumberRange.new(2.2, 3.4)
    skyEmitter.EmissionDirection = Enum.NormalId.Bottom
    skyEmitter.Size = NumberSequence.new(0.45)
    skyEmitter.Parent = skyAnchor
end

local weatherShiftBindable = ServerStorage:FindFirstChild("ApexShiftWeather")
if not weatherShiftBindable then
    weatherShiftBindable = Instance.new("BindableFunction")
    weatherShiftBindable.Name = "ApexShiftWeather"
    weatherShiftBindable.Parent = ServerStorage
end

local raidDamageBindable = ServerStorage:FindFirstChild("ApexRaidDamage")
if not raidDamageBindable then
    raidDamageBindable = Instance.new("BindableFunction")
    raidDamageBindable.Name = "ApexRaidDamage"
    raidDamageBindable.Parent = ServerStorage
end

local rewardSignal = ServerStorage:FindFirstChild("ApexRewardSignal")
if not rewardSignal then
    rewardSignal = Instance.new("BindableEvent")
    rewardSignal.Name = "ApexRewardSignal"
    rewardSignal.Parent = ServerStorage
end

local currentWeatherIdx = 1
local WEATHER_DURATION = 90
local weatherTimer = WEATHER_DURATION

local raidParticipants = {}

local function applyWeather(idx: number)
    currentWeatherIdx = ((idx - 1) % #CardDatabase.WEATHERS) + 1
    local preset = CardDatabase.WEATHERS[currentWeatherIdx]
    activeWeatherVal.Value = preset.id
    activeLuckVal.Value = preset.luckMult
    exclusiveCardVal.Value = preset.exclusiveCard or ""
    weatherTimer = WEATHER_DURATION
    weatherTimeLeftVal.Value = weatherTimer

    local info = TweenInfo.new(3.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    TweenService:Create(Lighting, info, {
        ClockTime = preset.clockTime,
        Brightness = preset.brightness,
        OutdoorAmbient = preset.ambient,
    }):Play()
    TweenService:Create(atmosphere, info, {
        Density = preset.density,
        Haze = preset.haze,
    }):Play()
    TweenService:Create(colorCorrection, info, {
        TintColor = preset.tint,
    }):Play()

    if preset.id == "Rain" or preset.id == "Snow" or preset.id == "Sandstorm" or preset.id == "Starfall" then
        skyEmitter.Enabled = true
        if preset.id == "Rain" then
            skyEmitter.Color = ColorSequence.new(Color3.fromRGB(120, 195, 255))
            skyEmitter.Speed = NumberRange.new(35, 48)
            skyEmitter.Rate = 85
        elseif preset.id == "Snow" then
            skyEmitter.Color = ColorSequence.new(Color3.fromRGB(240, 250, 255))
            skyEmitter.Speed = NumberRange.new(7, 13)
            skyEmitter.Rate = 65
        elseif preset.id == "Sandstorm" then
            skyEmitter.Color = ColorSequence.new(Color3.fromRGB(235, 185, 110))
            skyEmitter.Speed = NumberRange.new(20, 32)
            skyEmitter.Rate = 75
        else
            skyEmitter.Color = ColorSequence.new(Color3.fromRGB(255, 224, 110))
            skyEmitter.Speed = NumberRange.new(16, 26)
            skyEmitter.Rate = 55
        end
    else
        skyEmitter.Enabled = false
    end

    weatherRaidEvent:FireAllClients("weather_changed", {
        id = preset.id,
        luckMult = preset.luckMult,
        boostElement = preset.boostElement,
        exclusiveCard = preset.exclusiveCard,
        banner = preset.banner,
        timeLeft = weatherTimer,
    })
end

local function startWorldRaid()
    raidParticipants = {}
    local playerCount = math.max(1, #Players:GetPlayers())
    local maxHp = CardDatabase.WORLD_RAID_BOSS.baseHp * playerCount
    raidMaxHpVal.Value = maxHp
    raidHpVal.Value = maxHp
    raidNameVal.Value = CardDatabase.WORLD_RAID_BOSS.name
    raidActiveVal.Value = true
    raidCountdownVal.Value = CardDatabase.WORLD_RAID_BOSS.durationSec
    weatherRaidEvent:FireAllClients("raid_started", {
        name = raidNameVal.Value,
        hp = maxHp,
        maxHp = maxHp,
        duration = CardDatabase.WORLD_RAID_BOSS.durationSec,
    })
end

local function finishWorldRaid(defeated: boolean)
    raidActiveVal.Value = false
    raidCountdownVal.Value = CardDatabase.WORLD_RAID_BOSS.cooldownSec

    for player, dmg in pairs(raidParticipants) do
        if player.Parent and dmg > 0 then
            local baseShards = if defeated then 45 else 15
            local bonusShards = math.min(180, math.floor(dmg / 250))
            local coins = math.min(2500, 150 + math.floor(dmg / 15))
            rewardSignal:Fire(player, {
                coins = coins,
                shards = baseShards + bonusShards,
                xp = 140,
                reason = if defeated then "World Raid Boss Defeated!" else "World Raid Participation",
            })
        end
    end
    raidParticipants = {}

    weatherRaidEvent:FireAllClients("raid_ended", {
        defeated = defeated,
        nextRaidSec = CardDatabase.WORLD_RAID_BOSS.cooldownSec,
    })
end

weatherShiftBindable.OnInvoke = function(_player, requestedId)
    local nextIdx = (currentWeatherIdx % #CardDatabase.WEATHERS) + 1
    if typeof(requestedId) == "string" then
        for i, w in ipairs(CardDatabase.WEATHERS) do
            if w.id == requestedId then
                nextIdx = i
                break
            end
        end
    end
    applyWeather(nextIdx)
    return CardDatabase.WEATHERS[currentWeatherIdx].id
end

raidDamageBindable.OnInvoke = function(player, dmgAmount)
    if typeof(player) ~= "Instance" or not player:IsA("Player") then
        return { active = raidActiveVal.Value, hp = raidHpVal.Value }
    end
    local dmg = math.max(0, math.floor(tonumber(dmgAmount) or 0))
    if not raidActiveVal.Value then
        return { active = false, hp = 0, maxHp = raidMaxHpVal.Value }
    end
    raidParticipants[player] = (raidParticipants[player] or 0) + dmg
    local newHp = math.max(0, raidHpVal.Value - dmg)
    raidHpVal.Value = newHp
    weatherRaidEvent:FireAllClients("raid_hp", {
        hp = newHp,
        maxHp = raidMaxHpVal.Value,
        lastHitter = player.Name,
        damage = dmg,
    })
    if newHp <= 0 then
        finishWorldRaid(true)
    end
    return { active = raidActiveVal.Value, hp = newHp, maxHp = raidMaxHpVal.Value }
end

weatherRaidEvent.OnServerEvent:Connect(function(player, action)
    if typeof(action) ~= "string" then
        return
    end
    if action == "sync" then
        local preset = CardDatabase.WEATHERS[currentWeatherIdx]
        weatherRaidEvent:FireClient(player, "sync", {
            weather = {
                id = preset.id,
                luckMult = preset.luckMult,
                boostElement = preset.boostElement,
                exclusiveCard = preset.exclusiveCard,
                banner = preset.banner,
                timeLeft = weatherTimer,
            },
            raid = {
                active = raidActiveVal.Value,
                name = raidNameVal.Value,
                hp = raidHpVal.Value,
                maxHp = raidMaxHpVal.Value,
                countdown = raidCountdownVal.Value,
            },
        })
    elseif action == "trigger_raid_horn" then
        if not raidActiveVal.Value and raidCountdownVal.Value <= 30 then
            startWorldRaid()
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    raidParticipants[player] = nil
end)

applyWeather(1)

task.spawn(function()
    while true do
        task.wait(1)
        weatherTimer = weatherTimer - 1
        if weatherTimer <= 0 then
            applyWeather(currentWeatherIdx + 1)
        else
            weatherTimeLeftVal.Value = weatherTimer
        end

        local cd = raidCountdownVal.Value - 1
        if cd <= 0 then
            if raidActiveVal.Value then
                finishWorldRaid(false)
            else
                startWorldRaid()
            end
        else
            raidCountdownVal.Value = cd
        end
    end
end)
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX00000178">
      <Properties>
        <string name="Name">GameCore</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[-- GameCore.server.luau (ServerScriptService.GameCore)
-- Server-authoritative core loop: Gacha Rolling, Packs, Pity, XP/Upgrades,
-- Potions, Traits, Charms, Locking, Auto-Delete, 4-Slot Deck, Codes,
-- Overhead 3D Showcase Card, and Workspace Landmark Prompts.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local CardDatabase = require(Modules:WaitForChild("CardDatabase"))
local CombatMath = require(Modules:WaitForChild("CombatMath"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local StateFolder = ReplicatedStorage:WaitForChild("State")

local function ensureRemote(className: string, name: string)
    local r = Remotes:FindFirstChild(name)
    if not r then
        r = Instance.new(className)
        r.Name = name
        r.Parent = Remotes
    end
    return r
end

local rollFunction = ensureRemote("RemoteFunction", "RollRequest")
local rollNotice = ensureRemote("RemoteEvent", "RollNotice")
local coreAction = ensureRemote("RemoteEvent", "CoreAction")
local stateSync = ensureRemote("RemoteEvent", "StateSync")
local openPanelEvent = ensureRemote("RemoteEvent", "OpenPanelEvent")

local storageBridge = ServerStorage:WaitForChild("ApexStorageBridge")

local profileQuery = ServerStorage:FindFirstChild("ApexProfileQuery")
if not profileQuery then
    profileQuery = Instance.new("BindableFunction")
    profileQuery.Name = "ApexProfileQuery"
    profileQuery.Parent = ServerStorage
end

local rewardSignal = ServerStorage:FindFirstChild("ApexRewardSignal")
if not rewardSignal then
    rewardSignal = Instance.new("BindableEvent")
    rewardSignal.Name = "ApexRewardSignal"
    rewardSignal.Parent = ServerStorage
end

local shiftWeather = ServerStorage:WaitForChild("ApexShiftWeather")

local rng = Random.new()
local profiles = {}
local rateBuckets = {}
local overheadCards = {}

local PITY_THRESHOLD = 50
local BASE_INVENTORY_CAP = 32
local DEFAULT_FAST_COOLDOWN = 0.35

local function consumeToken(player: Player, cost: number): boolean
    local now = os.clock()
    local b = rateBuckets[player]
    if not b then
        b = { tokens = 12, updated = now }
        rateBuckets[player] = b
    end
    b.tokens = math.min(12, b.tokens + (now - b.updated) * 6)
    b.updated = now
    if b.tokens < cost then
        return false
    end
    b.tokens = b.tokens - cost
    return true
end

local function ensureLeaderstats(player: Player)
    local stats = player:FindFirstChild("leaderstats")
    if not stats then
        stats = Instance.new("Folder")
        stats.Name = "leaderstats"
        stats.Parent = player
    end
    local function ensureInt(name: string, val: number)
        local iv = stats:FindFirstChild(name)
        if not iv then
            iv = Instance.new("IntValue")
            iv.Name = name
            iv.Value = val
            iv.Parent = stats
        end
        return iv
    end
    local coins = ensureInt("Coins", 400)
    local floor = ensureInt("TowerFloor", 1)
    local power = ensureInt("Power", 0)
    return coins, floor, power
end

local function getInventoryCap(profile): number
    local capLvl = (profile.upgrades and profile.upgrades.Cap) or 0
    return BASE_INVENTORY_CAP + capLvl * 10
end

local function computeEffectiveLuck(player: Player, profile): number
    local luckLvl = (profile.upgrades and profile.upgrades.Luck) or 0
    local upgMult = 1 + luckLvl * 0.20
    local levelMult = 1 + math.max(0, (profile.level or 1) - 1) * 0.05
    local rebirthMult = 1 + (profile.rebirths or 0) * 0.30

    local now = os.time()
    local potionLuck = 1.0
    if profile.buffs and profile.buffs.luckUntil and profile.buffs.luckUntil > now then
        potionLuck = math.max(1.0, profile.buffs.luckMult or 1.0)
    end

    local weatherLuck = 1.0
    local wVal = StateFolder:FindFirstChild("ActiveWeatherLuck")
    if wVal and wVal:IsA("NumberValue") and wVal.Value > 0 then
        weatherLuck = wVal.Value
    end

    local charmLuck = 0.0
    for _, cardId in ipairs(profile.deck) do
        local owned = profile.owned[cardId]
        if owned and owned.charm then
            local ch = CardDatabase.CHARM_BY_ID[owned.charm]
            if ch then
                charmLuck = charmLuck + ch.luckBonus
            end
        end
    end

    local total = upgMult * levelMult * rebirthMult * potionLuck * weatherLuck * (1 + charmLuck)
    player:SetAttribute("EffectiveLuck", math.floor(total * 100) / 100)
    return total
end

local function computeRollSpeed(profile): number
    local spdLvl = (profile.upgrades and profile.upgrades.Speed) or 0
    local upgMult = 1 + spdLvl * 0.12
    local now = os.time()
    local potionSpd = 1.0
    if profile.buffs and profile.buffs.speedUntil and profile.buffs.speedUntil > now then
        potionSpd = math.max(1.0, profile.buffs.speedMult or 1.0)
    end
    return upgMult * potionSpd
end

local function computeTeamPower(player: Player, profile): number
    local total = 0
    for _, cardId in ipairs(profile.deck) do
        local cardDef = CardDatabase.CARD_BY_ID[cardId]
        local entry = profile.owned[cardId]
        if cardDef and entry then
            total = total + CombatMath.cardPower(cardDef, entry)
        end
    end
    local uniqueCount = 0
    for _ in pairs(profile.index) do
        uniqueCount = uniqueCount + 1
    end
    local indexMult = 1 + uniqueCount * 0.02
    local rebirthMult = 1 + (profile.rebirths or 0) * 0.20
    local finalPower = math.floor(total * indexMult * rebirthMult)
    player:SetAttribute("TeamPower", finalPower)
    local stats = player:FindFirstChild("leaderstats")
    local pStat = stats and stats:FindFirstChild("Power")
    if pStat and pStat:IsA("IntValue") then
        pStat.Value = finalPower
    end
    return finalPower
end

local function updateOverheadCard(player: Player, profile)
    local char = player.Character
    if not char then
        return
    end
    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not head or not head:IsA("BasePart") then
        return
    end

    local old = overheadCards[player]
    if old then
        old:Destroy()
        overheadCards[player] = nil
    end

    local leadId = profile.deck[1]
    if not leadId then
        return
    end
    local cardDef = CardDatabase.CARD_BY_ID[leadId]
    if not cardDef then
        return
    end
    local rarityInfo = CardDatabase.RARITY_BY_ID[cardDef.rarity] or CardDatabase.RARITIES[1]

    local model = Instance.new("Model")
    model.Name = "EquippedShowcaseCard"

    local board = Instance.new("Part")
    board.Name = "CardBoard"
    board.Size = Vector3.new(2.2, 3.0, 0.22)
    board.Anchored = false
    board.CanCollide = false
    board.Massless = true
    board.Material = Enum.Material.SmoothPlastic
    board.Color = rarityInfo.color
    board.CFrame = head.CFrame * CFrame.new(2.2, 2.1, 0)
    board.Parent = model

    local decal = Instance.new("Decal")
    decal.Name = "ArtDecal"
    decal.Face = Enum.NormalId.Front
    decal.Texture = cardDef.portrait
    decal.Parent = board

    local sgui = Instance.new("SurfaceGui")
    sgui.Name = "ArtSurfaceGui"
    sgui.Face = Enum.NormalId.Front
    local img = Instance.new("ImageLabel")
    img.Size = UDim2.new(1, 0, 1, 0)
    img.BackgroundTransparency = 1
    img.Image = cardDef.portrait
    img.ScaleType = Enum.ScaleType.Crop
    img.Parent = sgui
    sgui.Parent = board

    local hl = Instance.new("Highlight")
    hl.FillTransparency = 0.85
    hl.OutlineColor = rarityInfo.color
    hl.OutlineTransparency = 0.1
    hl.Parent = board

    local att0 = Instance.new("Attachment")
    att0.Position = Vector3.new(2.2, 2.2, 0)
    att0.Parent = head

    local att1 = Instance.new("Attachment")
    att1.Parent = board

    local alignPos = Instance.new("AlignPosition")
    alignPos.Attachment0 = att1
    alignPos.Attachment1 = att0
    alignPos.MaxForce = 10000
    alignPos.Responsiveness = 18
    alignPos.Parent = board

    local alignOri = Instance.new("AlignOrientation")
    alignOri.Attachment0 = att1
    alignOri.Attachment1 = att0
    alignOri.MaxTorque = 10000
    alignOri.Responsiveness = 15
    alignOri.Parent = board

    model.Parent = char
    overheadCards[player] = model
end

local function makeSnapshot(profile)
    return {
        coins = profile.coins,
        shards = profile.shards,
        raidTokens = profile.raidTokens,
        level = profile.level,
        xp = profile.xp,
        pity = profile.pity,
        totalRolls = profile.totalRolls,
        rebirths = profile.rebirths,
        towerFloor = profile.towerFloor,
        storyCleared = profile.storyCleared,
        selectedPack = profile.selectedPack,
        autoDelete = profile.autoDelete,
        upgrades = profile.upgrades,
        owned = profile.owned,
        deck = profile.deck,
        index = profile.index,
        charmsOwned = profile.charmsOwned,
        codes = profile.codes,
    }
end

local function syncPlayer(player: Player)
    local profile = profiles[player]
    if not profile then
        return
    end
    local coinsStat, floorStat = ensureLeaderstats(player)
    coinsStat.Value = profile.coins
    floorStat.Value = profile.towerFloor

    player:SetAttribute("TowerFloor", profile.towerFloor)
    player:SetAttribute("Rebirths", profile.rebirths)
    player:SetAttribute("RollLevel", profile.level)
    player:SetAttribute("Shards", profile.shards)
    player:SetAttribute("PityCount", profile.pity)

    local luck = computeEffectiveLuck(player, profile)
    local power = computeTeamPower(player, profile)

    pcall(function()
        storageBridge:Invoke("stage", player.UserId, makeSnapshot(profile))
    end)

    stateSync:FireClient(player, {
        coins = profile.coins,
        shards = profile.shards,
        raidTokens = profile.raidTokens,
        level = profile.level,
        xp = profile.xp,
        xpMax = CombatMath.xpForNextLevel(profile.level),
        pity = profile.pity,
        pityMax = PITY_THRESHOLD,
        totalRolls = profile.totalRolls,
        rebirths = profile.rebirths,
        towerFloor = profile.towerFloor,
        storyCleared = profile.storyCleared,
        selectedPack = profile.selectedPack,
        autoDelete = profile.autoDelete,
        upgrades = profile.upgrades,
        owned = profile.owned,
        deck = profile.deck,
        index = profile.index,
        charmsOwned = profile.charmsOwned,
        buffs = profile.buffs,
        luck = luck,
        speedMult = computeRollSpeed(profile),
        teamPower = power,
        inventoryCap = getInventoryCap(profile),
        autoRoll = profile.autoRoll,
    })
end

local function defaultProfile()
    return {
        coins = 450,
        shards = 35,
        raidTokens = 0,
        level = 1,
        xp = 0,
        pity = 0,
        totalRolls = 0,
        rebirths = 0,
        towerFloor = 1,
        storyCleared = 0,
        selectedPack = "Starter",
        autoDelete = {},
        upgrades = { Luck = 0, Speed = 0, Cap = 0 },
        owned = {
            ["eclipse-arcane-alchemist"] = {
                card_id = "eclipse-arcane-alchemist",
                border = "Normal",
                border_mult = 1.0,
                stars = 1,
                copies = 1,
                locked = true,
                trait = nil,
                charm = nil,
            },
            ["ember-acolyte"] = {
                card_id = "ember-acolyte",
                border = "Normal",
                border_mult = 1.0,
                stars = 1,
                copies = 1,
                locked = false,
                trait = nil,
                charm = nil,
            },
        },
        deck = { "eclipse-arcane-alchemist", "ember-acolyte" },
        index = {
            ["eclipse-arcane-alchemist"] = true,
            ["ember-acolyte"] = true,
        },
        charmsOwned = {},
        codes = {},
        buffs = { luckMult = 1.0, luckUntil = 0, speedMult = 1.0, speedUntil = 0 },
        autoRoll = false,
        lastRollAt = 0,
    }
end

local function addXp(profile, amount: number)
    profile.xp = profile.xp + amount
    local leveled = false
    while profile.xp >= CombatMath.xpForNextLevel(profile.level) do
        profile.xp = profile.xp - CombatMath.xpForNextLevel(profile.level)
        profile.level = profile.level + 1
        profile.coins = profile.coins + 120 + profile.level * 25
        profile.shards = profile.shards + 12
        leveled = true
    end
    return leveled
end

local function rollBorder(luck: number)
    local draw = rng:NextNumber()
    for i = #CardDatabase.BORDERS, 1, -1 do
        local b = CardDatabase.BORDERS[i]
        local threshold = math.min(0.95, b.chance * math.sqrt(luck))
        if b.id == "Normal" or draw <= threshold then
            return b.id, b.mult
        end
    end
    return "Normal", 1.0
end

local function rollRarity(profile, luck: number): string
    if profile.pity >= PITY_THRESHOLD * 2 then
        profile.pity = 0
        return "Secret"
    end
    if profile.pity >= PITY_THRESHOLD then
        profile.pity = 0
        return "Mythic"
    end
    for i = #CardDatabase.RARITIES, 1, -1 do
        local r = CardDatabase.RARITIES[i]
        if r.id == "Common" then
            return "Common"
        end
        local odds = math.min(0.65, luck / r.denom)
        if rng:NextNumber() <= odds then
            if r.id == "Mythic" or r.id == "Secret" then
                profile.pity = 0
            end
            return r.id
        end
    end
    return "Common"
end

local function pickCardFromPack(packId: string, rarityId: string, activeWeather: string)
    local exact = {}
    local packPool = {}
    local rarityPool = {}
    for _, c in ipairs(CardDatabase.CARDS) do
        local weatherOk = (c.weatherLock == nil) or (c.weatherLock == activeWeather)
        if weatherOk then
            if c.pack == packId and c.rarity == rarityId then
                table.insert(exact, c)
            end
            if c.pack == packId then
                table.insert(packPool, c)
            end
            if c.rarity == rarityId then
                table.insert(rarityPool, c)
            end
        end
    end

    -- Give weather-exclusive cards a 25% spotlight chance when their biome is active
    local wDef = CardDatabase.WEATHER_BY_ID[activeWeather]
    if wDef and wDef.exclusiveCard and rng:NextNumber() <= 0.22 then
        local ex = CardDatabase.CARD_BY_ID[wDef.exclusiveCard]
        if ex and (ex.rarity == rarityId or rarityId == "Common" or rarityId == "Rare") then
            return ex
        end
    end

    if #exact > 0 then
        return exact[rng:NextInteger(1, #exact)]
    end
    if #rarityPool > 0 then
        return rarityPool[rng:NextInteger(1, #rarityPool)]
    end
    if #packPool > 0 then
        return packPool[rng:NextInteger(1, #packPool)]
    end
    return CardDatabase.CARDS[1]
end

local function countOwnedUnique(profile): number
    local n = 0
    for _ in pairs(profile.owned) do
        n = n + 1
    end
    return n
end

local function performRoll(player: Player, fastMode: boolean, requestedPack: string?)
    local profile = profiles[player]
    if not profile then
        return { ok = false, reason = "loading" }
    end

    local packId = profile.selectedPack or "Starter"
    if typeof(requestedPack) == "string" and CardDatabase.PACK_BY_ID[requestedPack] then
        packId = requestedPack
        profile.selectedPack = packId
    end
    local pack = CardDatabase.PACK_BY_ID[packId] or CardDatabase.PACKS[1]

    local now = os.clock()
    local spd = computeRollSpeed(profile)
    local minDelay = (if fastMode then DEFAULT_FAST_COOLDOWN else DEFAULT_FAST_COOLDOWN * 1.45) / spd
    if (now - profile.lastRollAt) < minDelay then
        return { ok = false, reason = "cooldown" }
    end

    if profile.coins < pack.cost then
        -- Fall back cleanly to free Starter Pack if auto-rolling without enough coins
        if pack.cost > 0 then
            return { ok = false, reason = "insufficient_coins", needed = pack.cost }
        end
    end

    profile.lastRollAt = now
    profile.coins = profile.coins - pack.cost
    profile.totalRolls = profile.totalRolls + 1
    profile.pity = profile.pity + 1

    local wVal = StateFolder:FindFirstChild("ActiveWeather")
    local activeWeather = if wVal and wVal:IsA("StringValue") then wVal.Value else "Clear"

    local luck = computeEffectiveLuck(player, profile) * pack.luckBonus
    local rarityId = rollRarity(profile, luck)
    local card = pickCardFromPack(pack.id, rarityId, activeWeather)
    local borderId, borderMult = rollBorder(luck)
    local rarityMeta = CardDatabase.RARITY_BY_ID[card.rarity] or CardDatabase.RARITIES[1]

    local isNew = not profile.index[card.id]
    profile.index[card.id] = true

    local existing = profile.owned[card.id]
    local autoDeleted = false
    if profile.autoDelete[card.rarity] and not (existing and existing.locked) and borderId == "Normal" then
        autoDeleted = true
        profile.shards = profile.shards + rarityMeta.shards
        profile.coins = profile.coins + rarityMeta.shards * 4
    elseif existing then
        existing.copies = (existing.copies or 1) + 1
        if borderMult > (existing.border_mult or 1.0) then
            existing.border = borderId
            existing.border_mult = borderMult
        end
    else
        if countOwnedUnique(profile) < getInventoryCap(profile) then
            profile.owned[card.id] = {
                card_id = card.id,
                border = borderId,
                border_mult = borderMult,
                stars = 1,
                copies = 1,
                locked = (card.rarity == "Mythic" or card.rarity == "Secret"),
                trait = nil,
                charm = nil,
            }
            if #profile.deck < 4 then
                table.insert(profile.deck, card.id)
                updateOverheadCard(player, profile)
            end
        else
            autoDeleted = true
            profile.shards = profile.shards + rarityMeta.shards
        end
    end

    local leveledUp = addXp(profile, rarityMeta.xp)
    local globalVal = StateFolder:FindFirstChild("GlobalRolls")
    if globalVal and globalVal:IsA("IntValue") then
        globalVal.Value = globalVal.Value + 1
    end

    local entry = profile.owned[card.id]
    local stats = CombatMath.computeCardStats(card, entry)

    local payload = {
        ok = true,
        card_id = card.id,
        title = card.title,
        rarity = card.rarity,
        odds = rarityMeta.oddsText,
        element = card.element,
        pack = card.pack,
        portrait = card.portrait,
        skillName = card.skillName,
        skillKind = card.skillKind,
        passive = card.passive,
        border = borderId,
        border_mult = borderMult,
        atk = stats.atk,
        hp = stats.hp,
        speed = stats.speed,
        isNew = isNew,
        autoDeleted = autoDeleted,
        leveledUp = leveledUp,
        level = profile.level,
        pity = profile.pity,
        pityMax = PITY_THRESHOLD,
        luck = luck,
    }

    syncPlayer(player)
    rollNotice:FireClient(player, payload)
    return payload
end

local function autoEquipBest(player: Player, profile)
    local list = {}
    for cardId, entry in pairs(profile.owned) do
        local def = CardDatabase.CARD_BY_ID[cardId]
        if def then
            table.insert(list, { id = cardId, power = CombatMath.cardPower(def, entry) })
        end
    end
    table.sort(list, function(a, b)
        return a.power > b.power
    end)
    profile.deck = {}
    for i = 1, math.min(4, #list) do
        table.insert(profile.deck, list[i].id)
    end
    updateOverheadCard(player, profile)
end

local function pickRandomTrait()
    local total = 0
    for _, t in ipairs(CardDatabase.TRAITS) do
        total = total + t.weight
    end
    local r = rng:NextNumber() * total
    local acc = 0
    for _, t in ipairs(CardDatabase.TRAITS) do
        acc = acc + t.weight
        if r <= acc then
            return t.id
        end
    end
    return CardDatabase.TRAITS[1].id
end

rollFunction.OnServerInvoke = function(player, action, arg)
    if not consumeToken(player, 1) then
        return { ok = false, reason = "rate_limit" }
    end
    if typeof(action) ~= "string" then
        return { ok = false, reason = "invalid_action" }
    end
    local packArg = if typeof(arg) == "string" then arg else nil

    local profile = profiles[player]
    if not profile then
        return { ok = false, reason = "loading" }
    end

    if action == "roll" then
        return performRoll(player, false, packArg)
    elseif action == "fast_roll" then
        return performRoll(player, true, packArg)
    elseif action == "auto_toggle" then
        profile.autoRoll = not profile.autoRoll
        syncPlayer(player)
        return { ok = true, autoRoll = profile.autoRoll }
    elseif action == "select_pack" and packArg and CardDatabase.PACK_BY_ID[packArg] then
        profile.selectedPack = packArg
        syncPlayer(player)
        return { ok = true, selectedPack = packArg }
    elseif action == "status" then
        syncPlayer(player)
        return { ok = true, pity = profile.pity, pityMax = PITY_THRESHOLD }
    end
    return { ok = false, reason = "unknown_action" }
end

coreAction.OnServerEvent:Connect(function(player, action, arg1, arg2)
    if not consumeToken(player, 1) then
        return
    end
    if typeof(action) ~= "string" or #action > 40 then
        return
    end
    local profile = profiles[player]
    if not profile then
        return
    end

    if action == "sync" then
        syncPlayer(player)
        return
    elseif action == "auto_equip" then
        autoEquipBest(player, profile)
        syncPlayer(player)
        return
    elseif action == "rebirth" then
        if profile.towerFloor >= 10 then
            profile.rebirths = profile.rebirths + 1
            profile.towerFloor = 1
            profile.coins = profile.coins + 600
            profile.shards = profile.shards + 30
            syncPlayer(player)
            coreAction:FireClient(player, "toast", "Rebirth #" .. profile.rebirths .. " Ascended! (+30% Luck & +20% Power)")
        else
            coreAction:FireClient(player, "toast", "Reach Tower Floor 10 to Rebirth!")
        end
        return
    elseif action == "select_pack" then
        if typeof(arg1) == "string" and CardDatabase.PACK_BY_ID[arg1] then
            profile.selectedPack = arg1
            syncPlayer(player)
        end
        return
    elseif action == "toggle_autodelete" then
        if typeof(arg1) == "string" and CardDatabase.RARITY_BY_ID[arg1] and arg1 ~= "Mythic" and arg1 ~= "Secret" then
            profile.autoDelete[arg1] = not profile.autoDelete[arg1]
            syncPlayer(player)
        end
        return
    elseif action == "buy_upgrade" then
        if typeof(arg1) ~= "string" then
            return
        end
        for _, upg in ipairs(CardDatabase.UPGRADES) do
            if upg.id == arg1 then
                local cur = profile.upgrades[arg1] or 0
                if cur >= upg.maxLevel then
                    coreAction:FireClient(player, "toast", upg.name .. " is MAX level!")
                    return
                end
                local cost = CombatMath.getUpgradeCost(arg1, cur)
                if profile.coins < cost then
                    coreAction:FireClient(player, "toast", "Need " .. cost .. " Coins for " .. upg.name)
                    return
                end
                profile.coins = profile.coins - cost
                profile.upgrades[arg1] = cur + 1
                syncPlayer(player)
                coreAction:FireClient(player, "toast", upg.name .. " upgraded to Lv." .. (cur + 1) .. "!")
                return
            end
        end
        return
    elseif action == "buy_potion" then
        if typeof(arg1) ~= "string" then
            return
        end
        for _, pot in ipairs(CardDatabase.POTIONS) do
            if pot.id == arg1 then
                if profile.coins < pot.cost then
                    coreAction:FireClient(player, "toast", "Need " .. pot.cost .. " Coins for " .. pot.name)
                    return
                end
                profile.coins = profile.coins - pot.cost
                if pot.id == "WeatherReroll" then
                    local nextW = shiftWeather:Invoke(player, nil)
                    coreAction:FireClient(player, "toast", "Weather shifted to " .. tostring(nextW) .. "!")
                else
                    local now = os.time()
                    if pot.luckMult > 1.0 then
                        profile.buffs.luckMult = math.max(profile.buffs.luckMult or 1.0, pot.luckMult)
                        profile.buffs.luckUntil = math.max(profile.buffs.luckUntil or now, now) + pot.duration
                    end
                    if pot.speedMult > 1.0 then
                        profile.buffs.speedMult = math.max(profile.buffs.speedMult or 1.0, pot.speedMult)
                        profile.buffs.speedUntil = math.max(profile.buffs.speedUntil or now, now) + pot.duration
                    end
                    coreAction:FireClient(player, "potion_used", pot.name)
                end
                syncPlayer(player)
                return
            end
        end
        return
    elseif action == "redeem_code" then
        if typeof(arg1) ~= "string" or #arg1 == 0 or #arg1 > 32 then
            return
        end
        local code = string.upper(arg1)
        local reward = CardDatabase.CODES[code]
        if not reward then
            coreAction:FireClient(player, "toast", "Invalid code: " .. code)
            return
        end
        if profile.codes[code] then
            coreAction:FireClient(player, "toast", "Code already redeemed: " .. code)
            return
        end
        profile.codes[code] = true
        profile.coins = profile.coins + reward.coins
        profile.shards = profile.shards + reward.shards
        local now = os.time()
        if reward.luckSec > 0 then
            profile.buffs.luckMult = math.max(profile.buffs.luckMult or 1.0, reward.luckMult)
            profile.buffs.luckUntil = math.max(profile.buffs.luckUntil or now, now) + reward.luckSec
        end
        if reward.speedSec > 0 then
            profile.buffs.speedMult = math.max(profile.buffs.speedMult or 1.0, reward.speedMult)
            profile.buffs.speedUntil = math.max(profile.buffs.speedUntil or now, now) + reward.speedSec
        end
        syncPlayer(player)
        coreAction:FireClient(player, "toast", "Redeemed " .. code .. "! +" .. reward.coins .. " Coins & +" .. reward.shards .. " Shards")
        return
    elseif action == "craft_charm" then
        if typeof(arg1) ~= "string" then
            return
        end
        local ch = CardDatabase.CHARM_BY_ID[arg1]
        if not ch then
            return
        end
        if profile.charmsOwned[ch.id] then
            coreAction:FireClient(player, "toast", ch.name .. " already crafted!")
            return
        end
        if profile.shards < ch.shardCost then
            coreAction:FireClient(player, "toast", "Need " .. ch.shardCost .. " Shards for " .. ch.name)
            return
        end
        profile.shards = profile.shards - ch.shardCost
        profile.charmsOwned[ch.id] = true
        syncPlayer(player)
        coreAction:FireClient(player, "toast", "Crafted Charm: " .. ch.name .. "!")
        return
    end

    -- Actions below target a specific owned cardId
    if typeof(arg1) ~= "string" or #arg1 == 0 or #arg1 > 64 then
        return
    end
    local entry = profile.owned[arg1]
    if not entry then
        return
    end

    if action == "equip" then
        for _, id in ipairs(profile.deck) do
            if id == arg1 then
                return
            end
        end
        if #profile.deck < 4 then
            table.insert(profile.deck, arg1)
            updateOverheadCard(player, profile)
            syncPlayer(player)
        else
            coreAction:FireClient(player, "toast", "4-Slot Deck full! Unequip a card first.")
        end
    elseif action == "unequip" then
        for idx, id in ipairs(profile.deck) do
            if id == arg1 then
                table.remove(profile.deck, idx)
                updateOverheadCard(player, profile)
                syncPlayer(player)
                return
            end
        end
    elseif action == "toggle_lock" then
        entry.locked = not entry.locked
        syncPlayer(player)
    elseif action == "fuse" then
        if (entry.stars or 1) < 5 and (entry.copies or 1) >= 3 then
            entry.copies = entry.copies - 2
            entry.stars = (entry.stars or 1) + 1
            syncPlayer(player)
            coreAction:FireClient(player, "toast", "Star Fused to " .. entry.stars .. "★!")
        else
            coreAction:FireClient(player, "toast", "Need 3 total copies to Star Fuse (max 5★).")
        end
    elseif action == "reroll_trait" then
        local cost = 15
        if profile.shards < cost then
            coreAction:FireClient(player, "toast", "Need " .. cost .. " Shards to reroll Trait!")
            return
        end
        profile.shards = profile.shards - cost
        entry.trait = pickRandomTrait()
        syncPlayer(player)
        coreAction:FireClient(player, "toast", "Rolled Trait: " .. entry.trait .. "!")
    elseif action == "equip_charm" then
        if typeof(arg2) ~= "string" then
            return
        end
        if arg2 == "None" then
            entry.charm = nil
            syncPlayer(player)
            return
        end
        if profile.charmsOwned[arg2] then
            for _, other in pairs(profile.owned) do
                if other.charm == arg2 then
                    other.charm = nil
                end
            end
            entry.charm = arg2
            syncPlayer(player)
            coreAction:FireClient(player, "toast", "Equipped Charm: " .. arg2)
        end
    end
end)

profileQuery.OnInvoke = function(op, player)
    if typeof(player) ~= "Instance" or not player:IsA("Player") then
        return nil
    end
    local profile = profiles[player]
    if not profile then
        return nil
    end
    if op == "deck_units" then
        local units = {}
        for _, cardId in ipairs(profile.deck) do
            local def = CardDatabase.CARD_BY_ID[cardId]
            local entry = profile.owned[cardId]
            if def and entry then
                local st = CombatMath.computeCardStats(def, entry)
                table.insert(units, {
                    card_id = def.id,
                    title = def.title,
                    rarity = def.rarity,
                    element = def.element,
                    portrait = def.portrait,
                    skillName = def.skillName,
                    skillKind = def.skillKind,
                    cooldown = math.max(1, def.cooldown - st.cdReduce),
                    atk = st.atk,
                    hp = st.hp,
                    max_hp = st.hp,
                    speed = st.speed,
                    critBonus = st.critBonus,
                    lifesteal = st.lifesteal,
                    regenPct = st.regenPct,
                    coinMult = st.coinMult,
                    enemySlow = st.enemySlow,
                    trait = entry.trait,
                    charm = entry.charm,
                    stars = entry.stars,
                })
            end
        end
        return {
            units = units,
            towerFloor = profile.towerFloor,
            storyCleared = profile.storyCleared,
            rebirths = profile.rebirths,
            teamPower = computeTeamPower(player, profile),
        }
    end
    return profile
end

rewardSignal.Event:Connect(function(player, data)
    if typeof(player) ~= "Instance" or not player:IsA("Player") or typeof(data) ~= "table" then
        return
    end
    local profile = profiles[player]
    if not profile then
        return
    end
    if typeof(data.coins) == "number" and data.coins > 0 then
        profile.coins = profile.coins + math.floor(data.coins)
    end
    if typeof(data.shards) == "number" and data.shards > 0 then
        profile.shards = profile.shards + math.floor(data.shards)
    end
    if typeof(data.raidTokens) == "number" and data.raidTokens > 0 then
        profile.raidTokens = profile.raidTokens + math.floor(data.raidTokens)
    end
    if typeof(data.xp) == "number" and data.xp > 0 then
        addXp(profile, math.floor(data.xp))
    end
    if typeof(data.towerFloor) == "number" and data.towerFloor > profile.towerFloor then
        profile.towerFloor = math.floor(data.towerFloor)
    end
    if typeof(data.storyCleared) == "number" and data.storyCleared > profile.storyCleared then
        profile.storyCleared = math.floor(data.storyCleared)
    end
    syncPlayer(player)
    if typeof(data.reason) == "string" and #data.reason > 0 then
        coreAction:FireClient(player, "toast", data.reason)
    end
end)

local PROMPT_PANEL_MAP = {
    SummonPrompt = "Index",
    InspectPrompt = "Index",
    BossPrompt = "Battle",
    TowerPrompt = "Battle",
    PvpPrompt = "Battle",
    PotionPrompt = "Potions",
    ForgePrompt = "Forge",
}

-- Wire Workspace ProximityPrompts & animated Torii halo rings + Leaderboard Wall
local function wireWorldLandmarks()
    local lobby = workspace:FindFirstChild("ApexLobby")
    if lobby then
        for _, desc in ipairs(lobby:GetDescendants()) do
            if desc:IsA("ProximityPrompt") then
                desc.Triggered:Connect(function(player)
                    local panel = desc:GetAttribute("OpenPanel") or PROMPT_PANEL_MAP[desc.Name]
                    if typeof(panel) == "string" then
                        openPanelEvent:FireClient(player, panel)
                    end
                end)
            end
        end

        local haloOuter = lobby:FindFirstChild("ToriiHaloOuter", true)
        local haloInner = lobby:FindFirstChild("ToriiHaloInner", true)
        if haloOuter and haloOuter:IsA("BasePart") and haloInner and haloInner:IsA("BasePart") then
            local baseOuter = haloOuter.Position
            local baseInner = haloInner.Position
            local t = 0
            RunService.Heartbeat:Connect(function(dt)
                t = t + dt
                local bob = math.sin(t * 2.0) * 0.45
                haloOuter.CFrame = CFrame.new(baseOuter + Vector3.new(0, bob, 0)) * CFrame.Angles(0, t * 1.1, math.rad(15))
                haloInner.CFrame = CFrame.new(baseInner + Vector3.new(0, -bob * 0.8, 0)) * CFrame.Angles(math.rad(12), -t * 1.6, 0)
            end)
        end
    end

    local gallery = workspace:FindFirstChild("CardGallery")
    if gallery then
        for _, desc in ipairs(gallery:GetDescendants()) do
            if desc:IsA("ProximityPrompt") then
                desc.Triggered:Connect(function(player)
                    openPanelEvent:FireClient(player, "Index")
                end)
            end
        end
    end

    task.spawn(function()
        while true do
            task.wait(3)
            if lobby then
                local lbText = lobby:FindFirstChild("Rankings", true)
                if lbText and lbText:IsA("TextLabel") then
                    local lines = { "APEX TOWER & POWER LEADERBOARD" }
                    for _, p in ipairs(Players:GetPlayers()) do
                        local fl = p:GetAttribute("TowerFloor") or 1
                        local pw = p:GetAttribute("TeamPower") or 0
                        table.insert(lines, p.Name .. "  |  Floor " .. tostring(fl) .. "  |  Power " .. tostring(pw))
                    end
                    lbText.Text = table.concat(lines, "\n")
                end
                local raidText = lobby:FindFirstChild("RaidStats", true)
                if raidText and raidText:IsA("TextLabel") then
                    local rAct = StateFolder:FindFirstChild("RaidBossActive")
                    local rCd = StateFolder:FindFirstChild("RaidCountdown")
                    local rHp = StateFolder:FindFirstChild("RaidBossHP")
                    local rMax = StateFolder:FindFirstChild("RaidBossMaxHP")
                    if rAct and rAct:IsA("BoolValue") and rAct.Value and rHp and rMax then
                        raidText.Text = "WORLD RAID ACTIVE!\nAbyssal Eclipse Leviathan\nHP: " .. tostring(rHp.Value) .. " / " .. tostring(rMax.Value)
                    elseif rCd then
                        raidText.Text = "NEXT WORLD RAID\nSpawning in " .. tostring(rCd.Value) .. "s\nBring your 4-card team!"
                    end
                end
            end
        end
    end)
end
task.spawn(wireWorldLandmarks)

local function onPlayerAdded(player: Player)
    ensureLeaderstats(player)
    local res = storageBridge:Invoke("load", player.UserId)
    local prof = defaultProfile()
    if typeof(res) == "table" and res.ok then
        player:SetAttribute("DataLoaded", true)
        if typeof(res.data) == "table" and typeof(res.data.owned) == "table" then
            for k, v in pairs(res.data) do
                prof[k] = v
            end
            prof.autoRoll = false
            prof.lastRollAt = 0
            prof.buffs = prof.buffs or { luckMult = 1.0, luckUntil = 0, speedMult = 1.0, speedUntil = 0 }
        end
    else
        player:SetAttribute("DataLoaded", false)
    end
    profiles[player] = prof

    player.CharacterAdded:Connect(function()
        task.wait(0.25)
        if profiles[player] then
            updateOverheadCard(player, profiles[player])
        end
    end)

    syncPlayer(player)
    if player.Character then
        task.spawn(function()
            task.wait(0.25)
            updateOverheadCard(player, prof)
        end)
    end

    task.spawn(function()
        while player.Parent do
            local st = profiles[player]
            local spd = if st then computeRollSpeed(st) else 1.0
            task.wait(math.max(0.22, DEFAULT_FAST_COOLDOWN / spd))
            if st and st.autoRoll then
                local r = performRoll(player, true, st.selectedPack)
                if not r.ok and r.reason == "insufficient_coins" then
                    st.selectedPack = "Starter"
                end
            end
        end
    end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do
    task.spawn(onPlayerAdded, p)
end

Players.PlayerRemoving:Connect(function(player)
    local card = overheadCards[player]
    if card then
        card:Destroy()
        overheadCards[player] = nil
    end
    profiles[player] = nil
    rateBuckets[player] = nil
end)
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX00000179">
      <Properties>
        <string name="Name">BattleEngine</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[-- BattleEngine.server.luau (ServerScriptService.BattleEngine)
-- Turn/tick-based 4v4 Auto-Battle Clash Engine supporting:
-- 1. 5 Story Bosses (up to Impossible Overlord)
-- 2. Infinite Tower Floors (escalating rewards + milestone bosses)
-- 3. Timed World Raid Boss (live shared Raid Boss HP & Raid Shards)
-- 4. PvP Duel Challenge (live player deck vs player or Rival Champion Ghost)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local CardDatabase = require(Modules:WaitForChild("CardDatabase"))
local CombatMath = require(Modules:WaitForChild("CombatMath"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local battleEvent = Remotes:FindFirstChild("BattleEvent")
if not battleEvent then
    battleEvent = Instance.new("RemoteEvent")
    battleEvent.Name = "BattleEvent"
    battleEvent.Parent = Remotes
end

local profileQuery = ServerStorage:WaitForChild("ApexProfileQuery")
local rewardSignal = ServerStorage:WaitForChild("ApexRewardSignal")
local raidDamageBindable = ServerStorage:WaitForChild("ApexRaidDamage")

local rng = Random.new()
local lastReq = {}
local activeLocks = {}

local function makeUnit(raw, side: string, slot: number)
    return {
        side = side,
        slot = slot,
        card_id = raw.card_id or ("enemy-" .. slot),
        title = raw.title,
        element = raw.element or "Solar",
        portrait = raw.portrait or "rbxasset://openro-assets/crimson-sea-captain.png",
        atk = raw.atk or 150,
        hp = raw.hp or 700,
        max_hp = raw.hp or 700,
        speed = raw.speed or 80,
        skillName = raw.skillName or raw.skillKind or "Strike",
        skillKind = raw.skillKind or "Burn AoE",
        maxCd = raw.cooldown or 3,
        cd = 1,
        shield = 0,
        burnTurns = 0,
        stunned = false,
        counterReady = false,
        atkBuffTurns = 0,
        critBonus = raw.critBonus or 0.12,
        lifesteal = raw.lifesteal or 0,
        regenPct = raw.regenPct or 0,
        coinMult = raw.coinMult or 1.0,
        enemySlow = raw.enemySlow or 0,
    }
end

local function buildPlayerTeam(player: Player)
    local snap = profileQuery:Invoke("deck_units", player)
    local team = {}
    if typeof(snap) == "table" and typeof(snap.units) == "table" then
        for i, u in ipairs(snap.units) do
            if i <= 4 then
                table.insert(team, makeUnit(u, "left", i))
            end
        end
    end
    if #team == 0 then
        local starter = CardDatabase.CARD_BY_ID["eclipse-arcane-alchemist"]
        table.insert(team, makeUnit(starter, "left", 1))
    end
    return team, snap or { towerFloor = 1, storyCleared = 0 }
end

local function buildTowerWave(floorNum: number)
    local scale = 1 + (floorNum - 1) * 0.22
    local isBoss = (floorNum % 10 == 0)
    local pool = { "crimson-sea-captain", "infinity-void-sorcerer", "thunder-flash-ronin", "shadow-sovereign", "blood-moon-gravity-ronin", "nine-tail-ember-shinobi" }
    local wave = {}
    for i = 1, 4 do
        local cid = pool[((floorNum + i - 2) % #pool) + 1]
        local def = CardDatabase.CARD_BY_ID[cid] or CardDatabase.CARDS[1]
        local bossBoost = if isBoss and i == 4 then 1.55 else 1.0
        table.insert(wave, makeUnit({
            card_id = def.id,
            title = (if isBoss and i == 4 then "Floor " .. floorNum .. " Overlord" else def.title .. " F" .. floorNum),
            element = def.element,
            portrait = def.portrait,
            atk = math.floor(def.atk * 0.42 * scale * bossBoost),
            hp = math.floor(def.hp * 0.48 * scale * bossBoost),
            speed = math.min(115, def.speed + math.floor(floorNum / 2)),
            skillKind = def.skillKind,
            skillName = def.skillName,
            cooldown = def.cooldown,
        }, "right", i))
    end
    return wave
end

local function buildRaidWave()
    local rb = CardDatabase.WORLD_RAID_BOSS
    return {
        makeUnit({
            title = "Eclipse Herald I", element = "Shadow", atk = 240, hp = 1650, speed = 86,
            skillKind = "Guard Break", skillName = "Void Rend", portrait = "rbxasset://openro-assets/blood-moon-gravity-ronin.png",
        }, "right", 1),
        makeUnit({
            title = "Abyssal Guardian", element = "Arcane", atk = 260, hp = 1900, speed = 84,
            skillKind = "Mirror Shield", skillName = "Prism Wall", portrait = "rbxasset://openro-assets/infinity-void-sorcerer.png",
        }, "right", 2),
        makeUnit({
            title = rb.name, element = rb.element, atk = rb.atk, hp = 4200, speed = rb.speed,
            skillKind = "Burn AoE", skillName = "Cataclysm Pulse", portrait = rb.portrait,
        }, "right", 3),
        makeUnit({
            title = "Eclipse Herald II", element = "Storm", atk = 250, hp = 1580, speed = 91,
            skillKind = "Stun", skillName = "Dark Thunder", portrait = "rbxasset://openro-assets/thunder-flash-ronin.png",
        }, "right", 4),
    }
end

local function buildPvpWave(challenger: Player)
    local targetPlayer = nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= challenger then
            targetPlayer = p
            break
        end
    end
    if targetPlayer then
        local snap = profileQuery:Invoke("deck_units", targetPlayer)
        if typeof(snap) == "table" and typeof(snap.units) == "table" and #snap.units > 0 then
            local wave = {}
            for i, u in ipairs(snap.units) do
                if i <= 4 then
                    table.insert(wave, makeUnit(u, "right", i))
                end
            end
            return wave, targetPlayer.Name
        end
    end
    -- Solo Studio fallback: Rival Champion Ghost Deck
    local ghostIds = { "thunder-flash-ronin", "crimson-sea-captain", "blood-moon-gravity-ronin", "eclipse-arcane-alchemist" }
    local wave = {}
    for i, gid in ipairs(ghostIds) do
        local def = CardDatabase.CARD_BY_ID[gid]
        table.insert(wave, makeUnit({
            card_id = def.id,
            title = "Rival " .. def.title,
            element = def.element,
            portrait = def.portrait,
            atk = math.floor(def.atk * 0.72),
            hp = math.floor(def.hp * 0.78),
            speed = def.speed,
            skillKind = def.skillKind,
            skillName = def.skillName,
            cooldown = def.cooldown,
        }, "right", i))
    end
    return wave, "Arena Grandmaster Ghost"
end

local function livingUnits(team)
    local list = {}
    for _, u in ipairs(team) do
        if u.hp > 0 then
            table.insert(list, u)
        end
    end
    return list
end

local function runMatch(player: Player, mode: string, argVal: number?)
    if activeLocks[player] then
        return
    end
    activeLocks[player] = true

    local leftTeam, snap = buildPlayerTeam(player)
    local rightTeam = {}
    local title = "Battle Clash"
    local rewardCoins = 120
    local rewardShards = 8
    local bossId = 0
    local targetFloor = snap.towerFloor or 1

    if mode == "story" then
        bossId = math.clamp(math.floor(argVal or 1), 1, #CardDatabase.STORY_BOSSES)
        local bossDef = CardDatabase.STORY_BOSSES[bossId]
        title = "Story Boss " .. bossId .. ": " .. bossDef.name
        rewardCoins = bossDef.rewardCoins
        rewardShards = bossDef.rewardShards
        for i, u in ipairs(bossDef.team) do
            table.insert(rightTeam, makeUnit(u, "right", i))
        end
    elseif mode == "tower" then
        targetFloor = math.max(1, math.floor(argVal or snap.towerFloor or 1))
        rightTeam = buildTowerWave(targetFloor)
        title = "Infinite Tower Floor " .. targetFloor
        rewardCoins = 110 + targetFloor * 45
        rewardShards = 6 + math.floor(targetFloor / 2) * 3
    elseif mode == "raid" then
        rightTeam = buildRaidWave()
        title = "World Raid: " .. CardDatabase.WORLD_RAID_BOSS.name
        rewardCoins = 320
        rewardShards = 35
    elseif mode == "pvp" then
        local rivalName
        rightTeam, rivalName = buildPvpWave(player)
        title = "PvP Duel vs " .. rivalName
        rewardCoins = 260
        rewardShards = 18
    else
        activeLocks[player] = nil
        return
    end

    -- Apply Charm enemy slow passive
    local totalSlow = 0
    for _, u in ipairs(leftTeam) do
        totalSlow = totalSlow + (u.enemySlow or 0)
    end
    if totalSlow > 0 then
        for _, e in ipairs(rightTeam) do
            e.speed = math.max(30, math.floor(e.speed * (1 - math.min(0.45, totalSlow))))
        end
    end

    local events = {}
    local function pushEvent(ev)
        table.insert(events, ev)
    end

    -- Snapshot initial units for client rendering
    local function serializeTeam(t)
        local out = {}
        for _, u in ipairs(t) do
            table.insert(out, {
                slot = u.slot, side = u.side, title = u.title, element = u.element,
                portrait = u.portrait, hp = u.hp, max_hp = u.max_hp, atk = u.atk, speed = u.speed,
                skillName = u.skillName, skillKind = u.skillKind,
            })
        end
        return out
    end

    -- Round-start passives
    for _, u in ipairs(leftTeam) do
        if u.skillKind == "Mirror Shield" then
            for _, ally in ipairs(leftTeam) do
                ally.shield = ally.shield + math.floor(ally.max_hp * 0.14)
            end
            pushEvent({ type = "SkillTrigger", side = "left", slot = u.slot, title = u.title, skill = "Opening Mirror Shield" })
        elseif u.skillKind == "Domain Buff" then
            for _, ally in ipairs(leftTeam) do
                ally.atkBuffTurns = 2
            end
            pushEvent({ type = "SkillTrigger", side = "left", slot = u.slot, title = u.title, skill = "Opening Domain Buff" })
        end
    end

    local totalRaidDmg = 0
    local maxRounds = 12
    for round = 1, maxRounds do
        local aliveLeft = livingUnits(leftTeam)
        local aliveRight = livingUnits(rightTeam)
        if #aliveLeft == 0 or #aliveRight == 0 then
            break
        end

        pushEvent({ type = "RoundStart", round = round })

        local order = {}
        for _, u in ipairs(aliveLeft) do table.insert(order, u) end
        for _, u in ipairs(aliveRight) do table.insert(order, u) end
        table.sort(order, function(a, b)
            return a.speed > b.speed
        end)

        for _, actor in ipairs(order) do
            if actor.hp <= 0 then
                continue
            end
            local foes = if actor.side == "left" then livingUnits(rightTeam) else livingUnits(leftTeam)
            local allies = if actor.side == "left" then livingUnits(leftTeam) else livingUnits(rightTeam)
            if #foes == 0 then
                break
            end

            if actor.regenPct > 0 then
                local regen = math.floor(actor.max_hp * actor.regenPct)
                actor.hp = math.min(actor.max_hp, actor.hp + regen)
                pushEvent({ type = "Heal", side = actor.side, slot = actor.slot, amount = regen, hp = actor.hp, max_hp = actor.max_hp })
            end

            if actor.burnTurns > 0 then
                actor.burnTurns = actor.burnTurns - 1
                local bDmg = math.max(15, math.floor(actor.max_hp * 0.06))
                actor.hp = math.max(0, actor.hp - bDmg)
                pushEvent({ type = "Damage", side = actor.side, slot = actor.slot, amount = bDmg, isCrit = false, tag = "BURN", hp = actor.hp, max_hp = actor.max_hp, shield = actor.shield })
                if actor.hp <= 0 then
                    pushEvent({ type = "KO", side = actor.side, slot = actor.slot, title = actor.title })
                    continue
                end
            end

            if actor.stunned then
                actor.stunned = false
                pushEvent({ type = "Status", side = actor.side, slot = actor.slot, text = "STUNNED!" })
                continue
            end

            actor.cd = actor.cd - 1
            local useSkill = actor.cd <= 0
            if useSkill then
                actor.cd = actor.maxCd
                pushEvent({ type = "SkillTrigger", side = actor.side, slot = actor.slot, title = actor.title, skill = actor.skillName .. " [" .. actor.skillKind .. "]" })
            end

            local target = foes[1]
            pushEvent({ type = "Lunge", side = actor.side, slot = actor.slot, targetSide = target.side, targetSlot = target.slot })

            local elemMult = CombatMath.getElementMultiplier(actor.element, target.element)
            local isCrit = rng:NextNumber() <= actor.critBonus
            local critMult = if isCrit then 1.65 else 1.0
            local buffMult = if actor.atkBuffTurns > 0 then 1.25 else 1.0
            if actor.atkBuffTurns > 0 then
                actor.atkBuffTurns = actor.atkBuffTurns - 1
            end

            local skillMult = if useSkill then 1.55 else 1.0
            local rawDmg = math.max(10, math.floor(actor.atk * elemMult * critMult * buffMult * skillMult))

            local function applyHit(victim, dmgAmount: number, ignoreShield: boolean)
                local actual = dmgAmount
                if not ignoreShield and victim.shield > 0 then
                    local absorbed = math.min(victim.shield, actual)
                    victim.shield = victim.shield - absorbed
                    actual = actual - absorbed
                end
                victim.hp = math.max(0, victim.hp - actual)
                if actor.side == "left" then
                    totalRaidDmg = totalRaidDmg + dmgAmount
                end
                pushEvent({
                    type = "Damage",
                    side = victim.side,
                    slot = victim.slot,
                    amount = dmgAmount,
                    isCrit = isCrit,
                    tag = if elemMult > 1.0 then "ADV!" else "",
                    hp = victim.hp,
                    max_hp = victim.max_hp,
                    shield = victim.shield,
                })
                if victim.counterReady and victim.hp > 0 then
                    victim.counterReady = false
                    local reflect = math.floor(dmgAmount * 0.45)
                    actor.hp = math.max(0, actor.hp - reflect)
                    pushEvent({ type = "Damage", side = actor.side, slot = actor.slot, amount = reflect, isCrit = false, tag = "COUNTER!", hp = actor.hp, max_hp = actor.max_hp, shield = actor.shield })
                    if actor.hp <= 0 then
                        pushEvent({ type = "KO", side = actor.side, slot = actor.slot, title = actor.title })
                    end
                end
                if victim.hp <= 0 then
                    pushEvent({ type = "KO", side = victim.side, slot = victim.slot, title = victim.title })
                end
            end

            if useSkill and actor.skillKind == "Burn AoE" then
                for _, foe in ipairs(foes) do
                    applyHit(foe, math.floor(rawDmg * 0.68), false)
                    foe.burnTurns = 2
                end
            elseif useSkill and actor.skillKind == "Guard Break" then
                target.shield = 0
                applyHit(target, math.floor(rawDmg * 1.15), true)
            elseif useSkill and actor.skillKind == "Counter" then
                actor.counterReady = true
                applyHit(target, rawDmg, false)
            elseif useSkill and actor.skillKind == "Mirror Shield" then
                for _, ally in ipairs(allies) do
                    ally.shield = ally.shield + math.floor(ally.max_hp * 0.20)
                    pushEvent({ type = "Shield", side = ally.side, slot = ally.slot, shield = ally.shield })
                end
                applyHit(target, math.floor(rawDmg * 0.80), false)
            elseif useSkill and actor.skillKind == "Stun" then
                applyHit(target, rawDmg, false)
                if target.hp > 0 and rng:NextNumber() <= 0.65 then
                    target.stunned = true
                    pushEvent({ type = "Status", side = target.side, slot = target.slot, text = "STUNNED!" })
                end
            elseif useSkill and actor.skillKind == "Time Stop" then
                applyHit(target, rawDmg, false)
                for _, foe in ipairs(foes) do
                    foe.cd = foe.cd + 1
                    foe.stunned = true
                end
                pushEvent({ type = "Status", side = target.side, slot = target.slot, text = "TIME FROZEN!" })
            elseif useSkill and actor.skillKind == "Domain Buff" then
                for _, ally in ipairs(allies) do
                    ally.atkBuffTurns = 2
                    local heal = math.floor(ally.max_hp * 0.10)
                    ally.hp = math.min(ally.max_hp, ally.hp + heal)
                    pushEvent({ type = "Heal", side = ally.side, slot = ally.slot, amount = heal, hp = ally.hp, max_hp = ally.max_hp })
                end
                applyHit(target, rawDmg, false)
            else
                applyHit(target, rawDmg, false)
            end

            local totalLifesteal = actor.lifesteal + (if useSkill and actor.skillKind == "Lifesteal" then 0.35 else 0)
            if totalLifesteal > 0 and actor.hp > 0 then
                local healAmt = math.floor(rawDmg * totalLifesteal)
                actor.hp = math.min(actor.max_hp, actor.hp + healAmt)
                pushEvent({ type = "Heal", side = actor.side, slot = actor.slot, amount = healAmt, hp = actor.hp, max_hp = actor.max_hp })
            end
        end
    end

    local leftWon = #livingUnits(rightTeam) == 0 and #livingUnits(leftTeam) > 0
    local coinMult = 1.0
    for _, u in ipairs(leftTeam) do
        coinMult = math.max(coinMult, u.coinMult or 1.0)
    end

    local grantedCoins = 0
    local grantedShards = 0
    local grantedTokens = 0
    if mode == "raid" then
        local raidRes = raidDamageBindable:Invoke(player, totalRaidDmg)
        grantedCoins = math.floor((120 + totalRaidDmg / 18) * coinMult)
        grantedShards = math.max(10, math.floor(totalRaidDmg / 300))
        grantedTokens = if leftWon then 5 else 2
        rewardSignal:Fire(player, {
            coins = grantedCoins,
            shards = grantedShards,
            raidTokens = grantedTokens,
            xp = 95,
            reason = "Dealt " .. totalRaidDmg .. " Raid DMG! (Boss HP: " .. tostring(raidRes.hp or 0) .. ")",
        })
    elseif leftWon then
        grantedCoins = math.floor(rewardCoins * coinMult)
        grantedShards = rewardShards
        local payload = {
            coins = grantedCoins,
            shards = grantedShards,
            xp = 75,
            reason = title .. " Victory! +" .. grantedCoins .. " Coins, +" .. grantedShards .. " Shards",
        }
        if mode == "tower" then
            payload.towerFloor = targetFloor + 1
        elseif mode == "story" then
            payload.storyCleared = bossId
        end
        rewardSignal:Fire(player, payload)
    else
        grantedCoins = 35
        rewardSignal:Fire(player, {
            coins = grantedCoins,
            xp = 25,
            reason = title .. " Defeat — +35 Training Coins",
        })
    end

    pushEvent({
        type = "Result",
        won = leftWon,
        title = title,
        coins = grantedCoins,
        shards = grantedShards,
        raidTokens = grantedTokens,
        raidDmg = totalRaidDmg,
    })

    battleEvent:FireClient(player, "clash_replay", {
        mode = mode,
        title = title,
        leftTeam = serializeTeam(leftTeam),
        rightTeam = serializeTeam(rightTeam),
        events = events,
        won = leftWon,
        coins = grantedCoins,
        shards = grantedShards,
    })

    activeLocks[player] = nil
end

battleEvent.OnServerEvent:Connect(function(player, mode, argVal)
    local now = os.clock()
    if lastReq[player] and (now - lastReq[player]) < 0.8 then
        return
    end
    lastReq[player] = now
    if typeof(mode) ~= "string" then
        return
    end
    local numArg = if typeof(argVal) == "number" and argVal == argVal then argVal else nil
    task.spawn(runMatch, player, mode, numArg)
end)

Players.PlayerRemoving:Connect(function(player)
    lastReq[player] = nil
    activeLocks[player] = nil
end)
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="RBX0000017A">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="RBX0000017B">
      <Properties>
        <string name="Name">Modules</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX0000017C">
        <Properties>
          <string name="Name">CardDatabase</string>
          
          <ProtectedString name="Source"><![CDATA[-- CardDatabase.luau (ReplicatedStorage.Modules.CardDatabase)
-- Canonical catalog for Anime Card Battles: Rebirth — Apex Edition
-- 24 anime-homage cards, 6 packs, 6 rarity tiers, 5 traits, 4 craftable charms,
-- 7 weather biomes, 5 story bosses, and timed World Raid Boss.

local CardDatabase = {}

