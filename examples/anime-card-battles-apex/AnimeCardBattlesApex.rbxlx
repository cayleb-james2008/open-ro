    local row = makeFrame(upgBody, "Upg_" .. upg.id, UDim2.new(0.96, 0, 0, 76), UDim2.new(0.02, 0, 0, 14 + (idx - 1) * 86), PAL.card, 0)
    addCorner(row, 10)
