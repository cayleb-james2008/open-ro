  <Item class="ServerScriptService" referent="RBX00000028">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX00000029">
      <Properties>
        <string name="Name">CardBattleArena</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[-- CardBattleArena -- generated by OpenRO (system: card_battle_arena)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local TEAM_SIZE = 4
local ULTIMATE_MAX = 100
local COUNTER_WINDOW_SEC = 800 / 1000
local BOSS_HP_SCALE = 4

local battleEvent = ReplicatedStorage:FindFirstChild("OpenROBattleEvent")
if not battleEvent then
    battleEvent = Instance.new("RemoteEvent")
    battleEvent.Name = "OpenROBattleEvent"
    battleEvent.Parent = ReplicatedStorage
end

local towerClearSignal = ServerStorage:FindFirstChild("OpenROTowerClear")
if not towerClearSignal then
    towerClearSignal = Instance.new("BindableEvent")
    towerClearSignal.Name = "OpenROTowerClear"
    towerClearSignal.Parent = ServerStorage
end

local deckSnapshot = ServerStorage:FindFirstChild("OpenRODeckSnapshot")
if not deckSnapshot then
    deckSnapshot = Instance.new("BindableFunction")
    deckSnapshot.Name = "OpenRODeckSnapshot"
    deckSnapshot.Parent = ServerStorage
end

-- Elemental Synergy & Advantage Wheel: Flame > Shadow > Storm > Arcane > Void > Flame
local ELEMENT_ADVANTAGE = {
    Flame = "Shadow",
    Shadow = "Storm",
    Storm = "Arcane",
    Arcane = "Void",
    Void = "Flame",
}

local SYNERGY_BONUSES = {
    Flame = { atkMult = 1.20, critBonus = 0.05, shieldPct = 0.0, lifesteal = 0.0 },
    Void = { atkMult = 1.15, critBonus = 0.08, shieldPct = 0.05, lifesteal = 0.0 },
    Storm = { atkMult = 1.10, critBonus = 0.22, shieldPct = 0.0, lifesteal = 0.0 },
    Shadow = { atkMult = 1.15, critBonus = 0.10, shieldPct = 0.0, lifesteal = 0.18 },
    Arcane = { atkMult = 1.08, critBonus = 0.05, shieldPct = 0.22, lifesteal = 0.0 },
}

local BOSS_PHASES = {
    { threshold = 1.0, title = "Phase 1: Awakening", atkMult = 1.0 },
    { threshold = 0.55, title = "Phase 2: Enraged Domain", atkMult = 1.35 },
    { threshold = 0.25, title = "Phase 3: Apex Singularity", atkMult = 1.75 },
}

local rng = Random.new()
local battles = {}
local lastAction = {}

local function awardCoins(player, amount)
    local stats = player:FindFirstChild("leaderstats")
    if not stats then
        return
    end
    local coins = stats:FindFirstChild("Coins") or stats:FindFirstChild("Gems")
    if coins and coins:IsA("IntValue") then
        coins.Value = coins.Value + amount
    end
end

local function buildPlayerTeam(player)
    local team = {}
    local profile = nil
    if deckSnapshot and deckSnapshot:IsA("BindableFunction") then
        local ok, res = pcall(function()
            return deckSnapshot:Invoke(player)
        end)
        if ok and typeof(res) == "table" then
            profile = res
        end
    end
    if profile and typeof(profile.owned) == "table" then
        local byId = {}
        for _, card in ipairs(profile.owned) do
            byId[card.card_id] = card
        end
        for _, id in ipairs(profile.deck or {}) do
            local c = byId[id]
            if c and #team < TEAM_SIZE then
                table.insert(team, {
                    card_id = c.card_id,
                    title = c.title or c.card_id,
                    element = c.element or "Flame",
                    atk = c.atk or 220,
                    hp = c.hp or 950,
                    max_hp = c.hp or 950,
                    speed = c.speed or 82,
                    shield = 0,
                    stunned = false,
                })
            end
        end
    end
    if #team == 0 then
        table.insert(team, {
            card_id = "crimson-sea-captain",
            title = "Crimson Sea Captain",
            element = "Flame",
            atk = 420,
            hp = 1480,
            max_hp = 1480,
            speed = 88,
            shield = 0,
            stunned = false,
        })
    end
    return team
end

local function computeSynergies(team)
    local counts = {}
    for _, unit in ipairs(team) do
        counts[unit.element] = (counts[unit.element] or 0) + 1
    end
    local active = {}
    local atkMult = 1.0
    local critBonus = 0.10
    local shieldPct = 0.0
    local lifesteal = 0.0
    for elem, count in pairs(counts) do
        if count >= 2 then
            local bonus = SYNERGY_BONUSES[elem]
            if bonus then
                table.insert(active, elem .. " x" .. count)
                atkMult = atkMult * bonus.atkMult
                critBonus = critBonus + bonus.critBonus
                shieldPct = shieldPct + bonus.shieldPct
                lifesteal = lifesteal + bonus.lifesteal
            end
        end
    end
    return {
        labels = active,
        atkMult = atkMult,
        critBonus = math.min(0.65, critBonus),
        shieldPct = shieldPct,
        lifesteal = lifesteal,
    }
end

local function bossPhaseFor(boss)
    local ratio = boss.hp / math.max(1, boss.max_hp)
    local chosen = BOSS_PHASES[1]
    for _, phase in ipairs(BOSS_PHASES) do
        if ratio <= phase.threshold then
            chosen = phase
        end
    end
    return chosen
end

local function startBattle(player, floorNum)
    local floor = math.clamp(math.floor(floorNum), 1, 200)
    local team = buildPlayerTeam(player)
    local syn = computeSynergies(team)
    for _, unit in ipairs(team) do
        unit.shield = math.floor(unit.max_hp * syn.shieldPct)
    end
    local elements = { "Flame", "Void", "Storm", "Shadow", "Arcane" }
    local bossElement = elements[((floor - 1) % #elements) + 1]
    local isRaidBoss = (floor % 5 == 0)
    local bossHp = math.floor((900 + floor * 260) * (if isRaidBoss then BOSS_HP_SCALE else 1))
    local bossAtk = math.floor(140 + floor * 28)

    local state = {
        floor = floor,
        turn = 1,
        auto = false,
        ultGauge = 35,
        counterUntil = 0,
        synergy = syn,
        team = team,
        boss = {
            title = if isRaidBoss then ("Impossible Overlord F" .. floor) else ("Tower Guardian F" .. floor),
            element = bossElement,
            hp = bossHp,
            max_hp = bossHp,
            atk = bossAtk,
            speed = 86 + (floor % 15),
            burnTurns = 0,
            stunned = false,
            phase = BOSS_PHASES[1].title,
        },
        finished = false,
    }
    battles[player] = state
    battleEvent:FireClient(player, "started", state)
end

local function stepTurn(player, mode)
    local state = battles[player]
    if not state or state.finished then
        return
    end
    local log = {}
    local syn = state.synergy
    local boss = state.boss
    local phase = bossPhaseFor(boss)
    boss.phase = phase.title

    -- Sort living player units by Speed initiative
    local order = {}
    for _, unit in ipairs(state.team) do
        if unit.hp > 0 then
            table.insert(order, unit)
        end
    end
    table.sort(order, function(a, b)
        return a.speed > b.speed
    end)

    local useUltimate = (mode == "ultimate" and state.ultGauge >= ULTIMATE_MAX)
    if useUltimate then
        state.ultGauge = 0
        table.insert(log, "ULTIMATE BURST unleashed!")
    end

    for _, unit in ipairs(order) do
        if boss.hp <= 0 then
            break
        end
        local elemMult = if ELEMENT_ADVANTAGE[unit.element] == boss.element then 1.25 else 1.0
        local isCrit = rng:NextNumber() <= syn.critBonus
        local critMult = if isCrit then 1.65 else 1.0
        local ultMult = if useUltimate then 2.8 else 1.0
        local dmg = math.max(1, math.floor(unit.atk * syn.atkMult * elemMult * critMult * ultMult))
        boss.hp = math.max(0, boss.hp - dmg)
        state.ultGauge = math.min(ULTIMATE_MAX, state.ultGauge + 18)

        if syn.lifesteal > 0 then
            local heal = math.floor(dmg * syn.lifesteal)
            unit.hp = math.min(unit.max_hp, unit.hp + heal)
        end
        if useUltimate and unit.element == "Void" then
            boss.stunned = true
        elseif useUltimate and unit.element == "Flame" then
            boss.burnTurns = 2
        end
        table.insert(log, unit.title .. " dealt " .. dmg .. (if isCrit then " CRIT" else "") .. " (" .. unit.element .. ")")
    end

    -- Apply Burn DoT
    if boss.hp > 0 and boss.burnTurns > 0 then
        local burnDmg = math.max(25, math.floor(boss.max_hp * 0.04))
        boss.hp = math.max(0, boss.hp - burnDmg)
        boss.burnTurns = boss.burnTurns - 1
        table.insert(log, "Burn seared boss for " .. burnDmg)
    end

    -- Boss counter-attack if alive
    if boss.hp > 0 then
        if boss.stunned then
            boss.stunned = false
            table.insert(log, boss.title .. " was STUNNED and skipped turn!")
        else
            local living = {}
            for _, unit in ipairs(state.team) do
                if unit.hp > 0 then
                    table.insert(living, unit)
                end
            end
            if #living > 0 then
                local target = living[rng:NextInteger(1, #living)]
                local rawDmg = math.floor(boss.atk * phase.atkMult)
                local counterActive = os.clock() <= state.counterUntil
                if counterActive then
                    rawDmg = math.floor(rawDmg * 0.35)
                    local reflect = math.floor(boss.atk * 0.8)
                    boss.hp = math.max(0, boss.hp - reflect)
                    target.shield = target.shield + math.floor(target.max_hp * 0.12)
                    table.insert(log, "ACTIVE COUNTER deflected strike & reflected " .. reflect .. " DMG!")
                end
                local absorbed = math.min(target.shield, rawDmg)
                target.shield = target.shield - absorbed
                local rem = rawDmg - absorbed
                target.hp = math.max(0, target.hp - rem)
                state.ultGauge = math.min(ULTIMATE_MAX, state.ultGauge + 12)
                table.insert(log, boss.title .. " hit " .. target.title .. " for " .. rem .. " (" .. phase.title .. ")")
            end
        end
    end

    state.turn = state.turn + 1
    local anyAlive = false
    for _, unit in ipairs(state.team) do
        if unit.hp > 0 then
            anyAlive = true
            break
        end
    end

    if boss.hp <= 0 then
        state.finished = true
        local reward = 100 + state.floor * 35
        awardCoins(player, reward)
        towerClearSignal:Fire(player, state.floor)
        battleEvent:FireClient(player, "victory", { state = state, reward = reward, log = log })
    elseif not anyAlive then
        state.finished = true
        battleEvent:FireClient(player, "defeat", { state = state, log = log })
    else
        battleEvent:FireClient(player, "turn", { state = state, log = log })
    end
end

battleEvent.OnServerEvent:Connect(function(player, action, floorArg)
    local now = os.clock()
    if lastAction[player] and (now - lastAction[player]) < 0.2 then
        return
    end
    lastAction[player] = now
    if typeof(action) ~= "string" then
        return
    end
    if action == "start_raid" then
        local floorNum = 1
        if typeof(floorArg) == "number" and floorArg == floorArg then
            floorNum = floorArg
        end
        startBattle(player, floorNum)
    elseif action == "attack" or action == "ultimate" then
        stepTurn(player, action)
    elseif action == "counter" then
        local state = battles[player]
        if state and not state.finished then
            state.counterUntil = os.clock() + COUNTER_WINDOW_SEC
            battleEvent:FireClient(player, "counter_ready", { window_sec = COUNTER_WINDOW_SEC })
        end
    elseif action == "toggle_auto" then
        local state = battles[player]
        if state and not state.finished then
            state.auto = not state.auto
            battleEvent:FireClient(player, "auto_state", { auto = state.auto })
        end
    elseif action == "retreat" then
        battles[player] = nil
        battleEvent:FireClient(player, "retreated", {})
    end
end)

Players.PlayerAdded:Connect(function(player)
    task.spawn(function()
        while player.Parent do
            task.wait(0.85)
            local st = battles[player]
            if st and st.auto and not st.finished then
                local mode = if st.ultGauge >= ULTIMATE_MAX then "ultimate" else "attack"
                stepTurn(player, mode)
            end
        end
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    battles[player] = nil
    lastAction[player] = nil
end)
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX0000002A">
      <Properties>
        <string name="Name">CardGachaRoller</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[-- CardGachaRoller -- generated by OpenRO (system: card_gacha_roller)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local BASE_LUCK = 100 / 100
local PITY_THRESHOLD = 50
local FAST_ROLL_SEC = 350 / 1000
local ENABLE_BORDERS = true

local rollFunction = ReplicatedStorage:FindFirstChild("OpenROCardRoll")
if not rollFunction then
    rollFunction = Instance.new("RemoteFunction")
    rollFunction.Name = "OpenROCardRoll"
    rollFunction.Parent = ReplicatedStorage
end

local rollEvent = ReplicatedStorage:FindFirstChild("OpenROCardRollEvent")
if not rollEvent then
    rollEvent = Instance.new("RemoteEvent")
    rollEvent.Name = "OpenROCardRollEvent"
    rollEvent.Parent = ReplicatedStorage
end

local weatherLuckVal = ReplicatedStorage:FindFirstChild("ActiveWeatherLuck")
if not weatherLuckVal then
    weatherLuckVal = Instance.new("NumberValue")
    weatherLuckVal.Name = "ActiveWeatherLuck"
    weatherLuckVal.Value = 1.0
    weatherLuckVal.Parent = ReplicatedStorage
end

local cardGranted = ServerStorage:FindFirstChild("OpenROCardGranted")
if not cardGranted then
    cardGranted = Instance.new("BindableEvent")
    cardGranted.Name = "OpenROCardGranted"
    cardGranted.Parent = ServerStorage
end

-- 7 rarity tiers (Common -> Secret) aligned with Apex Card roster
local RARITY_TIERS = {
    { name = "Secret", weight = 1, denom = 8192 },
    { name = "Celestial", weight = 4, denom = 2048 },
    { name = "Mythic", weight = 16, denom = 512 },
    { name = "Legendary", weight = 64, denom = 128 },
    { name = "Epic", weight = 256, denom = 32 },
    { name = "Rare", weight = 1024, denom = 8 },
    { name = "Common", weight = 4096, denom = 2 },
}

local BORDER_VARIANTS = {
    { name = "Void", chance = 0.008, mult = 2.75 },
    { name = "Rainbow", chance = 0.025, mult = 2.0 },
    { name = "Gold", chance = 0.075, mult = 1.5 },
    { name = "Shiny", chance = 0.18, mult = 1.25 },
    { name = "Normal", chance = 1.0, mult = 1.0 },
}

local CARD_POOL = {
    Secret = {
        { id = "supernova-ascended-striker", title = "Supernova Ascended Striker", element = "Flame", atk = 680, hp = 2100, speed = 98 },
    },
    Celestial = {
        { id = "infinity-void-sorcerer", title = "Infinity Void Sorcerer", element = "Void", atk = 540, hp = 1720, speed = 96 },
        { id = "shadow-sovereign", title = "Shadow Sovereign", element = "Shadow", atk = 560, hp = 1650, speed = 94 },
    },
    Mythic = {
        { id = "crimson-sea-captain", title = "Crimson Sea Captain", element = "Flame", atk = 420, hp = 1480, speed = 88 },
        { id = "nine-tail-ember-shinobi", title = "Nine-Tail Ember Shinobi", element = "Flame", atk = 440, hp = 1520, speed = 92 },
    },
    Legendary = {
        { id = "thunder-flash-ronin", title = "Thunder Flash Ronin", element = "Storm", atk = 360, hp = 1150, speed = 100 },
    },
    Epic = {
        { id = "blood-moon-gravity-ronin", title = "Blood-Moon Gravity Ronin", element = "Void", atk = 295, hp = 1080, speed = 84 },
    },
    Rare = {
        { id = "eclipse-arcane-alchemist", title = "Eclipse Arcane Alchemist", element = "Arcane", atk = 230, hp = 960, speed = 80 },
    },
    Common = {
        { id = "ember-acolyte", title = "Ember Acolyte", element = "Flame", atk = 115, hp = 520, speed = 72 },
        { id = "storm-scout", title = "Storm Scout", element = "Storm", atk = 120, hp = 490, speed = 78 },
        { id = "void-initiate", title = "Void Initiate", element = "Void", atk = 110, hp = 540, speed = 70 },
        { id = "shadow-blade", title = "Shadow Blade", element = "Shadow", atk = 125, hp = 470, speed = 76 },
        { id = "arcane-scribe", title = "Arcane Scribe", element = "Arcane", atk = 105, hp = 560, speed = 68 },
    },
}

local rng = Random.new()
local playerState = {}

local function getState(player)
    local st = playerState[player]
    if not st then
        st = {
            rolls = 0,
            pity = 0,
            autoRoll = false,
            lastRollAt = 0,
        }
        playerState[player] = st
    end
    return st
end

local function effectiveLuck(player)
    local potionLuck = player:GetAttribute("PotionLuckMult")
    if typeof(potionLuck) ~= "number" or potionLuck < 1 then
        potionLuck = 1
    end
    local rebirths = player:GetAttribute("Rebirths")
    if typeof(rebirths) ~= "number" or rebirths < 0 then
        rebirths = 0
    end
    local weatherMult = 1
    if weatherLuckVal and weatherLuckVal:IsA("NumberValue") and weatherLuckVal.Value > 0 then
        weatherMult = weatherLuckVal.Value
    end
    return BASE_LUCK * potionLuck * weatherMult * (1 + rebirths * 0.35)
end

local function rollBorder(luck)
    if not ENABLE_BORDERS then
        return "Normal", 1.0
    end
    local draw = rng:NextNumber()
    for _, variant in ipairs(BORDER_VARIANTS) do
        local threshold = math.min(0.95, variant.chance * math.sqrt(luck))
        if variant.name == "Normal" or draw <= threshold then
            return variant.name, variant.mult
        end
    end
    return "Normal", 1.0
end

local function rollRarity(st, luck)
    if st.pity >= PITY_THRESHOLD * 2 then
        st.pity = 0
        return "Celestial"
    end
    if st.pity >= PITY_THRESHOLD then
        st.pity = 0
        return "Mythic"
    end
    for _, tier in ipairs(RARITY_TIERS) do
        if tier.name == "Common" then
            return "Common"
        end
        local odds = math.min(0.65, luck / tier.denom)
        if rng:NextNumber() <= odds then
            if tier.name == "Mythic" or tier.name == "Celestial" or tier.name == "Secret" then
                st.pity = 0
            end
            return tier.name
        end
    end
    return "Common"
end

local function performRoll(player, fastMode)
    local st = getState(player)
    local now = os.clock()
    local speedMult = player:GetAttribute("PotionSpeedMult")
    if typeof(speedMult) ~= "number" or speedMult < 1 then
        speedMult = 1
    end
    local minDelay = (if fastMode then FAST_ROLL_SEC else FAST_ROLL_SEC * 1.6) / speedMult
    if (now - st.lastRollAt) < minDelay then
        return { ok = false, reason = "cooldown" }
    end
    st.lastRollAt = now
    st.rolls = st.rolls + 1
    st.pity = st.pity + 1

    local luck = effectiveLuck(player)
    local rarity = rollRarity(st, luck)
    local pool = CARD_POOL[rarity] or CARD_POOL.Common
    local picked = pool[rng:NextInteger(1, #pool)]
    local borderName, borderMult = rollBorder(luck)

    local result = {
        ok = true,
        card_id = picked.id,
        title = picked.title,
        rarity = rarity,
        element = picked.element,
        border = borderName,
        border_mult = borderMult,
        atk = math.floor(picked.atk * borderMult),
        hp = math.floor(picked.hp * borderMult),
        speed = picked.speed,
        pity = st.pity,
        pity_max = PITY_THRESHOLD,
        luck = luck,
        total_rolls = st.rolls,
    }

    player:SetAttribute("TotalRolls", st.rolls)
    player:SetAttribute("PityCount", st.pity)
    cardGranted:Fire(player, result)
    rollEvent:FireClient(player, "rolled", result)
    return result
end

rollFunction.OnServerInvoke = function(player, action)
    if typeof(action) ~= "string" then
        return { ok = false, reason = "invalid_action" }
    end
    if action == "roll" then
        return performRoll(player, false)
    elseif action == "fast_roll" then
        return performRoll(player, true)
    elseif action == "auto_toggle" then
        local st = getState(player)
        st.autoRoll = not st.autoRoll
        player:SetAttribute("AutoRollEnabled", st.autoRoll)
        return { ok = true, auto_roll = st.autoRoll }
    elseif action == "status" then
        local st = getState(player)
        return {
            ok = true,
            pity = st.pity,
            pity_max = PITY_THRESHOLD,
            luck = effectiveLuck(player),
            auto_roll = st.autoRoll,
            total_rolls = st.rolls,
        }
    end
    return { ok = false, reason = "unknown_action" }
end

Players.PlayerAdded:Connect(function(player)
    local st = getState(player)
    player:SetAttribute("TotalRolls", st.rolls)
    player:SetAttribute("PityCount", st.pity)
    player:SetAttribute("AutoRollEnabled", false)
    task.spawn(function()
        while player.Parent do
            task.wait(math.max(0.25, FAST_ROLL_SEC))
            local cur = playerState[player]
            if cur and cur.autoRoll then
                performRoll(player, true)
            end
        end
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    playerState[player] = nil
end)
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX0000002B">
      <Properties>
        <string name="Name">CardGalleryWorld</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[-- CardGalleryWorld -- generated by OpenRO (system: card_gallery_world)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LOBBY_NAME = "ApexLobby"
local SHOWCASE_COUNT = 8
local ENABLE_HOLOGRAMS = true

local SHOWCASE_CARDS = {
    { id = "supernova-ascended-striker", title = "Supernova Ascended Striker", rarity = "Secret", odds = "1/8,192", color = Color3.fromRGB(255, 196, 60) },
    { id = "infinity-void-sorcerer", title = "Infinity Void Sorcerer", rarity = "Celestial", odds = "1/2,048", color = Color3.fromRGB(168, 85, 247) },
    { id = "shadow-sovereign", title = "Shadow Sovereign", rarity = "Celestial", odds = "1/2,048", color = Color3.fromRGB(99, 102, 241) },
    { id = "crimson-sea-captain", title = "Crimson Sea Captain", rarity = "Mythic", odds = "1/512", color = Color3.fromRGB(235, 83, 42) },
    { id = "nine-tail-ember-shinobi", title = "Nine-Tail Ember Shinobi", rarity = "Mythic", odds = "1/512", color = Color3.fromRGB(249, 115, 22) },
    { id = "thunder-flash-ronin", title = "Thunder Flash Ronin", rarity = "Legendary", odds = "1/128", color = Color3.fromRGB(56, 189, 248) },
    { id = "blood-moon-gravity-ronin", title = "Blood-Moon Gravity Ronin", rarity = "Epic", odds = "1/32", color = Color3.fromRGB(192, 38, 211) },
    { id = "eclipse-arcane-alchemist", title = "Eclipse Arcane Alchemist", rarity = "Rare", odds = "1/8", color = Color3.fromRGB(52, 211, 153) },
}

local lobby = workspace:FindFirstChild("ApexLobby")
if not lobby then
    lobby = Instance.new("Folder")
    lobby.Name = "ApexLobby"
    lobby.Parent = workspace
end

local function makeLandmark(name, size, pos, color, material)
    local existing = lobby:FindFirstChild(name)
    if existing then
        return existing
    end
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.Position = pos
    part.Anchored = true
    part.CanCollide = true
    part.Color = color
    part.Material = material
    part.Parent = lobby
    return part
end

-- Spawn Courtyard
makeLandmark("SpawnCourtyard", Vector3.new(96, 1, 96), Vector3.new(0, 0, 0), Color3.fromRGB(38, 42, 54), Enum.Material.Marble)

-- Holographic Roll Pedestal
local rollPedestal = makeLandmark("RollPedestal", Vector3.new(10, 2, 10), Vector3.new(0, 1.5, -14), Color3.fromRGB(79, 124, 240), Enum.Material.Neon)
local holoRing = makeLandmark("HoloRing", Vector3.new(6, 0.6, 6), Vector3.new(0, 6, -14), Color3.fromRGB(168, 85, 247), Enum.Material.Neon)
holoRing.CanCollide = false

-- Tower Portal Gate, Boss Raid Shrine, Potion Alchemist Stand, Leaderboard Wall
makeLandmark("TowerPortalGate", Vector3.new(12, 14, 2), Vector3.new(-28, 7.5, -24), Color3.fromRGB(56, 189, 248), Enum.Material.Neon)
makeLandmark("BossRaidShrine", Vector3.new(12, 10, 8), Vector3.new(28, 5.5, -24), Color3.fromRGB(224, 83, 42), Enum.Material.Slate)
makeLandmark("PotionAlchemistStand", Vector3.new(10, 5, 6), Vector3.new(-28, 3, 12), Color3.fromRGB(60, 179, 113), Enum.Material.WoodPlanks)
local boardWall = makeLandmark("LeaderboardWall", Vector3.new(18, 10, 1.5), Vector3.new(28, 5.5, 12), Color3.fromRGB(30, 34, 46), Enum.Material.SmoothPlastic)

-- 3D Card Showcase Billboards bound to Decal & ImageLabel artwork slots
local galleryFolder = lobby:FindFirstChild("CardShowcases")
if not galleryFolder then
    galleryFolder = Instance.new("Folder")
    galleryFolder.Name = "CardShowcases"
    galleryFolder.Parent = lobby
end

for i = 1, SHOWCASE_COUNT do
    local card = SHOWCASE_CARDS[((i - 1) % #SHOWCASE_CARDS) + 1]
    local standName = "Showcase_" .. card.id
    if not galleryFolder:FindFirstChild(standName) then
        local stand = Instance.new("Part")
        stand.Name = standName
        stand.Size = Vector3.new(6, 8.5, 0.8)
        stand.Position = Vector3.new((i - (SHOWCASE_COUNT + 1) / 2) * 8.5, 5, 28)
        stand.Anchored = true
        stand.Material = Enum.Material.SmoothPlastic
        stand.Color = card.color
        stand:SetAttribute("CardId", card.id)

        local decal = Instance.new("Decal")
        decal.Name = "CardArtDecal"
        decal.Face = Enum.NormalId.Front
        decal.Texture = "rbxasset://openro-assets/" .. card.id .. ".png"
        decal.Parent = stand

        local gui = Instance.new("SurfaceGui")
        gui.Name = "CardInfoGui"
        gui.Face = Enum.NormalId.Front
        local img = Instance.new("ImageLabel")
        img.Name = "CardArtImage"
        img.Size = UDim2.new(1, 0, 0.78, 0)
        img.BackgroundTransparency = 1
        img.Image = "rbxasset://openro-assets/" .. card.id .. ".png"
        img.Parent = gui

        local title = Instance.new("TextLabel")
        title.Name = "CardCaption"
        title.Size = UDim2.new(1, 0, 0.22, 0)
        title.Position = UDim2.new(0, 0, 0.78, 0)
        title.BackgroundTransparency = 0.2
        title.TextColor3 = Color3.fromRGB(255, 255, 255)
        title.TextScaled = true
        title.Text = card.title .. " [" .. card.rarity .. " " .. card.odds .. "]"
        title.Parent = gui
        gui.Parent = stand

        local glow = Instance.new("PointLight")
        glow.Color = card.color
        glow.Range = 14
        glow.Brightness = 1.4
        glow.Parent = stand
        stand.Parent = galleryFolder
    end
end

-- Live Leaderboard SurfaceGui on LeaderboardWall
if not boardWall:FindFirstChild("TowerLeaderboardGui") then
    local lbGui = Instance.new("SurfaceGui")
    lbGui.Name = "TowerLeaderboardGui"
    local lbText = Instance.new("TextLabel")
    lbText.Name = "Rankings"
    lbText.Size = UDim2.new(1, 0, 1, 0)
    lbText.BackgroundTransparency = 0.15
    lbText.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbText.TextScaled = true
    lbText.Text = "APEX TOWER LEADERBOARD"
    lbText.Parent = lbGui
    lbGui.Parent = boardWall

    task.spawn(function()
        while boardWall.Parent do
            local lines = { "APEX TOWER LEADERBOARD" }
            for _, p in ipairs(Players:GetPlayers()) do
                local floor = p:GetAttribute("TowerFloor") or 1
                table.insert(lines, p.Name .. " - Floor " .. tostring(floor))
            end
            lbText.Text = table.concat(lines, "\n")
            task.wait(5)
        end
    end)
end

if ENABLE_HOLOGRAMS and rollPedestal and holoRing then
    local t = 0
    local basePos = holoRing.Position
    RunService.Heartbeat:Connect(function(dt)
        if not holoRing.Parent then
            return
        end
        t = t + dt
        local bob = math.sin(t * 2.2) * 0.75
        holoRing.CFrame = CFrame.new(basePos + Vector3.new(0, bob, 0)) * CFrame.Angles(0, t * 1.4, 0)
    end)
end
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX0000002C">
      <Properties>
        <string name="Name">DataStoreSave</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[-- DataStoreSave -- generated by OpenRO (Rune skill: datastore_save)
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")

local STORE_NAME = "OpenROApexEconomy_v1"
local STAT_NAME = "Coins"
local DEFAULT_VALUE = 250
local AUTOSAVE_SECONDS = 60
local store = DataStoreService:GetDataStore(STORE_NAME)

local function withRetry(fn, attempts)
    local maxTries = attempts or 3
    for attempt = 1, maxTries do
        local ok, result = pcall(fn)
        if ok then
            return true, result
        end
        if attempt < maxTries then
            task.wait(2 ^ attempt)
        end
    end
    return false, nil
end

local function savePlayer(player)
    if player:GetAttribute("DataLoaded") ~= true then
        return
    end
    local stats = player:FindFirstChild("leaderstats")
    local stat = stats and stats:FindFirstChild(STAT_NAME)
    if not stat then
        return
    end
    local key = "Player_" .. player.UserId
    local payload = { value = stat.Value, updatedAt = os.time() }
    local ok, err = withRetry(function()
        return store:UpdateAsync(key, function(_old)
            return payload
        end)
    end, 3)
    if not ok then
        warn("DataStore save failed for " .. player.Name .. ": " .. tostring(err))
    end
end

local function onPlayerAdded(player)
    local stats = player:FindFirstChild("leaderstats")
    if not stats then
        stats = Instance.new("Folder")
        stats.Name = "leaderstats"
        stats.Parent = player
    end
    local stat = stats:FindFirstChild(STAT_NAME)
    if not stat then
        stat = Instance.new("IntValue")
        stat.Name = STAT_NAME
        stat.Value = DEFAULT_VALUE
        stat.Parent = stats
    end
    local key = "Player_" .. player.UserId
    local ok, data = withRetry(function()
        return store:GetAsync(key)
    end, 3)
    if not ok then
        warn("DataStore load failed for " .. player.Name)
        player:SetAttribute("DataLoaded", false)
        return
    end
    player:SetAttribute("DataLoaded", true)
    if typeof(data) == "table" and typeof(data.value) == "number" then
        stat.Value = math.floor(data.value)
    elseif typeof(data) == "number" then
        stat.Value = math.floor(data)
    else
        stat.Value = DEFAULT_VALUE
    end
    task.spawn(function()
        while player.Parent do
            task.wait(AUTOSAVE_SECONDS)
            if player.Parent then
                savePlayer(player)
            end
        end
    end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(savePlayer)
for _, existing in ipairs(Players:GetPlayers()) do
    task.spawn(onPlayerAdded, existing)
end

game:BindToClose(function()
    local active = Players:GetPlayers()
    local remaining = #active
    if remaining == 0 then
        return
    end
    for _, player in ipairs(active) do
        task.spawn(function()
            savePlayer(player)
            remaining = remaining - 1
        end)
    end
    local deadline = os.clock() + 25
    while remaining > 0 and os.clock() < deadline do
        task.wait(0.1)
    end
end)
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX0000002D">
      <Properties>
        <string name="Name">DeckBuilder</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[-- DeckBuilder -- generated by OpenRO (system: deck_builder)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local DataStoreService = game:GetService("DataStoreService")

local DECK_SLOTS = 6
local FUSION_COST = 3
local REBIRTH_FLOOR = 10
local STORE_NAME = "OpenROApexDecks_v1"
local store = DataStoreService:GetDataStore(STORE_NAME)

local deckEvent = ReplicatedStorage:FindFirstChild("OpenRODeckAction")
if not deckEvent then
    deckEvent = Instance.new("RemoteEvent")
    deckEvent.Name = "OpenRODeckAction"
    deckEvent.Parent = ReplicatedStorage
end

local cardGranted = ServerStorage:FindFirstChild("OpenROCardGranted")
if not cardGranted then
    cardGranted = Instance.new("BindableEvent")
    cardGranted.Name = "OpenROCardGranted"
    cardGranted.Parent = ServerStorage
end

local deckQuery = ServerStorage:FindFirstChild("OpenRODeckSnapshot")
if not deckQuery then
    deckQuery = Instance.new("BindableFunction")
    deckQuery.Name = "OpenRODeckSnapshot"
    deckQuery.Parent = ServerStorage
end

local profiles = {}
local lastAction = {}

local function withRetry(fn, attempts)
    local maxTries = attempts or 3
    for attempt = 1, maxTries do
        local ok, result = pcall(fn)
        if ok then
            return true, result
        end
        if attempt < maxTries then
            task.wait(2 ^ attempt)
        end
    end
    return false, nil
end

local function cardPower(card)
    local starMult = 1 + ((card.stars or 1) - 1) * 0.25
    local borderMult = card.border_mult or 1.0
    return math.floor(((card.atk or 100) * 1.4 + (card.hp or 500) * 0.35) * starMult * borderMult)
end

local function recomputeBonuses(player, profile)
    local uniqueCount = 0
    for _ in pairs(profile.index) do
        uniqueCount = uniqueCount + 1
    end
    local indexBonusPct = uniqueCount * 3
    local rebirthBonusPct = profile.rebirths * 20
    player:SetAttribute("CollectionUniqueCount", uniqueCount)
    player:SetAttribute("CollectionBonusPct", indexBonusPct)
    player:SetAttribute("Rebirths", profile.rebirths)
    player:SetAttribute("RebirthPowerPct", rebirthBonusPct)
    player:SetAttribute("EquippedDeckSize", #profile.deck)
end

local function syncClient(player)
    local profile = profiles[player]
    if not profile then
        return
    end
    recomputeBonuses(player, profile)
    deckEvent:FireClient(player, "sync", {
        deck = profile.deck,
        owned = profile.owned,
        rebirths = profile.rebirths,
        max_slots = DECK_SLOTS,
        fusion_cost = FUSION_COST,
        rebirth_floor = REBIRTH_FLOOR,
    })
end

local function autoEquipBest(profile)
    local sorted = {}
    for _, card in ipairs(profile.owned) do
        table.insert(sorted, card)
    end
    table.sort(sorted, function(a, b)
        return cardPower(a) > cardPower(b)
    end)
    profile.deck = {}
    local seen = {}
    for _, card in ipairs(sorted) do
        if #profile.deck >= DECK_SLOTS then
            break
        end
        if not seen[card.card_id] then
            seen[card.card_id] = true
            table.insert(profile.deck, card.card_id)
        end
    end
end

local function grantCard(player, cardData)
    local profile = profiles[player]
    if not profile or typeof(cardData) ~= "table" or typeof(cardData.card_id) ~= "string" then
        return
    end
    profile.index[cardData.card_id] = true
    local existing = nil
    for _, entry in ipairs(profile.owned) do
        if entry.card_id == cardData.card_id then
            existing = entry
            break
        end
    end
    if existing then
        existing.copies = (existing.copies or 1) + 1
        if (cardData.border_mult or 1.0) > (existing.border_mult or 1.0) then
            existing.border = cardData.border or existing.border
            existing.border_mult = cardData.border_mult
            existing.atk = cardData.atk or existing.atk
            existing.hp = cardData.hp or existing.hp
        end
    else
        table.insert(profile.owned, {
            card_id = cardData.card_id,
            title = cardData.title or cardData.card_id,
            rarity = cardData.rarity or "Common",
            element = cardData.element or "Flame",
            border = cardData.border or "Normal",
            border_mult = cardData.border_mult or 1.0,
            atk = cardData.atk or 120,
            hp = cardData.hp or 500,
            speed = cardData.speed or 75,
            stars = 1,
            copies = 1,
        })
        if #profile.deck < DECK_SLOTS then
            table.insert(profile.deck, cardData.card_id)
        end
    end
    syncClient(player)
end

cardGranted.Event:Connect(grantCard)

deckQuery.OnInvoke = function(player)
    local profile = profiles[player]
    if not profile then
        return { deck = {}, owned = {}, rebirths = 0 }
    end
    return profile
end

local function saveProfile(player)
    if player:GetAttribute("DeckDataLoaded") ~= true then
        return
    end
    local profile = profiles[player]
    if not profile then
        return
    end
    local key = "Deck_" .. player.UserId
    local snapshot = {
        deck = profile.deck,
        owned = profile.owned,
        index = profile.index,
        rebirths = profile.rebirths,
    }
    local ok, err = withRetry(function()
        return store:UpdateAsync(key, function(_old)
            return snapshot
        end)
    end, 3)
    if not ok then
        warn("DeckBuilder save failed for " .. player.Name .. ": " .. tostring(err))
    end
end

local function defaultProfile()
    return {
        deck = { "eclipse-arcane-alchemist" },
        owned = {
            {
                card_id = "eclipse-arcane-alchemist",
                title = "Eclipse Arcane Alchemist",
                rarity = "Rare",
                element = "Arcane",
                border = "Normal",
                border_mult = 1.0,
                atk = 230,
                hp = 960,
                speed = 80,
                stars = 1,
                copies = 1,
            },
        },
        index = { ["eclipse-arcane-alchemist"] = true },
        rebirths = 0,
    }
end

local function onPlayerAdded(player)
    local key = "Deck_" .. player.UserId
    local ok, saved = withRetry(function()
        return store:GetAsync(key)
    end, 3)
    if not ok then
        warn("DeckBuilder load failed for " .. player.Name)
        player:SetAttribute("DeckDataLoaded", false)
        profiles[player] = defaultProfile()
        syncClient(player)
        return
    end
    player:SetAttribute("DeckDataLoaded", true)
    if typeof(saved) == "table" and typeof(saved.owned) == "table" then
        profiles[player] = {
            deck = typeof(saved.deck) == "table" and saved.deck or {},
            owned = saved.owned,
            index = typeof(saved.index) == "table" and saved.index or {},
            rebirths = typeof(saved.rebirths) == "number" and math.max(0, math.floor(saved.rebirths)) or 0,
        }
    else
        profiles[player] = defaultProfile()
    end
    syncClient(player)
end

deckEvent.OnServerEvent:Connect(function(player, action, cardId)
    local now = os.clock()
    if lastAction[player] and (now - lastAction[player]) < 0.25 then
        return
    end
    lastAction[player] = now
    if typeof(action) ~= "string" then
        return
    end
    local profile = profiles[player]
    if not profile then
        return
    end
    if action == "sync" then
        syncClient(player)
        return
    elseif action == "auto_equip" then
        autoEquipBest(profile)
        syncClient(player)
        return
    elseif action == "rebirth" then
        local floor = player:GetAttribute("TowerFloor") or 1
        if typeof(floor) == "number" and floor >= REBIRTH_FLOOR then
            profile.rebirths = profile.rebirths + 1
            player:SetAttribute("TowerFloor", 1)
            syncClient(player)
        end
        return
    end
    if typeof(cardId) ~= "string" or #cardId == 0 or #cardId > 64 then
        return
    end
    local target = nil
    for _, entry in ipairs(profile.owned) do
        if entry.card_id == cardId then
            target = entry
            break
        end
    end
    if not target then
        return
    end
    if action == "equip" then
        for _, id in ipairs(profile.deck) do
            if id == cardId then
                return
            end
        end
        if #profile.deck < DECK_SLOTS then
            table.insert(profile.deck, cardId)
            syncClient(player)
        end
    elseif action == "unequip" then
        for idx, id in ipairs(profile.deck) do
            if id == cardId then
                table.remove(profile.deck, idx)
                syncClient(player)
                return
            end
        end
    elseif action == "fuse" then
        if (target.stars or 1) < 5 and (target.copies or 1) >= (FUSION_COST + 1) then
            target.copies = target.copies - FUSION_COST
            target.stars = (target.stars or 1) + 1
            target.atk = math.floor(target.atk * 1.25)
            target.hp = math.floor(target.hp * 1.25)
            syncClient(player)
        end
    end
end)

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(player)
    saveProfile(player)
    profiles[player] = nil
    lastAction[player] = nil
end)
for _, existing in ipairs(Players:GetPlayers()) do
    task.spawn(onPlayerAdded, existing)
end

game:BindToClose(function()
    local active = Players:GetPlayers()
    local remaining = #active
    if remaining == 0 then
        return
    end
    for _, player in ipairs(active) do
        task.spawn(function()
            saveProfile(player)
            remaining = remaining - 1
        end)
    end
    local deadline = os.clock() + 25
    while remaining > 0 and os.clock() < deadline do
        task.wait(0.1)
    end
end)
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX0000002E">
      <Properties>
        <string name="Name">JumpPadInCardLobby</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[-- JumpPad -- generated by OpenRO (Rune skill: jump_pad)
local Players = game:GetService("Players")

local BOOST_POWER = 120
local COOLDOWN_SEC = 600 / 1000

local pad = workspace:FindFirstChild("JumpPad")
if not pad then
    pad = Instance.new("Part")
    pad.Name = "JumpPad"
    pad.Size = Vector3.new(8, 1, 8)
    pad.Position = Vector3.new(0, 1, 16)
    pad.Anchored = true
    pad.CanCollide = true
    pad.Material = Enum.Material.Neon
    pad.Color = Color3.fromRGB(60, 179, 113)
    pad.Parent = workspace
end

local emitter = pad:FindFirstChildOfClass("ParticleEmitter")
if not emitter then
    emitter = Instance.new("ParticleEmitter")
    emitter.Name = "BounceFX"
    emitter.Enabled = false
    emitter.Speed = NumberRange.new(12, 24)
    emitter.Lifetime = NumberRange.new(0.3, 0.6)
    emitter.Color = ColorSequence.new(Color3.fromRGB(110, 255, 170))
    emitter.Parent = pad
end

local bounceSound = pad:FindFirstChildOfClass("Sound")
if not bounceSound then
    bounceSound = Instance.new("Sound")
    bounceSound.Name = "BounceSound"
    bounceSound.SoundId = "rbxassetid://12222200"
    bounceSound.Volume = 0.5
    bounceSound.Parent = pad
end

local lastBounce = {}

pad.Touched:Connect(function(hit)
    local character = hit.Parent
    local player = character and Players:GetPlayerFromCharacter(character)
    if not player then
        return
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or humanoid.Health <= 0 then
        return
    end
    local now = os.clock()
    if lastBounce[player] and (now - lastBounce[player]) < COOLDOWN_SEC then
        return
    end
    lastBounce[player] = now
    local currentVel = root.AssemblyLinearVelocity
    root.AssemblyLinearVelocity = Vector3.new(currentVel.X, BOOST_POWER, currentVel.Z)
    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    emitter:Emit(16)
    bounceSound:Play()
end)

Players.PlayerRemoving:Connect(function(player)
    lastBounce[player] = nil
end)
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX0000002F">
      <Properties>
        <string name="Name">Leaderboard</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[-- Leaderboard -- generated by OpenRO (Rune skill: leaderboard)
local Players = game:GetService("Players")

local function onPlayerAdded(player)
    local stats = Instance.new("Folder")
    stats.Name = "leaderstats"
    local stat = Instance.new("IntValue")
    stat.Name = "Coins"
    stat.Value = 250
    stat.Parent = stats
