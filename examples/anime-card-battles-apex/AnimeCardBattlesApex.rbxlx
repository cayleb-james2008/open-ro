        <ProtectedString name="Source"><![CDATA[-- GameGui -- generated by OpenRO (Rune skill: game_gui)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "GameGui"
gui.Parent = player:WaitForChild("PlayerGui")

local title = Instance.new("TextLabel")
title.Name = "Title"
title.Text = "Anime Card Battles: Apex"
title.Size = UDim2.new(0, 320, 0, 48)
title.Position = UDim2.new(0.5, -160, 0, 16)
title.BackgroundTransparency = 0.3
title.Parent = gui

local balance = Instance.new("TextLabel")
balance.Name = "Balance"
balance.Size = UDim2.new(0, 200, 0, 36)
balance.Position = UDim2.new(0, 16, 0, 16)
balance.BackgroundTransparency = 0.3
balance.Parent = gui

local stats = player:WaitForChild("leaderstats")
local stat = stats:WaitForChild("Coins")
local function refresh()
    balance.Text = "Coins: " .. stat.Value
end
stat.Changed:Connect(refresh)
refresh()

local button = Instance.new("TextButton")
button.Name = "ShopButton"
button.Text = "Buy Lucky Charm (250)"
button.Size = UDim2.new(0, 160, 0, 44)
button.Position = UDim2.new(1, -176, 0, 16)
button.Parent = gui
button.MouseButton1Click:Connect(function()
    ReplicatedStorage:WaitForChild("OpenROShopBuy"):FireServer()
end)
]]></ProtectedString>
