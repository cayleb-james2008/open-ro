    <Item class="Script" referent="RBX00000033">
      <Properties>
        <string name="Name">TowerProgression</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source"><![CDATA[-- TowerProgression -- generated by OpenRO (system: tower_progression)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local DataStoreService = game:GetService("DataStoreService")

local MAX_FLOORS = 50
local WORLD_COUNT = 5
local BASE_REWARD = 120
local STORE_NAME = "OpenROTowerBoard_v1"
local towerBoard = DataStoreService:GetOrderedDataStore(STORE_NAME)

local towerEvent = ReplicatedStorage:FindFirstChild("OpenROTowerEvent")
if not towerEvent then
    towerEvent = Instance.new("RemoteEvent")
    towerEvent.Name = "OpenROTowerEvent"
    towerEvent.Parent = ReplicatedStorage
end

local towerClearSignal = ServerStorage:FindFirstChild("OpenROTowerClear")
if not towerClearSignal then
    towerClearSignal = Instance.new("BindableEvent")
    towerClearSignal.Name = "OpenROTowerClear"
    towerClearSignal.Parent = ServerStorage
end

local WORLDS = {
    { name = "Ember Harbor", minFloor = 1, color = Color3.fromRGB(235, 92, 54) },
    { name = "Thunder Spire", minFloor = 11, color = Color3.fromRGB(70, 170, 255) },
    { name = "Eclipse Citadel", minFloor = 21, color = Color3.fromRGB(168, 85, 247) },
    { name = "Shadow Monarch Rift", minFloor = 31, color = Color3.fromRGB(99, 102, 241) },
    { name = "Celestial Apex", minFloor = 41, color = Color3.fromRGB(245, 195, 66) },
}

local worldsFolder = workspace:FindFirstChild("TowerWorlds")
if not worldsFolder then
    worldsFolder = Instance.new("Folder")
    worldsFolder.Name = "TowerWorlds"
    worldsFolder.Parent = workspace
end

for idx = 1, WORLD_COUNT do
    local world = WORLDS[((idx - 1) % #WORLDS) + 1]
    local gateName = "WorldPortal" .. idx
    if not worldsFolder:FindFirstChild(gateName) then
        local pad = Instance.new("Part")
        pad.Name = gateName
        pad.Size = Vector3.new(8, 1, 8)
        pad.Position = Vector3.new((idx - 3) * 16, 1, -48)
        pad.Anchored = true
        pad.CanCollide = true
        pad.Material = Enum.Material.Neon
        pad.Color = world.color

        local billboard = Instance.new("BillboardGui")
        billboard.Size = UDim2.new(0, 220, 0, 52)
        billboard.StudsOffset = Vector3.new(0, 4.5, 0)
        billboard.AlwaysOnTop = true
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 0.25
        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        lbl.TextScaled = true
        lbl.Text = "World " .. idx .. ": " .. world.name .. " (F" .. world.minFloor .. "+)"
        lbl.Parent = billboard
        billboard.Parent = pad
        pad.Parent = worldsFolder
    end
end

local lastRequest = {}

local function ensureTowerStat(player)
    local stats = player:FindFirstChild("leaderstats")
    if not stats then
        stats = Instance.new("Folder")
        stats.Name = "leaderstats"
        stats.Parent = player
    end
    local floorVal = stats:FindFirstChild("TowerFloor")
    if not floorVal then
        floorVal = Instance.new("IntValue")
        floorVal.Name = "TowerFloor"
        floorVal.Value = 1
        floorVal.Parent = stats
    end
    return floorVal
end

local function saveFloor(player)
    local stats = player:FindFirstChild("leaderstats")
    local floorVal = stats and stats:FindFirstChild("TowerFloor")
    if not floorVal then
        return
    end
    local key = "Player_" .. player.UserId
    local best = math.max(1, floorVal.Value)
    pcall(function()
        towerBoard:SetAsync(key, best)
    end)
end

local function fetchTopLeaderboard()
    local top = {}
    local ok, pages = pcall(function()
        return towerBoard:GetSortedAsync(false, 10)
    end)
    if ok and pages then
        for rank, entry in ipairs(pages:GetCurrentPage()) do
            table.insert(top, { rank = rank, key = entry.key, floor = entry.value })
        end
    end
    return top
end

towerClearSignal.Event:Connect(function(player, clearedFloor)
    if typeof(player) ~= "Instance" or not player:IsA("Player") then
        return
    end
    if typeof(clearedFloor) ~= "number" or clearedFloor < 1 then
        return
    end
    local floorVal = ensureTowerStat(player)
    local nextFloor = math.min(MAX_FLOORS, math.max(floorVal.Value, math.floor(clearedFloor) + 1))
    floorVal.Value = nextFloor
    player:SetAttribute("TowerFloor", nextFloor)
    local milestone = (math.floor(clearedFloor) % 10 == 0)
    local bonus = if milestone then BASE_REWARD * 5 else BASE_REWARD
    local stats = player:FindFirstChild("leaderstats")
    local coins = stats and stats:FindFirstChild("Coins")
    if coins and coins:IsA("IntValue") then
        coins.Value = coins.Value + bonus
    end
    towerEvent:FireClient(player, "floor_cleared", {
        cleared = math.floor(clearedFloor),
        next_floor = nextFloor,
        max_floors = MAX_FLOORS,
        milestone_boss = milestone,
        bonus = bonus,
    })
end)

towerEvent.OnServerEvent:Connect(function(player, action, worldIdx)
    local now = os.clock()
    if lastRequest[player] and (now - lastRequest[player]) < 0.35 then
        return
    end
    lastRequest[player] = now
    if typeof(action) ~= "string" then
        return
    end
    local floorVal = ensureTowerStat(player)
    if action == "leaderboard" then
        towerEvent:FireClient(player, "leaderboard", fetchTopLeaderboard())
    elseif action == "warp_world" then
        if typeof(worldIdx) ~= "number" or worldIdx ~= worldIdx then
            return
        end
        local idx = math.clamp(math.floor(worldIdx), 1, WORLD_COUNT)
        local world = WORLDS[((idx - 1) % #WORLDS) + 1]
        if floorVal.Value < world.minFloor then
            towerEvent:FireClient(player, "locked", { required_floor = world.minFloor, world = world.name })
            return
        end
        local pad = worldsFolder:FindFirstChild("WorldPortal" .. idx)
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if pad and root then
            root.CFrame = pad.CFrame + Vector3.new(0, 4, 0)
        end
        towerEvent:FireClient(player, "warped", { world_index = idx, world_name = world.name })
    elseif action == "status" then
        towerEvent:FireClient(player, "status", {
            current_floor = floorVal.Value,
            max_floors = MAX_FLOORS,
            worlds = WORLD_COUNT,
        })
    end
end)

Players.PlayerAdded:Connect(function(player)
    local floorVal = ensureTowerStat(player)
    player:SetAttribute("TowerFloor", floorVal.Value)
end)

Players.PlayerRemoving:Connect(function(player)
    saveFloor(player)
    lastRequest[player] = nil
end)

game:BindToClose(function()
    for _, player in ipairs(Players:GetPlayers()) do
        saveFloor(player)
    end
end)
]]></ProtectedString>
      </Properties>
    </Item>
