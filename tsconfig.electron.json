{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "outDir": "dist-electron",
    "rootDir": "electron",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "sourceMap": true,
    "moduleResolution": "node16"
  },
  "include": [
    "electron/**/*.ts"
  ]
}
